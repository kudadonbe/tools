# =============================================================================
#  sysinfo.ps1  -  PC health & inventory snapshot
# =============================================================================
#
#  AUTHOR
#  ------
#  KD  -  Computer Consultancy
#  kudadonbe@outlook.com
#
#  WHAT IT DOES
#  ------------
#  Collects a one-page report on the PC it runs on:
#    - System ID  (make, model, serial, OS, uptime)
#    - CPU        (cores, speed)
#    - Memory     (total/used/free + per-DIMM details)
#    - Storage    (physical disks + volumes with free space %)
#    - GPU        (display adapter + driver version)
#    - Network    (adapters, IPv4/gateway/DNS, public IP)
#    - Devices    (USB peripherals, monitors via EDID, printers)
#    - Drivers    (problem devices + 10 newest installed drivers)
#    - Software   (last 15 installed apps)
#    - Battery    (laptops only)
#    - Processes  (top 10 by memory usage)
#
#  HOW TO RUN
#  ----------
#  From any PC, open PowerShell and paste either:
#
#     irm <host>/sysinfo | iex
#
#  or if the one-liner above fails on older systems:
#
#     iex (gc <host>/sysinfo -Raw)
#
#  WHAT IT SAVES
#  -------------
#  The report is written to up to THREE places:
#    1. Local PC:   Documents\Reports\sysinfo\<user>_<PCNAME>_<ip>.txt  (always)
#    2. Server:     <share>\reports\sysinfo\                        (on a managed LAN)
#    3. Setup pen:  <pen>\<marker>\reports\sysinfo\                 (if plugged in)
#
#  ...for an OFFICE PC. The first question asked is office or personal (the
#  default is guessed from the domain and subnet); a PERSONAL device's report
#  stays on that PC and, at most, in the pen's reports\personal\ folder -
#  never the share, never the fleet.
#
#  Beside the .txt, in each place, goes <user>_<PCNAME>_<ip>.json - the
#  inventory facts (identity, serial, CPU, memory, disks, volumes, adapters,
#  IPs, monitors, asset numbers) as DATA, for the 'fleet' tool and the IT
#  portal. The .txt is the full readable transcript; the .json is what a
#  program reads, so nothing ever has to parse the transcript again.
#
#  The pen copy is the one that saves you on a NEW PC: until the network is
#  configured the server copy cannot work, and without the pen the only record
#  is a file on a machine you are about to walk away from.
#
#  The pen's drive letter is found automatically (it differs on every PC) by
#  looking for the pen-marker folder on it - see Get-KdPenFolder below.
#
#  SAFETY
#  ------
#  Read-only. The script only QUERIES the system - it doesn't change anything.
# =============================================================================


# ---------------------------------------------------------------------------
#  GLOBAL ERROR BEHAVIOR
# ---------------------------------------------------------------------------
#  Some queries (e.g. WMI calls on locked-down PCs) may throw errors.
#  'SilentlyContinue' tells PowerShell: skip the failing command, keep going.
#  That way one missing piece doesn't abort the whole scan.
$ErrorActionPreference = 'SilentlyContinue'


# ---------------------------------------------------------------------------
#  OUTPUT FILE SETUP
# ---------------------------------------------------------------------------
#  Filename pattern:  <user>_<COMPUTERNAME>_<ip>.txt
#                     (user + ip lowercase, PC name uppercase)
#  Example:           jdoe_OFFICE-PC-12_10.0.0.42.txt
#
#  Why this order: sorting the folder groups files by USER, so you can see
#  at a glance which PCs each person uses. The full read is natural English:
#  "jdoe's OFFICE-PC-12 at 10.0.0.42".
#
#  Same PC will overwrite its own report on re-run (latest snapshot wins).
#  Different PCs cannot collide because each one has a unique IP/name combo.

# <#SITE#>  generated from config/site.psd1 by distribute.ps1 -Sync - do not edit by hand
$Site = @{
    Site      = ''
    ShareRoot = ''
    ShareBase = ''
    Subnet    = ''
    Domain    = ''
    AdminHint = ''
    PenMarker = 'network-tools'
    ItUsers   = @()
}
# <#/SITE#>

# --- Primary user --------------------------------------------------------
# Goal: find the REAL OWNER of this PC, not whoever happens to be running
# the script. Two problem cases to solve:
#   a) Script runs as SYSTEM (Action1 / scheduled task) - $env:USERNAME is
#      'SYSTEM' which tells us nothing.
#   b) An IT person logs in to run the script interactively - $env:USERNAME
#      is the IT person, not the PC's actual owner.
#
# Strategy:
#   1. If $env:USERNAME is a real user AND not in the IT list -> use it.
#   2. Else scan C:\Users, skip built-ins and IT users, pick the most
#      active profile based on Documents/Desktop/Downloads activity.
#
# To exclude additional IT staff later, add their account name to ItUsers in
# config/site.psd1 and run distribute.ps1 -Sync.
#
# Get-PrimaryUser is SHARED: printer (share names) uses the same injected
# function, so reports and printer shares always agree on who owns a desk.
# <#FUNCTIONS#>  generated from config/functions.ps1 by distribute.ps1 -Sync - do not edit by hand
function Get-OrgRegKey {
    # The registry home for ORG metadata stored on a PC (asset number, and
    # whatever comes later). Named after the org, not the toolmaker:
    # HKLM:\SOFTWARE\FC on site, HKLM:\SOFTWARE\Org in the generic build.
    $org = if ($Site -and $Site.Site) { $Site.Site } else { 'Org' }
    return "HKLM:\SOFTWARE\$org"
}

function Test-AssetNo([string]$no) {
    # Maldives MoF fixed-asset register number, as procurement issues them:
    #   {office}-{year}-{catNo}-{typeNo}-{serial}
    # Office code: 2-4 alphanumeric, assigned per office by the MoF register -
    # this site's is $Site.AssetOffice. Year YYYY; category 1-9 or 290 (IT
    # hardware is cat 4 here); type and serial are plain numbers, and the
    # serial may carry ONE trailing letter - registers use it when a set
    # shares a serial and the letter marks the item within it (369A the PC,
    # 369B the monitor, ...). Fields are validated AS ISSUED - this org's
    # register does NOT zero-pad (real: 146-2025-4-1-369A), so widths are
    # maxima not fixed: cat is 1-2 digits, type up to 3, serial up to 4.
    # Same rule as the kd-server asset module (docs/ASSET_MANAGEMENT_SPEC.md,
    # built on the MoF Asset Master Data Form / fixed-asset policy, IPSAS 17).
    return $no -match '^[A-Z0-9]{2,4}-\d{4}-(0?[1-9]|290)-\d{1,3}-\d{1,4}[A-Z]?$'
}

function Test-KdSerial([string]$serial) {
    # Is this a REAL BIOS serial, or the placeholder a board vendor ships when
    # nobody programmed one ("To be filled by O.E.M.", "System Serial Number",
    # "Default string", all zeros, blank)? Custom builds and some clones carry
    # the placeholder, and a placeholder must never be used as a device key -
    # every such PC would collapse into one. The ONE definition, shared by the
    # asset backup (which files by serial) and sysinfo (which reports it).
    if (-not $serial) { return $false }
    return -not ($serial -match '^(To be filled|Default|None|System Serial|0+$|\s*$)')
}

function Get-AssetBackupFile {
    # Where this PC's asset-number backup lives on the office share - keyed by
    # the BIOS SERIAL, the one identifier a format cannot erase. So the tag
    # survives a reimage: the asset tool finds the file by serial afterwards
    # and offers the numbers back. $null when off the office LAN (no
    # ShareBase) or when the firmware has no usable serial.
    if (-not ($Site -and $Site.ShareBase)) { return $null }
    $serial = (Get-CimInstance Win32_BIOS -ErrorAction SilentlyContinue).SerialNumber
    if (-not (Test-KdSerial $serial)) { return $null }
    $safe = ($serial.Trim() -replace '[^\w\.-]', '_')
    return Join-Path $Site.ShareBase ("reports\assets\{0}.txt" -f $safe)
}

function Save-AssetBackup {
    # Copy everything recorded under <org>\Assets (plus the legacy AssetNo)
    # to the share file above. Best-effort: any failure is silent - the
    # registry stays the working copy, the share copy is the format-survivor.
    $file = Get-AssetBackupFile
    if (-not $file) { return }
    $orgKey = Get-OrgRegKey
    $rec = [ordered]@{}
    $p = Get-ItemProperty (Join-Path $orgKey 'Assets') -ErrorAction SilentlyContinue
    if ($p) {
        foreach ($n in ($p.PSObject.Properties.Name | Where-Object { $_ -notmatch '^PS' } | Sort-Object)) {
            $rec[$n] = $p.$n
        }
    }
    if (-not $rec.Count) {
        $legacy = (Get-ItemProperty $orgKey -ErrorAction SilentlyContinue).AssetNo
        if ($legacy) { $rec['PC'] = $legacy }
    }
    if (-not $rec.Count) { return }
    try {
        $dir = Split-Path $file
        if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
        $lines = @("# $env:COMPUTERNAME  $(Get-Date -Format 'yyyy-MM-dd HH:mm')  asset numbers (keyed by BIOS serial)")
        foreach ($k in $rec.Keys) { $lines += "$k=$($rec[$k])" }
        Set-Content -Path $file -Value $lines -Encoding UTF8
    } catch { }
}

function ConvertTo-KdAccountName([string]$ProfileName, [string]$PcName = $env:COMPUTERNAME) {
    # A profile FOLDER is not always the account's name. When C:\Users\<name>
    # is already taken - a local account of the same name, or a profile left
    # by an earlier join - Windows makes the new one <name>.<DOMAIN>,
    # <name>.<PCNAME> or <name>.000. Matched as it stands, 'first.last.DOMAIN'
    # is on no IT list and in no directory, which is how a PC set up by IT
    # came to be filed under the technician who set it up (2026-09-21).
    # Only those three suffixes are taken off: 'first.last' must never be
    # read as 'first'.
    # They STACK: a third profile for the same account is 'name.DOMAIN.001'
    # (seen 2026-09-22), so they come off one at a time until none is left.
    if (-not $ProfileName) { return '' }
    $suffixes = @($PcName)
    if ($Site -and $Site.Domain) { $suffixes += ("$($Site.Domain)" -split '\.')[0] }
    $suffixes = @($suffixes | Where-Object { $_ })
    $name = $ProfileName
    while ($true) {
        $before = $name
        foreach ($s in $suffixes) { if ($name -match "^(.+)\.$([regex]::Escape($s))$") { $name = $Matches[1] } }
        if ($name -match '^(.+)\.\d{3}$') { $name = $Matches[1] }
        if ($name -eq $before) { return $name }
    }
}

function Test-KdItAccount([string]$Account, [string]$PcName = $env:COMPUTERNAME) {
    # Is this one of the IT / admin accounts in the site config - the people
    # who set PCs up, not the people who use them? Takes a profile folder
    # name as readily as an account: see ConvertTo-KdAccountName.
    if (-not $Account -or -not ($Site -and $Site.ItUsers)) { return $false }
    $it = @($Site.ItUsers | ForEach-Object { "$_".ToLower() })
    return (($it -contains $Account.ToLower()) -or ($it -contains (ConvertTo-KdAccountName $Account $PcName).ToLower()))
}

function Get-PrimaryUser {
    # THE RULE: the most RECENTLY ACTIVE user owns the PC.
    #
    # Not "whoever is logged in" - that hands the PC to a relief staff member
    # (or the IT person standing at the keyboard) who happened to be at the
    # desk during the scan.
    #
    # Not "whoever has the most files" either. That was the old rule, and it
    # gets a reassigned PC permanently wrong: a leaver with 3,000 stale
    # documents outranks the new owner with 40 fresh ones, forever.
    #
    # So we rank by the LAST TIME the person actually did work - the newest
    # write in their Documents / Desktop / Downloads. File count survives only
    # as a tiebreak, and to prove a profile is real rather than a single logon.
    #
    # THE TRAP: NTUSER.DAT is rewritten on every logon, so the IT person
    # running this scan ALWAYS has the freshest one. Ranking on it would hand
    # every PC in the office to whoever did the scanning. It is therefore used
    # ONLY as a fallback, never as the recency signal - see below.
    #
    # IT/admin accounts come from $Site.ItUsers (site.psd1); returns a profile
    # name like 'reemaa.abdulrahmaan', or 'unknown'.

    $itUsers = @()
    if ($Site -and $Site.ItUsers) { $itUsers = @($Site.ItUsers | ForEach-Object { $_.ToLower() }) }

    # Built-in Windows profile folders to always skip when scanning C:\Users.
    $systemProfiles = @('Default','Default User','Public','All Users','defaultuser0',
                        'WDAGUtilityAccount')

    $svc = @('SYSTEM','LOCALSYSTEM','LOCAL SERVICE','NETWORK SERVICE','DWM-1','UMFD-0','UMFD-1')
    $me  = $env:USERNAME

    $candidates = Get-ChildItem 'C:\Users' -Directory -ErrorAction SilentlyContinue |
        Where-Object {
            $name = $_.Name
            ($systemProfiles -notcontains $name) -and
            ($name -notmatch '^\.|\$$') -and
            ($svc -notcontains $name.ToUpper())
        }

    $scored = foreach ($p in $candidates) {
        $folders = @(
            (Join-Path $p.FullName 'Documents'),
            (Join-Path $p.FullName 'Desktop'),
            (Join-Path $p.FullName 'Downloads'),
            (Join-Path $p.FullName 'OneDrive\Documents'),
            (Join-Path $p.FullName 'OneDrive\Desktop')
        )

        $fileCount = 0
        $docLatest = $null      # real work: newest write in the doc folders
        foreach ($f in $folders) {
            # NTFS denies other users' Documents unless we are admin. Skip
            # quietly - that case is handled by the fallback further down.
            if (-not (Test-Path $f -ErrorAction SilentlyContinue)) { continue }
            $items = Get-ChildItem $f -File -Depth 1 -Force -ErrorAction SilentlyContinue |
                Select-Object -First 500
            $fileCount += @($items).Count
            $maxDate = ($items | Measure-Object LastWriteTime -Maximum -ErrorAction SilentlyContinue).Maximum
            if ($maxDate -and (-not $docLatest -or $maxDate -gt $docLatest)) { $docLatest = $maxDate }
        }

        # Logon time. Kept SEPARATE from $docLatest, and deliberately never
        # mixed into it - see THE TRAP above.
        $loginLatest = $null
        $ntu = Join-Path $p.FullName 'NTUSER.DAT'
        if (Test-Path $ntu -ErrorAction SilentlyContinue) {
            $loginLatest = (Get-Item $ntu -Force -ErrorAction SilentlyContinue).LastWriteTime
        }

        [pscustomobject]@{
            Name        = $p.Name
            Files       = $fileCount
            DocLatest   = $docLatest
            LoginLatest = $loginLatest
            IsIT        = (Test-KdItAccount $p.Name)
        }
    }

    # HOW the answer was reached is left in $script:KdPrimaryUserBasis, so the
    # report can say it and the fleet can show it as the reason a PC is filed
    # under a person: 'work' (newest document activity), 'it-own' (an IT
    # profile that plainly works here), 'signed-in', 'logon' (newest logon),
    # 'it-only' (nobody but IT has used the PC - a fresh setup), 'unknown'.
    $script:KdPrimaryUserBasis = 'unknown'
    if (-not $scored) { return 'unknown' }

    # --- Rank by real work: most recent document activity first -------------
    $active    = @($scored | Where-Object { $_.Files -gt 0 -and $_.DocLatest })
    $ranked    = @($active | Sort-Object DocLatest, Files -Descending)
    $bestNonIt = @($ranked | Where-Object { -not $_.IsIT }) | Select-Object -First 1
    $bestIt    = @($ranked | Where-Object { $_.IsIT })      | Select-Object -First 1

    if ($bestNonIt) {
        # An IT profile only takes the PC off a real user if it is plainly IT's
        # OWN workstation: more recent work AND at least twice the files.
        if ($bestIt -and
            $bestIt.DocLatest -gt $bestNonIt.DocLatest -and
            $bestIt.Files -ge (2 * [Math]::Max($bestNonIt.Files, 1))) {
            $script:KdPrimaryUserBasis = 'it-own'
            return $bestIt.Name
        }
        $script:KdPrimaryUserBasis = 'work'
        return $bestNonIt.Name
    }

    # --- Fallback: no staff document activity was readable ------------------
    # Either we run as a normal user and NTFS hid everyone else's Documents,
    # or the only documents on the PC are IT's - a technician signs in to
    # every new PC to check the domain join, and that must not make the PC
    # theirs. The signals left are who is logged in, and logon times; a staff
    # profile found by either one beats an IT profile found by its documents.
    if ($me -and ($itUsers -notcontains $me.ToLower()) -and ($me -notmatch '\$$')) {
        $script:KdPrimaryUserBasis = 'signed-in'
        return $me
    }

    # Logged in as IT. Fall back to the non-IT profile with the newest logon.
    # Not as good as document activity, but it beats naming the PC after IT.
    $byLogin = @($scored | Where-Object { -not $_.IsIT -and $_.LoginLatest } |
                 Sort-Object LoginLatest -Descending) | Select-Object -First 1
    if ($byLogin) { $script:KdPrimaryUserBasis = 'logon'; return $byLogin.Name }

    # Nobody but IT has ever used this PC. The name is returned because a
    # report needs one, but the basis says what it is worth: the fleet files
    # such a PC as unassigned, never under the technician.
    $script:KdPrimaryUserBasis = 'it-only'
    if ($bestIt) { return $bestIt.Name }
    if ($me) { return $me }
    $script:KdPrimaryUserBasis = 'unknown'
    return 'unknown'
}

function Get-KdAssignment {
    # WHO THIS PC WAS GIVEN TO, as a technician recorded it on the PC itself
    # (newpc asks at setup). Kept in the org's registry key beside the asset
    # number, so every later sysinfo report carries it without anyone being
    # asked again. Returns $null when nothing was recorded.
    $p = Get-ItemProperty (Join-Path (Get-OrgRegKey) 'Assignment') -ErrorAction SilentlyContinue
    if (-not $p -or -not "$($p.Person)".Trim()) { return $null }
    return [pscustomobject]@{
        Person = "$($p.Person)".Trim(); Reason = "$($p.Reason)".Trim(); Note = "$($p.Note)".Trim()
        By     = "$($p.By)".Trim();     Date   = "$($p.Date)".Trim()
    }
}

function Set-KdAssignment([string]$Person, [string]$Reason, [string]$Note = '') {
    # Record the assignment on the PC (needs elevation - HKLM). $true when it
    # was written. 'By' is read from the token: see Get-KdWhoAmI.
    try {
        $key = Join-Path (Get-OrgRegKey) 'Assignment'
        if (-not (Test-Path $key)) { New-Item -Path $key -Force -ErrorAction Stop | Out-Null }
        $vals = [ordered]@{ Person = $Person; Reason = $Reason; Note = $Note; By = ((Get-KdWhoAmI) -split '\\')[-1]; Date = (Get-Date -Format 'yyyy-MM-dd') }
        foreach ($k in $vals.Keys) { Set-ItemProperty -Path $key -Name $k -Value "$($vals[$k])" -ErrorAction Stop }
        return $true
    } catch { return $false }
}

function Write-KdToolLog([string]$Tool, [string]$Message) {
    # One line of usage telemetry per event: when, which PC, who, which tool,
    # what happened - so tool behaviour in the field can be reviewed and
    # improved (owner's request, 2026-08-20). Appends to
    # <share>\reports\tool-usage\<yyyy-MM>.log, or to the pen's
    # reports\tool-usage\ when the share is unreachable (sync-pen-reports
    # carries the pen's reports up later). Logging must NEVER break a tool:
    # every failure here is silent, and the function returns nothing.
    # WHO from the token, not the environment: a window elevated as another
    # account carries $env:USERNAME = SYSTEM, and a month of the A1 desk's
    # rows read "SYSTEM ran rename-pc" (2026-09-23). See Get-KdWhoAmI. The
    # bare account name, so the column keeps the shape worklog reads.
    $who = ((Get-KdWhoAmI) -split '\\')[-1]
    $line = "{0}`t{1}`t{2}`t{3}`t{4}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm:ss'),
        $env:COMPUTERNAME, $who, $Tool, ($Message -replace '[\r\n\t]+', ' ')
    $rel = Join-Path 'reports\tool-usage' ("{0}.log" -f (Get-Date -Format 'yyyy-MM'))
    $targets = @()
    if ($Site -and $Site.ShareBase) { $targets += Join-Path $Site.ShareBase $rel }
    if ($Site -and $Site.PenMarker) {
        foreach ($dt in 2, 3) {
            foreach ($d in Get-CimInstance Win32_LogicalDisk -Filter "DriveType=$dt" -ErrorAction SilentlyContinue) {
                $m = Join-Path "$($d.DeviceID)\" $Site.PenMarker
                if (Test-Path $m -ErrorAction SilentlyContinue) { $targets += Join-Path $m $rel }
            }
        }
    }
    foreach ($t in $targets) {
        try {
            $dir = Split-Path $t
            if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
            Add-Content -Path $t -Value $line -Encoding UTF8 -ErrorAction Stop
            return    # the first destination that takes the line is enough
        } catch { }
    }
}

function Set-KdRunFailed([string]$Why) {
    # A tool that prints its failure and RETURNS politely looks, from the
    # menu, exactly like one that succeeded: nothing was thrown, so the usage
    # log said "finished" - two domain-join runs that failed at the leave on
    # 2026-09-23 read as "finished domain-join (45s)". The tool says so here
    # instead, and the menu logs FAILED with the reason after the run.
    # GLOBAL, because the tool runs as a scriptblock inside the menu's
    # session and a script-scoped flag would not cross that boundary. The
    # menus clear it before every launch; only the first reason is kept.
    if (-not $global:KdRunFailure) { $global:KdRunFailure = $Why }
}

function Start-KdTranscript([string]$Tool) {
    # Begin a FULL console transcript of a tool run (everything the tool
    # printed - the automated version of saving the console output by hand,
    # which is how the fonts tool's field failures were debugged). Recorded
    # locally first so a mid-run share hiccup cannot break the tool;
    # Complete-KdTranscript ships it afterwards. Returns the local path, or
    # $null when the transcript could not start (never an error).
    #
    # NESTING IS THE NORMAL CASE, not an error. Every shipped tool opens one
    # of these itself - that is what gives a transcript to a tool run straight
    # from a console, with no menu above it - and the avas menu opens one too
    # when it launches a tool. Only the OUTER one records; the inner call sees
    # a transcript already running and returns $null, so Complete-KdTranscript
    # has nothing to stop and the single file stays whole. Windows PowerShell
    # throws on a second Start-Transcript, pwsh 7 quietly starts a second file
    # and ends the first - so the flag decides, not the engine.
    if ($global:KdTranscriptActive) { return $null }
    try {
        $dir = Join-Path $env:TEMP 'kd-transcripts'
        if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir | Out-Null }
        $p = Join-Path $dir ("{0}_{1}_{2}.txt" -f $Tool, $env:COMPUTERNAME, (Get-Date -Format 'yyyyMMdd-HHmmss'))
        Start-Transcript -Path $p -ErrorAction Stop | Out-Null
        $global:KdTranscriptActive = $true
        return $p
    } catch { return $null }
}

function Complete-KdTranscript([string]$Path) {
    # Stop the transcript and ship it to <share>\reports\transcripts\, or the
    # pen's reports\transcripts\ when off-LAN (sync-pen-reports carries those
    # up later). Silent on every failure.
    #
    # A TRANSCRIPT IS NEVER THROWN AWAY. When no destination will take it -
    # off the LAN with no pen in, or the share refusing this account - the
    # file STAYS in %TEMP%\kd-transcripts and the next run that can reach a
    # destination carries the whole backlog up with it. The old version
    # deleted it, which meant the runs most worth reading, the ones on a PC
    # that could not reach the share, were exactly the ones that left nothing
    # behind.
    if (-not $Path) { return }
    try { Stop-Transcript | Out-Null } catch { }
    $global:KdTranscriptActive = $false
    if (-not (Test-Path $Path)) { return }
    $dirs = Get-KdTranscriptTargets
    if ($dirs.Count -eq 0) {
        # Nowhere configured at all - the public build, on somebody's own PC.
        # Nothing of ours belongs in their %TEMP%, so the file goes. A site
        # build always has a ShareBase, so its transcripts are kept instead.
        if (-not ($Site -and ($Site.ShareBase -or $Site.PenMarker))) {
            Remove-Item $Path -Force -ErrorAction SilentlyContinue
        }
        return                            # otherwise: kept for a later run
    }
    foreach ($d in $dirs) {
        try {
            if (-not (Test-Path $d)) { New-Item -ItemType Directory -Force -Path $d | Out-Null }
            Copy-Item $Path (Join-Path $d (Split-Path $Path -Leaf)) -Force -ErrorAction Stop
            Remove-Item $Path -Force -ErrorAction SilentlyContinue
            Send-KdTranscriptBacklog $d
            return
        } catch { }
    }
}

function Get-KdTranscriptTargets {
    # Where a finished transcript may go, nearest first: the share, then any
    # pen plugged in. Both may be absent, and that is not a failure - see
    # Complete-KdTranscript.
    $dirs = @()
    if ($Site -and $Site.ShareBase) { $dirs += Join-Path $Site.ShareBase 'reports\transcripts' }
    if ($Site -and $Site.PenMarker) {
        foreach ($dt in 2, 3) {
            foreach ($d in Get-CimInstance Win32_LogicalDisk -Filter "DriveType=$dt" -ErrorAction SilentlyContinue) {
                $m = Join-Path "$($d.DeviceID)\" $Site.PenMarker
                if (Test-Path $m -ErrorAction SilentlyContinue) { $dirs += Join-Path $m 'reports\transcripts' }
            }
        }
    }
    return $dirs
}

function Send-KdTranscriptBacklog([string]$Dir) {
    # Carry up whatever earlier runs left behind in %TEMP%\kd-transcripts
    # because nothing would take them at the time. Runs after a successful
    # ship, so it only ever fires on a PC that has just proved it can reach
    # the destination. Silent, and never touches the file being written now.
    if (-not $Dir) { return }
    $local = Join-Path $env:TEMP 'kd-transcripts'
    if (-not (Test-Path $local)) { return }
    foreach ($f in @(Get-ChildItem $local -Filter '*.txt' -File -ErrorAction SilentlyContinue)) {
        try {
            Copy-Item $f.FullName (Join-Path $Dir $f.Name) -Force -ErrorAction Stop
            Remove-Item $f.FullName -Force -ErrorAction SilentlyContinue
        } catch { }
    }
}

function Get-KdPathVariants([string]$Path) {
    # A UNC path, plus the same path with the server named the OTHER way.
    # Windows keeps a stored credential per TARGET: an entry for the server's
    # NAME does nothing for its IP address. So a PC signed in with a local
    # account routinely reaches the share by name and not by IP (or the
    # reverse), and a path baked in one form simply fails on it.
    $out = @($Path)
    if ($Path -match '^\\\\([^\\]+)\\(.+)$') {
        $srv = $Matches[1]; $rest = $Matches[2]
        try {
            if ($srv -match '^\d{1,3}(\.\d{1,3}){3}$') {
                $n = ([Net.Dns]::GetHostEntry($srv)).HostName
                if ($n) { $out += "\\$(($n -split '\.')[0])\$rest" }
            } else {
                $a = ([Net.Dns]::GetHostAddresses($srv) | Where-Object { $_.AddressFamily -eq 'InterNetwork' } |
                      Select-Object -First 1).IPAddressToString
                if ($a) { $out += "\\$a\$rest" }
            }
        } catch { }
    }
    return @($out | Select-Object -Unique)
}

function Resolve-KdSharePath([string]$Path) {
    # The first form of $Path this PC can actually open, or $null.
    foreach ($p in (Get-KdPathVariants $Path)) {
        if (Test-Path $p -ErrorAction SilentlyContinue) { return $p }
    }
    return $null
}

function Invoke-KdTool([string]$Name) {
    # Fetch a sibling tool's TEXT and run it in this session - never as a
    # script file, so it works under any execution policy (the same trick the
    # launchers use). Sources, nearest first: the pen (marker folder on any
    # drive), the office share, then the public hub over https.
    $code = $null
    if ($Site -and $Site.PenMarker) {
        foreach ($dt in 2, 3) {   # 2 = removable, 3 = fixed (some USB3 sticks)
            Get-CimInstance Win32_LogicalDisk -Filter "DriveType=$dt" -ErrorAction SilentlyContinue | ForEach-Object {
                $p = Join-Path "$($_.DeviceID)\" (Join-Path $Site.PenMarker "$Name.txt")
                if (-not $code -and (Test-Path $p -ErrorAction SilentlyContinue)) {
                    try { $code = Get-Content $p -Raw -ErrorAction Stop } catch { }
                }
            }
        }
    }
    if (-not $code -and $Site -and $Site.ShareBase) {
        # By IP or by name, whichever this PC can reach - see Get-KdPathVariants.
        $p = Resolve-KdSharePath (Join-Path $Site.ShareBase "$Name.txt")
        if ($p) { try { $code = Get-Content $p -Raw -ErrorAction Stop } catch { } }
    }
    if (-not $code -and $Site -and $Site.PublicBase) {
        try { $code = Invoke-RestMethod -Uri "$($Site.PublicBase)/$Name" -ErrorAction Stop } catch { }
    }
    if ([string]::IsNullOrWhiteSpace($code)) {
        Write-Host "  Could not fetch '$Name' from the pen, the share, or the hub." -ForegroundColor Red
        return
    }
    Write-Host "  Launching $Name ..." -ForegroundColor Cyan
    Write-Host ''
    & ([scriptblock]::Create($code))
}

function Get-KdToolCommand([string]$Name) {
    # The one-line command that runs tool $Name from the nearest source - for
    # handing to ANOTHER PowerShell process. Invoke-KdTool fetches the text and
    # runs it HERE; this hands over the address instead, which is what a
    # relaunch in a different engine needs. Same order of sources, so the two
    # can never point at different copies: pen, then share, then the hub.
    if (-not $Name) { return $null }
    $pen = Get-KdPenFolder
    if ($pen) {
        $f = Join-Path $pen "$Name.txt"
        if (Test-Path $f -ErrorAction SilentlyContinue) { return "iex (Get-Content -Raw '$f')" }
    }
    if ($Site -and $Site.ShareBase) {
        $f = Resolve-KdSharePath (Join-Path $Site.ShareBase "$Name.txt")
        if ($f) { return "iex (Get-Content -Raw '$f')" }
    }
    if ($Site -and $Site.PublicBase) { return "irm $($Site.PublicBase)/$Name | iex" }
    return $null
}

function Restart-KdToolIn51 {
    # Re-open one tool in WINDOWS POWERSHELL 5.1, elevated.
    #
    # newpc and domain-join cannot run under PowerShell 7: Add-Computer was
    # never ported, so joining a domain there goes through the
    # WinPSCompatSession, and handing a PSCredential across that boundary is
    # unreliable - the address gets set and then the join fails. They used to
    # stop and tell the technician to open another window and start again,
    # which throws away the menu, the account typed for this window, and the
    # place they had got to. 5.1 is at a fixed path on every Windows 10 and 11,
    # so the tool can just move itself. rename-pc is NOT one of them -
    # Rename-Computer is native in 7 - and calls this only as its fallback
    # when a rename fails there.
    param([string]$Name)
    $cmd = Get-KdToolCommand $Name
    if (-not $cmd) {
        Write-Host "  !   Could not find $Name on the pen, the share or the hub." -ForegroundColor Yellow
        return $false
    }
    $ps51 = Join-Path $env:WINDIR 'System32\WindowsPowerShell\v1.0\powershell.exe'
    if (-not (Test-Path $ps51)) {
        Write-Host '  !   Windows PowerShell 5.1 is not at its usual path on this PC.' -ForegroundColor Yellow
        return $false
    }
    try {
        # -NoExit so the window stays open at the end for whatever it reports.
        # RunAs because all three of these tools need elevation anyway, and
        # asking once here beats failing on the first step that needs it.
        $null = Start-Process $ps51 -Verb RunAs -ArgumentList `
                    "-NoProfile -ExecutionPolicy Bypass -NoExit -Command `"$cmd`"" -ErrorAction Stop
        Write-Host "  OK  $Name is opening in Windows PowerShell 5.1 (a new window)." -ForegroundColor Green
        Write-Host '      Carry on in that window; this one can be left as it is.' -ForegroundColor DarkGray
        return $true
    } catch {
        Write-Host "  X   Could not start Windows PowerShell 5.1: $($_.Exception.Message)" -ForegroundColor Red
        return $false
    }
}

function Update-PcReport([string]$PcName) {
    # Refresh this PC's sysinfo report - the tools that CHANGE a PC (rename-pc,
    # newpc, printer, scan) chain this so the inventory is never left showing
    # the machine as it was before the visit. Sysinfo itself ships the report
    # to the server and the pen, and archives the report a previous name/IP of
    # this PC left behind.
    #
    # -PcName: a JUST-ASSIGNED name that only takes effect at the next restart.
    # Sysinfo reads it from KD_PCNAME and files the report under it, so the
    # fleet records know the PC by its new name from the moment it is renamed.
    if ($PcName) { $env:KD_PCNAME = $PcName }
    try     { Invoke-KdTool 'sysinfo' }
    finally { Remove-Item Env:\KD_PCNAME -ErrorAction SilentlyContinue }
}

function Get-KdIpBands {
    # The office address plan from $Site.IpBands ('from-to=kind=label'), as
    # objects { From; To; Kind; Label } in address order. Empty when the site
    # has no plan - then the whole subnet is one band and nothing is judged.
    $bands = @()
    if (-not ($Site -and $Site.IpBands)) { return $bands }
    foreach ($b in @($Site.IpBands)) {
        if ("$b" -match '^\s*(\d{1,3})\s*-\s*(\d{1,3})\s*=\s*([a-z]+)\s*=\s*(.*?)\s*$') {
            $bands += [pscustomobject]@{ From = [int]$Matches[1]; To = [int]$Matches[2]; Kind = $Matches[3].ToLower(); Label = $Matches[4] }
        }
    }
    return @($bands | Sort-Object From)
}

function Get-KdIpBand([int]$Octet) {
    # The band an octet falls in, or $null when the plan has no band there.
    foreach ($b in (Get-KdIpBands)) { if ($Octet -ge $b.From -and $Octet -le $b.To) { return $b } }
    return $null
}

function Show-KdIpPlan([hashtable]$FreeByBand) {
    # The address plan as a small table, shown wherever an address is asked
    # for, so the technician picks from the right range without looking it
    # up - and the BALANCE of each range: size, used, free, and the first
    # free octets. $FreeByBand: kind -> list of free octets (the caller knows
    # what is free); without it only the plan is shown.
    $bands = @(Get-KdIpBands)
    if (-not $bands) { return }
    $sub = $(if ($Site -and $Site.Subnet) { $Site.Subnet } else { 'x.x.x' })
    Write-Host "  Address plan for $sub.0/24:" -ForegroundColor White
    Write-Host ("    {0,-10} {1,-9} {2,-52}{3}" -f 'range', 'for', '', $(if ($FreeByBand) { 'size  used  free   first free' } else { '' })) -ForegroundColor DarkGray
    foreach ($b in $bands) {
        $range = ".{0}-.{1}" -f $b.From, $b.To
        $line = "    {0,-10} {1,-9} {2,-52}" -f $range, $b.Kind, $b.Label
        if ($FreeByBand -and $FreeByBand.ContainsKey($b.Kind)) {
            $size = $b.To - $b.From + 1
            $f = @($FreeByBand[$b.Kind] | Where-Object { $_ -ge $b.From -and $_ -le $b.To } | Sort-Object)
            $line += "{0,4}  {1,4}  {2,4}   {3}" -f $size, ($size - $f.Count), $f.Count, $(if ($f) { ".$(($f | Select-Object -First 5) -join ', .')$(if ($f.Count -gt 5) { ' ...' })" } else { 'FULL' })
        }
        $c = $(if ($b.Kind -in 'desktop', 'laptop') { 'Cyan' } else { 'DarkGray' })
        Write-Host $line -ForegroundColor $c
    }
}

function Test-KdPcBand([int]$Octet) {
    # Is this an address a PC may live at? True with no plan at all.
    $bands = @(Get-KdIpBands)
    if (-not $bands) { return $true }
    $b = Get-KdIpBand $Octet
    return ($b -and $b.Kind -in 'desktop', 'laptop')
}

function Test-KdPing([string]$Target) {
    # Test-Connection -Quiet is documented to return $false instead of
    # erroring, and that holds only while the failure is a TIMEOUT. When the
    # local stack cannot reach the target's network at all, WMI returns
    # "Generic failure" as an error record - and $ErrorActionPreference =
    # 'Stop', which several tools set at the top of the file so a half-applied
    # change cannot roll on, promotes it to a terminating one.
    #
    # That state is one these tools CREATE: between setting a static IP and
    # proving the gateway, a PC on the wrong wire has an address whose network
    # is not there. On the bench it died with a bare "Generic failure" AFTER
    # the address was applied - swallowing the message below the gateway check,
    # which is the one that says to look at the cable. Both guards are needed:
    # -ErrorAction beats the preference for this call, the catch covers a WMI
    # fault that throws regardless. An unreachable target is a no-answer, which
    # is what every caller means by $false.
    try { return [bool](Test-Connection -ComputerName $Target -Count 2 -Quiet -ErrorAction SilentlyContinue) }
    catch { return $false }
}

function ConvertTo-KdPrefixLength([string]$Mask) {
    # 255.255.255.0 -> 24. Only the WMI fallback below needs it: the Net*
    # cmdlets carry PrefixLength already, the old WMI class carries a mask.
    if (-not $Mask) { return 0 }
    $bits = 0
    foreach ($o in ($Mask -split '\.')) {
        $n = 0
        if ([int]::TryParse($o, [ref]$n)) {
            while ($n -gt 0) { $bits += ($n -band 1); $n = $n -shr 1 }
        }
    }
    return $bits
}

function Get-KdIpConfig {
    # Get-NetIPConfiguration without the bug that takes a whole tool run down.
    #
    # THE FIELD FAILURE (FC-A4-124, 2026-09-14): sysinfo died on
    #   Exception setting "NetProfile": "Cannot convert the "System.Object[]"
    #   value of type "System.Object[]" to type "...CimInstance"."
    # and took rename-pc and printer with it - both chain-launch sysinfo to
    # refresh the inventory after they change the PC, so the rename and the
    # printer work succeeded and the run still ended in a red error.
    #
    # WHY IT THROWS: Get-NetIPConfiguration assembles its output by assigning
    # Get-NetConnectionProfile's result into a property typed as a SINGLE
    # CimInstance. A PC holding MORE THAN ONE connection profile for one
    # interface - ordinary after a rename, a re-join, or any dock/VPN/Hyper-V
    # adapter - hands that assignment an array and it throws. The throw is
    # inside the cmdlet's own script body, which makes it TERMINATING:
    # -ErrorAction SilentlyContinue does not suppress it, and the
    # $ErrorActionPreference = 'Stop' that our tools set at the top of the
    # file then ends the run.
    #
    # So no tool calls it. This builds the same thing from the cmdlets that
    # have no such property, and returns objects carrying the property names
    # the callers already use - .InterfaceAlias, .InterfaceIndex,
    # .IPv4Address[].IPAddress / .PrefixLength, .IPv4DefaultGateway.NextHop,
    # .DNSServer[].AddressFamily / .ServerAddresses, .NetAdapter.Status /
    # .MacAddress - so a call site only swaps the verb.
    #
    # -All means what it means on the real cmdlet: every adapter, connected or
    # not. Without it, only adapters holding an IPv4 address - which is what
    # the real one returns, disconnected-with-an-APIPA-address included.
    #
    # The order is ours, and deliberate: routed adapters first, by route
    # metric. Every caller that picks one NIC does
    #   ... | Where IPv4DefaultGateway -and NetAdapter.Status -eq 'Up' |
    #   Select -First 1
    # and means "the adapter this PC actually uses". On a PC with the cable in
    # AND wifi up, Get-NetAdapter's own order could hand that the wifi; route
    # metric is how Windows itself decides, so this makes the two agree.
    param([switch]$All)

    $out      = @()
    $adapters = @(Get-NetAdapter -ErrorAction SilentlyContinue)
    if ($adapters.Count) {
        $addrs  = @(Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue)
        # A default route whose next hop is 0.0.0.0 is on-link, not a gateway.
        # Windows ranks routes by ifMetric + RouteMetric, so that is the sum
        # sorted on - RouteMetric alone is 256 on every automatic route and
        # would tie the cable with the wifi.
        $routes = @(Get-NetRoute -DestinationPrefix '0.0.0.0/0' -ErrorAction SilentlyContinue |
                    Where-Object { $_.NextHop -and $_.NextHop -ne '0.0.0.0' } |
                    Sort-Object { [int]$_.ifMetric + [int]$_.RouteMetric })
        $dns    = @(Get-DnsClientServerAddress -ErrorAction SilentlyContinue)
        foreach ($a in $adapters) {
            $ix  = $a.InterfaceIndex
            if (-not $ix) { $ix = $a.ifIndex }
            $ip4 = @($addrs  | Where-Object { $_.InterfaceIndex -eq $ix })
            if (-not $All -and -not $ip4.Count) { continue }
            $gw4 = @($routes | Where-Object { $_.InterfaceIndex -eq $ix })
            $out += [pscustomobject]@{
                InterfaceAlias     = "$($a.Name)"
                InterfaceIndex     = $ix
                IPv4Address        = $ip4
                IPv4DefaultGateway = $gw4
                DNSServer          = @($dns    | Where-Object { $_.InterfaceIndex -eq $ix })
                NetAdapter         = $a
                # Sort key only - routed-and-up first, then by how Windows
                # ranks the route. Not a Get-NetIPConfiguration property, so
                # no caller reads it.
                KdRank             = $(if ($gw4.Count -and $a.Status -eq 'Up') { [int]@($gw4)[0].ifMetric + [int]@($gw4)[0].RouteMetric } else { [int]::MaxValue })
            }
        }
        return @($out | Sort-Object KdRank, InterfaceIndex)
    }

    # No NetAdapter module (pre-2012 Windows, or a stripped image). Win32_
    # NetworkAdapterConfiguration is on every Windows there has ever been, and
    # a tool reporting "no network" because a module was missing would be the
    # same lie rule 9 is about.
    $cfgs = @(Get-CimInstance Win32_NetworkAdapterConfiguration -ErrorAction SilentlyContinue)
    if (-not $All) { $cfgs = @($cfgs | Where-Object { $_.IPEnabled }) }
    # NetConnectionID is the name the Network Connections window shows, and
    # only a REAL connection has one. Requiring it (or an address) keeps the
    # twenty-odd tunnel pseudo-adapters this class reports out of -All, so the
    # fallback lists what Get-NetAdapter would have listed.
    $nics = @(Get-CimInstance Win32_NetworkAdapter -ErrorAction SilentlyContinue |
              Where-Object { $_.NetConnectionID })
    foreach ($c in $cfgs) {
        $ips   = @(@($c.IPAddress)  | Where-Object { $_ -match '^\d{1,3}(\.\d{1,3}){3}$' })
        $masks = @(@($c.IPSubnet)   | Where-Object { $_ -match '^\d{1,3}(\.\d{1,3}){3}$' })
        $nic   = @($nics | Where-Object { $_.InterfaceIndex -eq $c.InterfaceIndex })
        if (-not $ips.Count -and -not $nic.Count) { continue }
        if (-not $All -and -not $ips.Count) { continue }
        $ip4 = @()
        for ($i = 0; $i -lt $ips.Count; $i++) {
            $ip4 += [pscustomobject]@{
                IPAddress    = "$($ips[$i])"
                PrefixLength = ConvertTo-KdPrefixLength (@($masks)[$i])
            }
        }
        $out += [pscustomobject]@{
            InterfaceAlias     = "$(if (@($nic).Count) { @($nic)[0].NetConnectionID } else { $c.Description })"
            InterfaceIndex     = $c.InterfaceIndex
            IPv4Address        = $ip4
            IPv4DefaultGateway = @(@($c.DefaultIPGateway) |
                Where-Object { $_ -match '^\d{1,3}(\.\d{1,3}){3}$' } |
                ForEach-Object { [pscustomobject]@{ NextHop = "$_" } })
            DNSServer          = @([pscustomobject]@{
                AddressFamily   = 2
                ServerAddresses = @(@($c.DNSServerSearchOrder) | Where-Object { $_ -match '^\d{1,3}(\.\d{1,3}){3}$' })
            })
            NetAdapter         = [pscustomobject]@{
                Name       = "$(if (@($nic).Count) { @($nic)[0].NetConnectionID } else { $c.Description })"
                Status     = "$(if (@($nic).Count -and @($nic)[0].NetConnectionStatus -eq 2) { 'Up' } else { 'Down' })"
                MacAddress = "$($c.MACAddress)".Replace(':', '-')
            }
            # Same contract as above: routed adapters first. This class has no
            # metric worth trusting, so it is a flag, not a ranking.
            KdRank             = $(if (@($c.DefaultIPGateway).Count) { 0 } else { [int]::MaxValue })
        }
    }
    return @($out | Sort-Object KdRank, InterfaceIndex)
}

function Write-KdOutcome {
    # WHAT THIS RUN DID - the closing summary for a tool that changes a PC in
    # several steps, so a run that stopped half way still says which half.
    # $Steps is an [ordered] hashtable of step -> state, where a value starting
    # DONE or FAILED is coloured; anything else reads as "not reached".
    #
    # newpc and domain-join each had their own copy, identical but for the
    # column width - so the same run reported through two tools lined up
    # differently for no reason anyone chose.
    param($Steps, [string]$Because, [string]$Title = 'WHAT THIS RUN DID')
    Write-Head $Title
    foreach ($k in $Steps.Keys) {
        $v = $Steps[$k]
        $c = if    ($v -like 'DONE*')   { 'Green' }
             elseif ($v -like 'FAILED*') { 'Red'   }
             else                        { 'DarkGray' }
        Write-Host ("    {0,-14}: {1}" -f $k, $v) -ForegroundColor $c
    }
    if ($Because) {
        Write-Host ''
        Write-Host "  Stopped because: $Because" -ForegroundColor Yellow
    }
    Write-Host ''
    # The summary already knows whether the run failed; tell the menu too,
    # so the usage log does not file a stopped run as finished.
    if ($Because) { Set-KdRunFailed $Because }
    else {
        foreach ($k in $Steps.Keys) { if ("$($Steps[$k])" -like 'FAILED*') { Set-KdRunFailed "$k - $($Steps[$k])"; break } }
    }
}

function Get-KdPenFolder([string]$SubFolder) {
    # The toolkit folder on the pen, wherever the pen turned up - or $null when
    # it is not plugged in, which is not an error and callers treat as "skip".
    #
    # This loop was written out by hand in nearly thirty tools. Three of them
    # had grown it into a Find-PenFolder of their own, no two quite alike, and
    # every one of them carried a comment asking the next person to keep it in
    # step with the others. It is one function now.
    #
    # DriveType 2 = removable (a USB stick), checked first. DriveType 3 = fixed,
    # checked second because some USB3 sticks and dock-mounted drives report
    # themselves that way and would otherwise never be found.
    if (-not $Site -or -not $Site.PenMarker) { return $null }
    foreach ($dt in 2, 3) {
        foreach ($d in @(Get-CimInstance Win32_LogicalDisk -Filter "DriveType=$dt" -ErrorAction SilentlyContinue)) {
            $marker = Join-Path "$($d.DeviceID)\" $Site.PenMarker
            if (Test-Path $marker -ErrorAction SilentlyContinue) {
                if ($SubFolder) { return (Join-Path $marker $SubFolder) }
                return $marker
            }
        }
    }
    return $null
}

function Get-KdSignedInDocuments {
    # The Documents folder of the person SIGNED IN at this screen - not of the
    # account this process runs as. Elevate as kd or an admin and the two
    # part: GetFolderPath answers for the elevated account, and a page saved
    # there sits in a profile the person at the desk cannot open.
    #
    # The elevated window shares its SESSION with that person's desktop, so
    # the owner of explorer.exe in this session is who they are - true at the
    # console and over Remote Desktop alike (Win32_ComputerSystem.UserName is
    # blank over RDP). Their Documents path is read from THEIR hive, so a
    # redirected or OneDrive-backed folder is honoured. Returns
    # @{ Account; Path }, or $null when this process IS that person or the
    # folder could not be worked out - the caller then uses its own.
    try {
        $session = [System.Diagnostics.Process]::GetCurrentProcess().SessionId
        $shell = @(Get-CimInstance Win32_Process -Filter "Name='explorer.exe' AND SessionId=$session" -ErrorAction Stop)[0]
        if (-not $shell) { return $null }
        $own = Invoke-CimMethod -InputObject $shell -MethodName GetOwner -ErrorAction Stop
        if (-not $own.User) { return $null }
        $account = "$($own.Domain)\$($own.User)"
        if ($account -ieq (Get-KdWhoAmI)) { return $null }
        $sid = (New-Object Security.Principal.NTAccount($own.Domain, $own.User)).Translate([Security.Principal.SecurityIdentifier]).Value
        $profileDir = (Get-ItemProperty "HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList\$sid" -ErrorAction Stop).ProfileImagePath
        if (-not $profileDir) { return $null }
        $docs = ''
        $usf = Get-Item "Registry::HKEY_USERS\$sid\Software\Microsoft\Windows\CurrentVersion\Explorer\User Shell Folders" -ErrorAction SilentlyContinue
        if ($usf) { $docs = "$($usf.GetValue('Personal', '', 'DoNotExpandEnvironmentNames'))" }
        # The value is written against THEIR environment (%USERPROFILE%), which
        # this process does not have - so it is expanded by hand.
        if ($docs) { $docs = $docs -ireplace '%USERPROFILE%', $profileDir.Replace('$', '$$') }
        if (-not $docs -or $docs -match '%') { $docs = Join-Path $profileDir 'Documents' }
        if (-not (Test-Path $docs -ErrorAction SilentlyContinue)) { return $null }
        return [pscustomobject]@{ Account = $account; Path = $docs }
    } catch { return $null }
}

function Get-KdLocalReportDir([string]$Tool, [switch]$SignedInUser) {
    # Documents\Reports\<tool> - where a tool's LOCAL copy of its output goes.
    #
    # NOT the Desktop, which is where every one of these tools used to write.
    # A single field visit leaves several files behind (one sysinfo per PC, a
    # gateway capture per incident, an AD export folder per run) and on the
    # Desktop that pile is permanent, in somebody's face, and impossible to
    # tell apart from the person's own files. Documents is where filed work
    # belongs; the per-tool subfolder keeps one tool's output from being
    # mistaken for another's.
    #
    # GetFolderPath rather than a hardcoded path, so a redirected or
    # OneDrive-backed Documents is honoured - the same rule the worklog store
    # follows. Falls back to the profile, then TEMP, so a caller always gets
    # somewhere writable back.
    #
    # -SignedInUser: for output that is SHOWN to the person at the desk (the
    # fleet page - the share copy sits where only IT can read). Their
    # Documents, not the elevated account's; falls through to the usual
    # folder when that cannot be found or written.
    if ($SignedInUser) {
        $theirs = Get-KdSignedInDocuments
        if ($theirs) {
            $dir = Join-Path $theirs.Path 'Reports'
            if ($Tool) { $dir = Join-Path $dir $Tool }
            try {
                if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir -ErrorAction Stop | Out-Null }
                return $dir
            } catch { }
        }
    }
    $docs = [Environment]::GetFolderPath('MyDocuments')
    if (-not $docs -and $env:USERPROFILE) { $docs = Join-Path $env:USERPROFILE 'Documents' }
    $dir = if ($docs) { Join-Path $docs 'Reports' } else { $env:TEMP }
    if ($Tool) { $dir = Join-Path $dir $Tool }
    try {
        if (-not (Test-Path $dir)) { New-Item -ItemType Directory -Force -Path $dir -ErrorAction Stop | Out-Null }
    } catch { $dir = $env:TEMP }
    return $dir
}

function Move-KdDesktopReports([string]$Tool, [string]$Pattern) {
    # Carry reports an older build left on the Desktop into the folder above,
    # so the change of address also cleans up after itself instead of leaving
    # the old pile for someone to sort out by hand.
    #
    # MOVE, not copy: two copies of the same report is worse than one in the
    # wrong place - you cannot tell which is current. Only names matching
    # $Pattern move, and each tool passes a pattern tight enough that a
    # person's own file cannot match it. A name that already exists in the new
    # folder is left where it is rather than overwritten. Silent on every
    # failure - tidying must never break a tool.
    $desk = [Environment]::GetFolderPath('Desktop')
    if (-not $desk -or -not (Test-Path $desk -ErrorAction SilentlyContinue)) { return }
    $old = @(Get-ChildItem $desk -Force -ErrorAction SilentlyContinue | Where-Object { $_.Name -match $Pattern })
    if (-not $old.Count) { return }
    $dir = Get-KdLocalReportDir $Tool
    # Documents was unreachable and we fell back to TEMP - leave the Desktop
    # copies alone rather than moving them somewhere Windows will clear out.
    if (-not $dir -or $dir -eq $env:TEMP) { return }
    $moved = 0
    foreach ($f in $old) {
        $dest = Join-Path $dir $f.Name
        if (Test-Path $dest) { continue }
        try { Move-Item $f.FullName $dest -ErrorAction Stop; $moved++ } catch { }
    }
    if ($moved) {
        Write-Host ("Tidied       : moved {0} report(s) off the Desktop into {1}" -f $moved, $dir) -ForegroundColor DarkGray
    }
}


# =============================================================================
#  NETWORK CREDENTIALS  -  shared by every tool that reaches another PC
# =============================================================================
#  Connecting a printer, reading a PC's shares, staging a driver, pulling an
#  inventory - all of it authenticates through Credential Manager, and all of
#  it fails the same way when an entry goes stale. So the handling lives HERE,
#  once, and every tool gets the same behaviour.
#
#  The failure worth knowing: a REFUSED query returns an EMPTY list, not an
#  error. Windows then reports that the host shares nothing, which reads like
#  a firewall or an update problem and is neither. After a domain password
#  change every stored entry goes stale at once, so shares and printers appear
#  to vanish office-wide - usually landing near a patch Tuesday and taking the
#  blame for it.
#
#  Parsing is of cmdkey's ENGLISH output. On a localised Windows the list comes
#  back empty rather than wrong, which is the safe way to fail.
# =============================================================================

function Expand-CredTargets {
    # A host has TWO credential targets - its name and its IP - and Windows
    # keeps them separate, so a credential stored against one is not found
    # when a service reaches the host by the other. Storing only half is the
    # classic "works from here but not from there". Every writer goes through
    # this, so the two can never drift apart.
    param([string]$Server)
    $targets = @($Server)
    try {
        if ($Server -match '^\d{1,3}(\.\d{1,3}){3}$') {
            $n = ([System.Net.Dns]::GetHostEntry($Server)).HostName
            if ($n) { $targets += ($n -split '\.')[0] }
        } else {
            $ip = ([System.Net.Dns]::GetHostAddresses($Server) |
                   Where-Object { $_.AddressFamily -eq 'InterNetwork' } | Select-Object -First 1).IPAddressToString
            if ($ip) { $targets += $ip }
        }
    } catch { }
    return @($targets | Select-Object -Unique)
}

function Get-StoredCredentialList {
    # Parse cmdkey /list into objects. Kind decides whether an entry is safe to
    # touch: 'host' entries are what file and print access ride on, 'rdp' is
    # Remote Desktop only, 'other' is application sign-in state.
    $raw = & cmdkey.exe /list 2>&1
    $creds = @(); $cur = $null
    foreach ($ln in $raw) {
        $s = "$ln"
        if ($s -match '^\s*Target:\s*(.+?)\s*$') {
            if ($cur) { $creds += $cur }
            $cur = [pscustomobject]@{ Target = $matches[1]; User = ''; Short = ''; Kind = '' }
        }
        elseif ($cur -and $s -match '^\s*User:\s*(.+?)\s*$') { $cur.User = $matches[1] }
    }
    if ($cur) { $creds += $cur }

    foreach ($c in $creds) {
        # 'Domain:target=SERVER01' -> 'SERVER01'; the short form is what a
        # technician recognises, and it is the fallback for /delete.
        $c.Short = if ($c.Target -match 'target=(.+)$') { $matches[1] } else { $c.Target }
        $c.Kind  = if ($c.Short -like 'TERMSRV/*')            { 'rdp'   }
                   elseif ($c.Target -like 'Domain:target=*') { 'host'  }
                   else                                       { 'other' }
    }
    # Host entries first - those are the ones that break network access.
    return @($creds | Sort-Object @{ e = { @{ host = 0; rdp = 1; other = 2 }[$_.Kind] } }, Short)
}

function Get-KdWhoAmI {
    # WHO THIS PROCESS ACTUALLY IS - from the token, not from $env:USERNAME.
    #
    # The environment block lies. Elevate a terminal as a DIFFERENT account
    # (the over-the-shoulder UAC prompt a standard user gets) and the new
    # process carries that account's TOKEN but the environment of the service
    # that created it: $env:USERNAME comes back 'SYSTEM' while the process is
    # really the account named at that prompt. A tool that trusts the environment announces the
    # wrong identity, decides it cannot see the network, and asks for a
    # credential it already has - which is how a working session gets a wrong
    # password stored on top of it. Read the token instead.
    try { return [Security.Principal.WindowsIdentity]::GetCurrent().Name } catch { return "$env:USERDOMAIN\$env:USERNAME" }
}

function Test-KdDomainIdentity {
    # $true when this process runs as a DOMAIN user - one whose own Kerberos
    # identity reaches other PCs on its own. False for SYSTEM, a service, the
    # machine account (name ends in $) and any local account, all of which
    # need an explicit credential to reach anything.
    $me = Get-KdWhoAmI
    if ($me -match '^NT AUTHORITY\\' -or $me -match '\$$') { return $false }
    $dom = ($me -split '\\')[0]
    if (-not $dom -or $dom -ieq $env:COMPUTERNAME) { return $false }
    if ($Site -and $Site.Domain) { return ($dom -ieq ($Site.Domain -split '\.')[0]) }
    return $true
}

function Show-CredentialIdentity {
    # WHOSE vault is this? cmdkey is PER-USER, and most of these tools demand
    # elevation. A technician who elevated with their own account is shown
    # THEIR credentials while diagnosing someone else's PC - and the staff
    # user's stale entry, the one actually breaking things, never appears.
    # Silence here means diagnosing the wrong profile, so say it out loud.
    $me = Get-KdWhoAmI
    Write-Host ''
    Write-Host ("  Vault of  : {0}" -f $me) -ForegroundColor White
    if ($global:KdCreds -and $global:KdCreds['last']) {
        Write-Host ("  Acting as : {0}  (held for this window)" -f $global:KdCreds['last'].UserName) -ForegroundColor White
    }
    $console = (Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue).UserName
    if ($console -and $console -ne $me) {
        Write-Host "  !   The person signed in at this PC is $console - a DIFFERENT vault." -ForegroundColor Yellow
        Write-Host '  !   Their access runs on THEIR stored credential, not the one listed here.' -ForegroundColor Yellow
        Write-Host '  !   To see theirs, run  cmdkey /list  as them, without elevation.' -ForegroundColor Yellow
    }
}

function Show-CredentialList {
    # Print the numbered table and hand the list back, so a caller can select
    # from exactly what was shown. Returns $null when there is nothing.
    $creds = @(Get-StoredCredentialList)
    if (-not $creds) {
        Write-Host '  !   No saved credentials found (or cmdkey output is not English).' -ForegroundColor Yellow
        return $null
    }
    Write-Host ''
    Write-Host ('   {0,-3} {1,-42} {2,-24} {3}' -f '#', 'Target', 'User', 'note') -ForegroundColor White
    for ($i = 0; $i -lt $creds.Count; $i++) {
        $c = $creds[$i]
        $note = switch ($c.Kind) {
            'rdp'   { 'Remote Desktop only - NOT used for file/print access' }
            'other' { 'app / sign-in - leave alone' }
            default {
                # A domain host refuses a bare username outright. Worth
                # shouting about: it looks harmless and is a certain failure.
                if ($c.User -and $c.User -notmatch '[\\@]') { '!! no domain prefix - this host WILL refuse it' } else { '' }
            }
        }
        $colour = switch ($c.Kind) { 'host' { if ($note) { 'Yellow' } else { 'Gray' } } 'rdp' { 'DarkGray' } default { 'DarkGray' } }
        Write-Host ('   {0,-3} {1,-42} {2,-24} {3}' -f "$($i + 1).", $c.Short, $c.User, $note) -ForegroundColor $colour
    }
    return $creds
}

function Set-HostCredential {
    # Store one credential against BOTH of a host's targets. Any existing
    # session to the host is dropped first so the new credential is the one
    # actually used. The entry PERSISTS deliberately: a service acting for the
    # user outside the logon session - the Print Spooler sending a job to a
    # \\host\share port, for one - reads it from here long after a tool exits.
    param([string]$Server, [System.Management.Automation.PSCredential]$Credential)
    if (-not $Credential) { return $false }
    $user = $Credential.UserName
    # NOT $pwd - that is PowerShell's automatic variable for the current path.
    $pass = $Credential.GetNetworkCredential().Password
    $ok = $false
    foreach ($t in (Expand-CredTargets -Server $Server)) {
        # 2>&1 | Out-Null (not 2>$null): PowerShell 5.1 still surfaces a native
        # command's stderr as an error record with plain 2>$null.
        & net.exe use "\\$t\IPC$" /delete /y 2>&1 | Out-Null
        & cmdkey.exe "/add:$t" "/user:$user" "/pass:$pass" 2>&1 | Out-Null
        if ($LASTEXITCODE -eq 0) { $ok = $true }
    }
    return $ok
}

function Remove-StoredCredential {
    # List, pick, confirm, delete. Deleting is how a stale entry gets fixed:
    # it forces the next connection to store a fresh one.
    $creds = Show-CredentialList
    if (-not $creds) { return }
    Write-Host ''
    Write-Host '  Delete an entry only to force it to be re-created with the current' -ForegroundColor DarkGray
    Write-Host '  password. Remove BOTH the host name AND its IP - Windows stores them' -ForegroundColor DarkGray
    Write-Host '  as separate targets, so half a fix leaves access broken one way.' -ForegroundColor DarkGray
    Write-Host ''
    $sel = Read-Host '  Delete which? (numbers, comma-separated, Enter = cancel)'
    if (-not $sel -or -not $sel.Trim()) { Write-Host '  ->  Nothing deleted.' -ForegroundColor Gray; return }

    $picked = @()
    foreach ($n in ($sel -split '[,\s]+' | Where-Object { $_ })) {
        if ($n -notmatch '^\d+$') { Write-Host "  !   not a number: '$n'" -ForegroundColor Yellow; continue }
        $i = [int]$n
        if ($i -lt 1 -or $i -gt $creds.Count) { Write-Host "  !   no entry numbered $i" -ForegroundColor Yellow; continue }
        $picked += $creds[$i - 1]
    }
    $picked = @($picked | Sort-Object Target -Unique)
    if (-not $picked) { Write-Host '  ->  Nothing deleted.' -ForegroundColor Gray; return }

    Write-Host ''
    Write-Host '  !   These will be REMOVED from Credential Manager:' -ForegroundColor Yellow
    foreach ($p in $picked) {
        Write-Host ("    {0,-42} {1}" -f $p.Short, $p.User) -ForegroundColor Yellow
        if ($p.Kind -ne 'host') { Write-Host "  !     ^ a '$($p.Kind)' entry, not a network one - are you sure?" -ForegroundColor Yellow }
    }
    if ((Read-Host '  Type YES to confirm') -ne 'YES') { Write-Host '  ->  Cancelled - nothing deleted.' -ForegroundColor Gray; return }

    $removed = @()
    foreach ($p in $picked) {
        # Try the full 'Domain:target=X' form first, then the bare short form -
        # which of the two cmdkey accepts varies with the credential type.
        $out = & cmdkey.exe "/delete:$($p.Target)" 2>&1
        if ($LASTEXITCODE -ne 0) { $out = & cmdkey.exe "/delete:$($p.Short)" 2>&1 }
        if ($LASTEXITCODE -eq 0) { Write-Host "  OK  removed  $($p.Short)" -ForegroundColor Green; $removed += $p }
        else { Write-Host "  X   could not remove $($p.Short): $(@($out)[-1])" -ForegroundColor Red }
    }
    return $removed
}

# ---------------------------------------------------------------------------
#  SESSION CREDENTIALS  -  type an account once, reuse it across tools
# ---------------------------------------------------------------------------
#  Tools launched from a menu run inside ONE PowerShell process, so an account
#  typed for sysinfo's share upload is still in memory when printer needs it.
#  $global:KdCreds holds them, keyed by purpose ('the domain', 'the file
#  server', 'the directory', 'network access') plus 'last' = whatever was
#  typed most recently. Memory only: never written anywhere, gone when the
#  window closes, and forgettable from the credential menu.
#
#  Asked ONCE PER TOOL RUN. The first time a tool needs a purpose it offers the
#  held account with a (y/n); after a yes the rest of that run reuses it
#  silently, and the next tool asks again. $script:KdCredRun is that per-run
#  memory - reset right here, at block load, which is the start of every tool.
#
#  Tools call THIS, never Get-Credential directly. A refused account is
#  dropped with Forget-KdCredential so a typo is not offered back.
$script:KdCredRun = @{}
if (-not $global:KdCreds) { $global:KdCreds = @{} }

function Get-KdCredential {
    param(
        [string]$Purpose,       # 'the domain' / 'the file server' / 'the directory' / 'network access'
        [string]$Message,       # dialog text; default "Account for <purpose>"
        [string]$Hint,          # example account, appended as (e.g. ...)
        [string[]]$Note,        # lines shown ONLY when a new account is about to be typed
        [switch]$Failed         # the held one was refused: forget it and ask afresh
    )
    if ($Failed) { Forget-KdCredential -Purpose $Purpose }
    $held = $global:KdCreds[$Purpose]
    if (-not $held) { $held = $global:KdCreds['last'] }
    if ($held) {
        if ($script:KdCredRun[$Purpose]) { return $held }
        if ((Read-Host "  Use $($held.UserName) again for ${Purpose}? (y/n)") -match '^[Yy]') {
            $global:KdCreds[$Purpose]   = $held
            $script:KdCredRun[$Purpose] = $true
            return $held
        }
    }
    foreach ($n in $Note) { Write-Host "  $n" -ForegroundColor Gray }
    $msg = if ($Message) { $Message } else { "Account for $Purpose" }
    if ($Hint) { $msg += " (e.g. $Hint)" }
    $c = Get-Credential -Message $msg
    if (-not $c) { return $null }
    $global:KdCreds[$Purpose]   = $c
    $global:KdCreds['last']     = $c
    $script:KdCredRun[$Purpose] = $true
    return $c
}

function Get-KdHeldCredential {
    # The account already typed this window, WITHOUT asking for one.
    #
    # Get-KdCredential is the way in when a tool needs a credential and may
    # prompt for it. This is for the other case: a sweep that can carry on
    # regardless, and must not stop in the middle of sixty queries to put up a
    # dialog. Returns $null when nothing is held, which callers treat as
    # "ask cold and report what comes back".
    #
    # It exists so tools stop reaching into $global:KdCreds themselves - the
    # store's shape is this file's business, and a tool that pokes at it
    # breaks silently the day the shape changes.
    param([string]$Purpose)
    if (-not $global:KdCreds) { return $null }
    if ($Purpose -and $global:KdCreds[$Purpose]) { return $global:KdCreds[$Purpose] }
    return $global:KdCreds['last']
}

function Forget-KdCredential {
    # Drop a held account - the domain refused it, or the technician asked.
    # No purpose = forget everything (menu option, launcher exit).
    param([string]$Purpose)
    if (-not $global:KdCreds) { $global:KdCreds = @{} }
    if (-not $Purpose) { $global:KdCreds = @{}; $script:KdCredRun = @{}; return }
    $gone = $global:KdCreds[$Purpose]
    $global:KdCreds.Remove($Purpose)
    if ($gone -and [object]::ReferenceEquals($global:KdCreds['last'], $gone)) { $global:KdCreds.Remove('last') }
    $script:KdCredRun.Remove($Purpose)
}

function Forget-KdCredentialIfRefused {
    # For a catch block: forget the account only when the error reads like an
    # authentication failure. A missing folder or an unreachable host is not
    # the account's fault, and retyping it would fix nothing.
    param([string]$Purpose, $Because)
    if ("$Because" -match 'denied|password|logon|credential|user ?name|unknown user|1326|0x8007052e') {
        Forget-KdCredential -Purpose $Purpose
        Write-Host '  ->  That account was refused - it will not be offered again.' -ForegroundColor DarkGray
    }
}

function Show-HostConnection {
    # What THIS PC is holding for one host - the stored credential and any
    # live session - against BOTH of the host's targets, because Windows
    # keeps the name and the IP apart and a technician looking at one will
    # not see the other. Read-only; returns $true if anything is held.
    param([string]$Server)
    if (-not $Server) { return $false }
    $targets = @(Expand-CredTargets -Server $Server)
    Write-Host ("  Held on this PC for {0}:" -f ($targets -join '  +  ')) -ForegroundColor White
    $any = $false
    foreach ($c in @(Get-StoredCredentialList)) {
        foreach ($t in $targets) {
            if ($c.Short -ieq $t) {
                Write-Host ("    credential   {0,-24} as {1}" -f $c.Short, $c.User) -ForegroundColor Gray
                $any = $true
            }
        }
    }
    foreach ($ln in @(& net.exe use 2>&1 | ForEach-Object { "$_" })) {
        $l = $ln
        if (@($targets | Where-Object { $l -like "*\\$_\*" -or $l -like "*\\$_ *" }).Count) {
            Write-Host ("    session      {0}" -f $l.Trim()) -ForegroundColor Gray
            $any = $true
        }
    }
    if (-not $any) { Write-Host '    nothing - this PC reaches it as whoever is signed in.' -ForegroundColor DarkGray }
    return $any
}

function Clear-HostConnection {
    # Drop everything this PC holds for one host: the live session first,
    # then the stored credential, for BOTH targets.
    #
    # This is the fix for the two faults that make a perfectly healthy PC
    # look as though it shares nothing:
    #   1326 - a stored entry whose password is stale. It OVERRIDES the
    #          identity the session would have used, so the better
    #          credential never gets a turn.
    #   1219 - a session already open to that host as a different account.
    #          Windows permits exactly one at a time and refuses the second
    #          however correct it is - the usual cause being a tool running
    #          elevated as the admin while the desk user is signed in.
    # Neither is a firewall, and neither is fixed by retyping the password.
    # Nothing here touches the OTHER PC, only what this one remembers.
    param([string]$Server)
    if (-not $Server) { return @() }
    $done = @()
    foreach ($t in @(Expand-CredTargets -Server $Server)) {
        & net.exe use "\\$t\IPC$" /delete /y 2>&1 | Out-Null
        & cmdkey.exe "/delete:$t" 2>&1 | Out-Null
        & cmdkey.exe "/delete:Domain:target=$t" 2>&1 | Out-Null
        $done += $t
    }
    return $done
}

function Clear-HostConnectionPrompt {
    # The menu form: ask for a host, show what is held, clear on a yes.
    param([string]$Server)
    Write-Host ''
    $target = if ($Server) { $Server } else { (Read-Host '  Host name or IP to clear (Enter = cancel)').Trim() }
    if (-not $target) { Write-Host '  ->  Cancelled.' -ForegroundColor Gray; return $false }
    $held = Show-HostConnection -Server $target
    if (-not $held) { return $false }
    Write-Host ''
    if ((Read-Host "  Drop all of that for $target? (y/n)") -notmatch '^[Yy]') {
        Write-Host '  ->  Left as it is.' -ForegroundColor Gray
        return $false
    }
    $done = @(Clear-HostConnection -Server $target)
    Write-Host ("  OK  Cleared for {0}. This PC now reaches it as whoever is signed in." -f ($done -join ' + ')) -ForegroundColor Green
    return $true
}

function Add-HostCredentialPrompt {
    # Ask for a host and an account, then store it for both of the host's
    # targets. Separate from the menu so a tool can offer "fix this host's
    # credential" straight from wherever the failure surfaced.
    param([string]$Server)
    Write-Host ''
    $target = if ($Server) { $Server } else { (Read-Host '  Host name or IP to store a credential for (Enter = cancel)').Trim() }
    if (-not $target) { Write-Host '  ->  Cancelled.' -ForegroundColor Gray; return $false }
    Write-Host ("  ->  Will store against: {0}" -f ((Expand-CredTargets -Server $target) -join '  +  ')) -ForegroundColor Gray
    $cred = Get-KdCredential -Purpose 'network access' -Message "Account to store for \\$target"
    if (-not $cred) { Write-Host '  ->  Cancelled.' -ForegroundColor Gray; return $false }
    if (Set-HostCredential -Server $target -Credential $cred) {
        Write-Host "  OK  Stored for \\$target ($($cred.UserName))." -ForegroundColor Green
        return $true
    }
    Write-Host "  X   Could not store a credential for \\$target." -ForegroundColor Red
    return $false
}

function Invoke-CredentialMenu {
    # The one credential screen, shared by every tool. A tool that carries a
    # SESSION identity of its own (printer does) passes -SignIn, so signing in
    # here updates that tool's state too rather than only the stored entry;
    # a tool without one simply does not show the option. -Status lets a tool
    # print its own header line above the list (printer shows "Acting as").
    param(
        [scriptblock]$SignIn,
        [string]$SignInLabel = 'Sign in  (set the account this session uses everywhere)',
        [scriptblock]$Status
    )
    while ($true) {
        if ($Status) { & $Status }
        Show-CredentialIdentity
        Write-Host ''
        Write-Host '  Network credentials' -ForegroundColor White
        Write-Host '   1.  List saved credentials'
        Write-Host '   2.  Add / update a credential for a host'
        if ($SignIn) { Write-Host "   3.  $SignInLabel" }
        Write-Host '   4.  Delete saved credentials'
        Write-Host '   5.  Forget the accounts held for this window'
        Write-Host '   6.  Clear ONE host  (drop its session + stored credential)'
        Write-Host '   0.  back'
        $c = Read-Host '  Choose'
        switch ($c) {
            '1' { $null = Show-CredentialList }
            '2' { $null = Add-HostCredentialPrompt }
            '3' { if ($SignIn) { & $SignIn } else { Write-Host "  !   Invalid choice: '$c'" -ForegroundColor Yellow } }
            '4' { $null = Remove-StoredCredential }
            '5' { Forget-KdCredential; Write-Host '  ->  Forgotten. The next tool asks for an account again.' -ForegroundColor Gray }
            '6' { $null = Clear-HostConnectionPrompt }
            '0' { return }
            ''  { return }
            default { Write-Host "  !   Invalid choice: '$c'" -ForegroundColor Yellow }
        }
    }
}


# =============================================================================
#  ASKING ANOTHER PC WHAT IT SHARES  -  the primitives, in one place
# =============================================================================
#  printer (connect + the office sweep), fleet (the shared-printer page) and
#  printer-info all ask the same question of another PC, and each grew its own
#  answer. They drifted, and the drift was not cosmetic: three faults fixed in
#  one tool went on biting in the others, each one turning a printer that
#  exists into a printer nobody can find.
#
#    - a REFUSED question was reported as "shares nothing" (see below),
#    - the question was asked with no identity the office accepts, so every
#      domain PC refused a workgroup PC while that same PC could still connect
#      to a printer perfectly well,
#    - reachability was decided by PING, which policy blocks on plenty of
#      desks that have file sharing wide open.
#
#  So they live here now, once. A tool keeps its own orchestration - which PCs
#  to ask, and what to do with the answer - and shares the asking.
# =============================================================================

function Connect-KdQuerySession {
    # A TRANSIENT session to one host, for a read-only question.
    #
    # Deliberately NOT Set-HostCredential: that writes the account into
    # Credential Manager and leaves it there, which is right for a printer this
    # PC will keep printing to (the spooler reads it long after the tool exits)
    # and wrong for a sweep - it would deposit an admin credential for every PC
    # in the office on whichever desk the sweep was run from.
    param([string]$Target, [System.Management.Automation.PSCredential]$Credential)
    if (-not $Credential -or -not $Target) { return $false }
    $user = $Credential.UserName
    $pass = $Credential.GetNetworkCredential().Password
    # 2>&1 | Out-Null, not 2>$null: 5.1 surfaces a native command's stderr as an
    # error record with the latter.
    $out = & net.exe use "\\$Target\IPC$" $pass "/user:$user" 2>&1 | ForEach-Object { "$_" }
    if ($LASTEXITCODE -eq 0) { return $true }
    # 1219 - this PC already holds a session to that host as a DIFFERENT
    # account, and Windows permits exactly one. The existing one is not working
    # (we are only here because the question was refused), so it is dropped and
    # ours takes its place. Nothing is touched on a host that answered.
    if (($out -join ' ') -match '1219') {
        & net.exe use "\\$Target\IPC$" /delete /y 2>&1 | Out-Null
        & net.exe use "\\$Target\IPC$" $pass "/user:$user" 2>&1 | Out-Null
        return ($LASTEXITCODE -eq 0)
    }
    return $false
}

function Disconnect-KdQuerySession([string]$Target) {
    if ($Target) { & net.exe use "\\$Target\IPC$" /delete /y 2>&1 | Out-Null }
}

function Test-KdHostsReachable {
    # Which of these PCs can be ASKED, decided on port 445 rather than a ping.
    #
    # 445 is the port the question itself travels over, so it is the honest
    # test; ICMP is blocked by policy on plenty of desks whose file sharing is
    # wide open, and a PC skipped for not answering a ping is a printer missing
    # from a list for no reason. The ping still goes out alongside, only to
    # tell "off" apart from "on, but not sharing".
    #
    # Takes objects carrying PC and IP; returns a hashtable keyed by PC name:
    #   smb   - reachable, ask it
    #   nosmb - answers a ping, file sharing shut
    #   off   - nothing at all
    param($Targets, [int]$TimeoutMs = 1500)
    $out = @{}
    $t = @($Targets | Where-Object { $_.PC -and $_.IP })
    if (-not $t.Count) { return $out }
    $pings = @{}; $ports = @{}
    foreach ($x in $t) {
        $ping = New-Object System.Net.NetworkInformation.Ping
        $pings[$x.PC] = $ping.SendPingAsync($x.IP, $TimeoutMs)
        $client = New-Object System.Net.Sockets.TcpClient
        $ports[$x.PC] = [pscustomobject]@{ Client = $client; Task = $client.ConnectAsync($x.IP, 445) }
    }
    # WaitAll THROWS when any task faults, and a refused TCP connect faults - so
    # the wait is only a wait, and each task is judged on its own below.
    try { [System.Threading.Tasks.Task]::WaitAll(@($pings.Values), ($TimeoutMs * 3)) | Out-Null } catch { }
    try { [System.Threading.Tasks.Task]::WaitAll(@($ports.Values | ForEach-Object { $_.Task }), ($TimeoutMs * 3)) | Out-Null } catch { }
    foreach ($x in $t) {
        $pg = $pings[$x.PC]
        $pingOk = [bool]($pg -and $pg.Status -eq 'RanToCompletion' -and $pg.Result.Status -eq 'Success')
        $smbOk  = [bool]($ports[$x.PC].Task.Status -eq 'RanToCompletion')
        $out[$x.PC] = if ($smbOk)      { [pscustomobject]@{ State = 'smb';   Why = '' } }
                      elseif ($pingOk) { [pscustomobject]@{ State = 'nosmb'; Why = 'it answers a ping but not file sharing (port 445 shut)' } }
                      else             { [pscustomobject]@{ State = 'off';   Why = 'no answer at all - the PC is off or unreachable' } }
    }
    foreach ($x in $ports.Values) { try { $x.Client.Close() } catch { } }
    return $out
}

function Get-KdHostPrinters {
    # What one PC shares, and - when it will not say - WHY, in
    # $script:KdShareError for the caller to report honestly. "The PC shares
    # nothing" and "the PC would not tell me" are both zero rows from here, and
    # saying the first when it is the second sends the technician to the wrong
    # PC entirely.
    #
    # Pass -Credential to have a refusal retried once over a transient session:
    # asking a PC what it shares is an ADMINISTRATIVE question, and a session
    # with no identity those PCs accept is refused by every one of them.
    param([string]$Target, [System.Management.Automation.PSCredential]$Credential)
    $script:KdShareError = ''
    $found = @()
    if (-not $Target) { return $found }

    $ask = {
        param([string]$t)
        $rows = @()
        # Best: ask the remote print spooler directly - it gives the share name
        # AND the driver. Needs rights on the far PC, so it is the first choice
        # and not the only one.
        try {
            foreach ($p in @(Get-Printer -ComputerName $t -ErrorAction Stop | Where-Object { $_.Shared -and $_.ShareName })) {
                $rows += [pscustomobject]@{ Share = "$($p.ShareName)"; Name = "$($p.Name)"; Driver = "$($p.DriverName)" }
            }
            if ($rows.Count) { return $rows }
        } catch {
            $script:KdShareError = "the remote spooler refused the query ($($_.Exception.Message.Trim()))"
        }

        # Fallback: enumerate the PC's shares over SMB and keep the Print ones.
        # Needs only share-list access, so it works far more widely - and on
        # most desks this, not the spooler, is the path that answers.
        $lines = & net.exe view "\\$t" /all 2>&1
        $text  = ($lines | ForEach-Object { "$_" }) -join "`n"
        if ($text -match 'System error (\d+)') {
            # net view names the fault in a way Get-Printer does not, and none
            # of these is a firewall.
            $script:KdShareError = switch ($Matches[1]) {
                '5'    { 'it refused the share list (access denied).' }
                '53'   { 'it was not found on the network.' }
                '67'   { 'the network name could not be found.' }
                '1219' { 'this PC already has a session to it as a DIFFERENT account - Windows allows only one at a time.' }
                '1326' { 'it rejected the sign-in - WRONG USERNAME OR PASSWORD.' }
                default { "the share list failed with system error $($Matches[1])." }
            }
        }
        elseif ($text -match 'There are no entries in the list' -or
                $text -match 'Share name' -or
                $text -match 'command completed successfully') {
            # THE LISTING WORKED. Clear the spooler's complaint from above, or
            # the PC is reported as having REFUSED when it actually answered -
            # and answered "I share no printer", which is a different fact
            # needing a different action. Getting this backwards sends the
            # technician to clear credentials that were never the problem, on a
            # PC that was never the problem.
            $script:KdShareError = ''
        }
        foreach ($ln in $lines) {
            # Columns are:  Share name | Type | Used as | Comment
            #
            # For a shared printer Windows puts the printer's MODEL in the
            # comment, and that model is exactly the driver name needed to
            # build a local queue. Without it the connect can only attempt
            # Point-and-Print, which a patched Windows refuses over an
            # IP-based UNC - the share name cannot supply it either, because
            # Windows strips '/' when it generates a share name from a model.
            #
            # It is only a HINT: a comment is free text and anyone can retype
            # it. The caller confirms the driver is installed or can be staged.
            if ($ln -match '^(?<share>.+?)\s{2,}Print\s{2,}(?<comment>.*)$') {
                $s = $Matches.share.Trim()
                $rows += [pscustomobject]@{ Share = $s; Name = $s; Driver = $Matches.comment.Trim() }
            }
        }
        return $rows
    }

    $found = @(& $ask $Target)
    if ($found.Count -or -not $script:KdShareError -or -not $Credential) { return $found }

    # Refused, and we hold an account it may accept: sign in to this one host,
    # ask once more, and drop the session again.
    if (Connect-KdQuerySession -Target $Target -Credential $Credential) {
        $found = @(& $ask $Target)
        Disconnect-KdQuerySession -Target $Target
    }
    return $found
}


# =============================================================================
#  DHIVEHI KEYBOARD  -  English (US) + Divehi Phonetic, the pair every desk needs
# =============================================================================
#  Windows keeps input methods PER USER, not per PC. That is the whole trap
#  here: a tool run elevated as an admin sets the keyboard for THAT account and
#  the person at the desk sees no change at all, then reports that the tool did
#  nothing. So this reports WHO it actually reached, and can reach three
#  different sets of people - which answer three different questions:
#
#    this user      Set-WinUserLanguageList, the supported call. Takes effect
#                   without signing out.
#    new users      the Default profile hive, which Windows copies for every
#                   account created on this PC afterwards.
#    other users    each existing profile's own hive - the accounts already on
#                   the PC, who are not the one running the tool.
#
#  The keyboard needs no language pack and no download: Divehi Phonetic ships
#  with Windows as KLID 00000465, so this works on a PC with no internet.
# =============================================================================

$script:KdKbdEnUs = '00000409'   # US
$script:KdKbdDv   = '00000465'   # Divehi Phonetic (00010465 is Divehi Typewriter)

function Set-KdPreloadKeyboards {
    # Write the Preload list into ONE hive: the legacy key, which is what
    # Windows reads when it builds a profile and the only handle we have on a
    # user who is not signed in. Existing layouts are kept and the two we want
    # are ensured, then the whole list is renumbered 1..n - Windows treats a
    # gap in that numbering as the end of the list and silently drops the rest.
    param([string]$HiveRoot)
    $key = Join-Path $HiveRoot 'Keyboard Layout\Preload'
    try {
        if (-not (Test-Path $key)) { New-Item -Path $key -Force -ErrorAction Stop | Out-Null }
        $cur  = Get-ItemProperty -Path $key -ErrorAction SilentlyContinue
        $vals = @()
        if ($cur) {
            foreach ($n in 1..20) {
                $v = "$($cur.$n)"
                if ($v) { $vals += $v }
            }
        }
        if ($vals -notcontains $script:KdKbdEnUs) { $vals = @($script:KdKbdEnUs) + $vals }
        if ($vals -notcontains $script:KdKbdDv)   { $vals += $script:KdKbdDv }
        $vals = @($vals | Select-Object -Unique)
        # Clear first: a shorter new list would otherwise leave the old tail
        # behind, and that tail is a layout nobody asked for.
        foreach ($n in 1..20) { Remove-ItemProperty -Path $key -Name "$n" -ErrorAction SilentlyContinue }
        for ($i = 0; $i -lt $vals.Count; $i++) {
            New-ItemProperty -Path $key -Name "$($i + 1)" -Value $vals[$i] -PropertyType String -Force -ErrorAction Stop | Out-Null
        }
        return $true
    } catch { return $false }
}

function Add-KdDhivehiKeyboard {
    # Returns what actually happened, per audience, so a caller can report it
    # honestly rather than saying "done" for a PC where one account got it.
    param([switch]$NewUsers, [switch]$ExistingUsers)
    $result = [pscustomobject]@{
        Me = $false; MeName = (Get-KdWhoAmI); NewUsers = $false
        Others = @(); Failed = @(); AlreadyHad = $false
    }

    # --- the account running this ------------------------------------------
    try {
        $list = Get-WinUserLanguageList -ErrorAction Stop
        # MATCH ON THE PREFIX. Windows stores Dhivehi as the tag 'dv', not
        # 'dv-MV' - it normalises a neutral language to its short form the
        # moment the list is saved. Matching 'dv-MV' exactly therefore never
        # finds the entry that IS already there, so the tool reports adding a
        # keyboard the PC has had for a year, and only Windows folding the two
        # onto the same entry stops it appearing twice. Same for English: a PC
        # can carry 'en-GB' or a bare 'en'.
        $dv  = @($list | Where-Object { "$($_.LanguageTag)" -like 'dv*' })[0]
        $had = [bool]($dv -and $dv.InputMethodTips -contains "0465:$($script:KdKbdDv)")
        if (-not @($list | Where-Object { "$($_.LanguageTag)" -like 'en*' }).Count) { $list.Add('en-US') }
        if (-not $dv) {
            $list.Add('dv-MV')
            $dv = @($list | Where-Object { "$($_.LanguageTag)" -like 'dv*' })[0]
        }
        if ($dv -and $dv.InputMethodTips -notcontains "0465:$($script:KdKbdDv)") {
            # Phonetic, not Typewriter: it is what this office types on, and a
            # list carrying both makes the user pick one every time they switch.
            $dv.InputMethodTips.Clear()
            $dv.InputMethodTips.Add("0465:$($script:KdKbdDv)")
        }
        Set-WinUserLanguageList $list -Force -ErrorAction Stop
        $result.Me = $true
        $result.AlreadyHad = $had
    } catch {
        $result.Failed += "this account ($($result.MeName)): $($_.Exception.Message)"
    }

    # --- everyone created from now on --------------------------------------
    if ($NewUsers) {
        $hive = Join-Path $env:SystemDrive 'Users\Default\NTUSER.DAT'
        if (Test-Path $hive) {
            $mount = 'KD_DEFAULT'
            & reg.exe load "HKU\$mount" $hive 2>&1 | Out-Null
            if ($LASTEXITCODE -eq 0) {
                $result.NewUsers = Set-KdPreloadKeyboards "Registry::HKEY_USERS\$mount"
                # The hive will not unload while anything still holds a handle,
                # and PowerShell holds one until the objects behind those reads
                # are collected. Without this the unload fails and the Default
                # profile is left mounted for the rest of the session.
                [GC]::Collect(); [GC]::WaitForPendingFinalizers()
                & reg.exe unload "HKU\$mount" 2>&1 | Out-Null
            } else {
                $result.Failed += 'the Default profile hive would not load (run as Administrator)'
            }
        } else {
            $result.Failed += "no Default profile at $hive"
        }
    }

    # --- the other accounts already on this PC ------------------------------
    if ($ExistingUsers) {
        $mySid = try { ([Security.Principal.WindowsIdentity]::GetCurrent()).User.Value } catch { '' }
        foreach ($k in @(Get-ChildItem 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\ProfileList' -ErrorAction SilentlyContinue)) {
            $sid = $k.PSChildName
            if ($sid -notmatch '^S-1-5-21-.+-\d+$') { continue }   # skip SYSTEM and the service accounts
            if ($sid -eq $mySid) { continue }                      # done above, through the proper API
            $path = (Get-ItemProperty $k.PSPath -ErrorAction SilentlyContinue).ProfileImagePath
            $name = if ($path) { Split-Path $path -Leaf } else { $sid }
            $loaded = Test-Path "Registry::HKEY_USERS\$sid"
            $mount  = if ($loaded) { $sid } else { "KD_$($sid.Split('-')[-1])" }
            $ok = $false
            if ($loaded) {
                # Signed in right now - write straight into the live hive.
                $ok = Set-KdPreloadKeyboards "Registry::HKEY_USERS\$sid"
            }
            elseif ($path -and (Test-Path (Join-Path $path 'NTUSER.DAT'))) {
                & reg.exe load "HKU\$mount" (Join-Path $path 'NTUSER.DAT') 2>&1 | Out-Null
                if ($LASTEXITCODE -eq 0) {
                    $ok = Set-KdPreloadKeyboards "Registry::HKEY_USERS\$mount"
                    [GC]::Collect(); [GC]::WaitForPendingFinalizers()
                    & reg.exe unload "HKU\$mount" 2>&1 | Out-Null
                }
            }
            if ($ok) { $result.Others += $name } else { $result.Failed += "profile $name" }
        }
    }
    return $result
}

function Show-KdDhivehiKeyboardResult {
    # One report for both callers, so the setup flow and the standalone option
    # can never describe the same work differently.
    param($Result, $DeskUser)
    if ($Result.Me) {
        if ($Result.AlreadyHad) { Write-Host "  OK  $($Result.MeName) already had Dhivehi (phonetic) - list confirmed." -ForegroundColor Green }
        else                    { Write-Host "  OK  Dhivehi (phonetic) added for $($Result.MeName), alongside English (US)." -ForegroundColor Green }
    }
    if ($Result.NewUsers) { Write-Host '  OK  Every account created on this PC from now on gets both.' -ForegroundColor Green }
    if ($Result.Others.Count) {
        Write-Host ("  OK  Also applied to {0} other profile(s): {1}" -f $Result.Others.Count, ($Result.Others -join ', ')) -ForegroundColor Green
        Write-Host '      They get it at their next sign-in.' -ForegroundColor DarkGray
    }
    # The trap named out loud: the tool ran as one account, the desk belongs to
    # another, and a keyboard set for the first is invisible to the second.
    if ($DeskUser -and $Result.MeName -and (($Result.MeName -split '\\')[-1] -notlike $DeskUser)) {
        if ($Result.Others -notcontains $DeskUser) {
            Write-Host "  !   This ran as $($Result.MeName), but this desk is $DeskUser's." -ForegroundColor Yellow
            Write-Host "      A keyboard is per USER, so $DeskUser does not have it yet." -ForegroundColor Yellow
        }
    }
    foreach ($f in $Result.Failed) { Write-Host "  X   Could not apply to $f" -ForegroundColor Red }
    if ($Result.Me) {
        Write-Host '      Switch keyboards with the Windows key + Space.' -ForegroundColor DarkGray
    }
}

function Find-KdComputerObject {
    # DOES THE DOMAIN STILL HAVE AN ACCOUNT FOR THIS PC? Asked of the
    # directory itself over LDAP, from any PC, with no RSAT - the same plain
    # ADSI the server tools are built on.
    #
    # The PC's own opinion is worth nothing here: a PC whose computer object
    # was deleted in AD still says it is a member of the domain, still shows the
    # domain at the sign-in screen, and fails every domain operation with a
    # different message - rename says "the specified computer account could
    # not be found", the trust check says "broken", a leave with a domain
    # credential says "no mapping between account names and security IDs".
    # One fact, three wordings, and a technician trying "a domain
    # administrator" as the last of them suggests (FC-A1 desk, 2026-09-23).
    #
    # Returns @{ State; Dn; Why }: State is 'found', 'missing' or 'refused'.
    # REFUSED IS NOT MISSING (rule 9): a query that could not be made - no
    # directory configured, the DC unreachable, this account not accepted -
    # says so in Why, and the caller decides what to do about not knowing.
    # $Credential binds explicitly (the technician-on-a-local-account case);
    # without it the process's own identity is used, which on a broken-trust
    # PC is fine when that identity is a domain user signed in from cache.
    param([string]$Name, [System.Management.Automation.PSCredential]$Credential, [string]$Server)
    $out = @{ State = 'refused'; Dn = ''; Why = '' }
    if (-not $Name) { $out.Why = 'no PC name given'; return $out }
    $Name = ($Name -split '\.')[0]
    $dc = $Server
    if (-not $dc -and $Site -and $Site.DcHost) { $dc = $Site.DcHost }
    if (-not $dc -and $Site -and $Site.Domain) { $dc = $Site.Domain }
    if (-not $dc) { $out.Why = 'no directory configured (a generic build)'; return $out }
    $path = "LDAP://$dc"
    if ($Site -and $Site.DomainDn) { $path += "/$($Site.DomainDn)" }
    # LDAP filter escaping for the few characters a name could carry.
    $safe = $Name -replace '\\', '\5c' -replace '\*', '\2a' -replace '\(', '\28' -replace '\)', '\29'
    try {
        $root = if ($Credential) {
            New-Object System.DirectoryServices.DirectoryEntry($path, $Credential.UserName, $Credential.GetNetworkCredential().Password)
        } else { New-Object System.DirectoryServices.DirectoryEntry($path) }
        $s = New-Object System.DirectoryServices.DirectorySearcher($root, "(&(objectCategory=computer)(|(sAMAccountName=$safe`$)(name=$safe)))")
        $null = $s.PropertiesToLoad.Add('distinguishedName')
        $r = $s.FindOne()
        if ($r) {
            $p = $r.Properties['distinguishedname']
            $out.State = 'found'
            $out.Dn = if ($p -and $p.Count) { "$($p[0])" } else { '' }
        } else {
            $out.State = 'missing'
        }
    } catch {
        $out.Why = $_.Exception.Message -replace '[\r\n]+', ' '
    }
    return $out
}
# <#/FUNCTIONS#>
# --- Primary IPv4 --------------------------------------------------------
# Pick the adapter that has a default gateway (i.e. the route the PC actually
# uses to reach the network).
#
# An adapter can hold SEVERAL IPv4 addresses, and taking the first one is not
# safe: a multi-homed PC can answer on several subnets at once, and Windows
# does not list them in any useful order.
# Filing the report under the wrong one puts the PC in the wrong place in the
# inventory - or drops it out entirely, and frees an address that is in use.
#
# So: of the addresses on that adapter, prefer the one on the OFFICE subnet.
# Fall back to the first address only if the PC genuinely has none.

# Empty subnet (public build / unmanaged LAN) matches everything, so the PC's
# gateway adapter address is just taken as-is.
$officePrefix = if ($Site.Subnet) { $Site.Subnet + '.' } else { '' }

$addresses = @(Get-KdIpConfig |
    Where-Object { $_.IPv4DefaultGateway -and $_.NetAdapter.Status -eq 'Up' } |
    Select-Object -First 1 |
    ForEach-Object { $_.IPv4Address.IPAddress })

$primaryIp = @($addresses | Where-Object { $_ -like "$officePrefix*" })[0]
if (-not $primaryIp) { $primaryIp = @($addresses)[0] }
if (-not $primaryIp) { $primaryIp = 'no-ip' }

$primaryUser = Get-PrimaryUser
$assignment  = Get-KdAssignment      # who a technician gave this PC to, if recorded on it

# --- PC name -------------------------------------------------------------
# Normally this PC's own name. But a tool that JUST renamed the PC (rename-pc,
# newpc) chains sysinfo before the restart makes the new name official - it
# passes the new name via KD_PCNAME so the report is filed under the name the
# fleet will know this PC by, not under a name that is already dead.
$pcName = if ($env:KD_PCNAME) { $env:KD_PCNAME.Trim().ToUpper() } else { $env:COMPUTERNAME.ToUpper() }

# User and IP lowercase; PC name uppercase (matches Windows convention,
# gives the filename a visual hierarchy: who_WHAT_where).
$reportStem = "{0}_{1}_{2}" -f $primaryUser.ToLower(), $pcName, $primaryIp.ToLower()
$reportName = "$reportStem.txt"
# The JSON sidecar: the same facts as DATA, same stem, beside the .txt in
# every place the .txt goes. The .txt is for a person; the .json is for
# the fleet tool and the portal, which should never have to parse a
# transcript. The two are always filed and retired together.
$jsonName   = "$reportStem.json"

# Documents\Reports\sysinfo - filed where a person keeps work, not dumped on
# the Desktop, which is where this used to land and where a week of visits
# turns into a screen full of <user>_<PC>_<ip>.txt. Reports left on the
# Desktop by older builds are swept into the new folder on the way past.
$localDir  = Get-KdLocalReportDir 'sysinfo'
Move-KdDesktopReports 'sysinfo' '^[^_]+_[^_]+_((\d{1,3}\.){3}\d{1,3}|no-ip)\.txt$'
$localFile = Join-Path $localDir $reportName
$localJson = Join-Path $localDir $jsonName

# Where on the share we drop copies. Each tool has its own subfolder under
# reports/ so PC inventory snapshots don't get mixed in with other tools'
# output. The script auto-creates this folder if it doesn't exist.
$shareDir  = if ($Site.ShareBase) { Join-Path $Site.ShareBase 'reports\sysinfo' } else { '' }

# The server itself. Needed separately: if we have to authenticate with a
# domain account (see below), the session is opened against the SERVER, not
# against one folder deep inside it.
$shareRoot = $Site.ShareRoot


# ---------------------------------------------------------------------------
#  FIND THE SETUP PEN  (third copy of the report)
# ---------------------------------------------------------------------------
#  On a PC that is not on the network yet, the share copy fails and the only
#  record is a file in that PC's Documents - which you then have to go back for.
#  So we also drop a copy on the pen, and you carry the reports home with you.
#
#  The pen's DRIVE LETTER IS DIFFERENT ON EVERY PC, so it is never hard-coded.
#  We look for the marker folder we put on it - \network-tools\ - which means
#  detection also survives the pen being re-imaged or relabelled.
# ---------------------------------------------------------------------------

$penTools = Get-KdPenFolder
$penDir   = if ($penTools) { Join-Path $penTools 'reports\sysinfo' } else { $null }

# ---------------------------------------------------------------------------
#  IS THIS THE COURT'S PC?
# ---------------------------------------------------------------------------
#  A personal laptop that happens to run this - the technician's own, a
#  visitor's, one plugged into the pen at home - must not file a report into
#  the fleet: its report would carry that person's name into the share and
#  ride the pen from then on. So the FIRST question is office or personal.
#  The default is guessed - on the office domain or subnet means office -
#  so at a desk it is one Enter. A personal report stays on this PC and, if
#  the pen is in, goes to the pen's reports\personal\ folder, which neither
#  the pen sync nor the fleet tool ever reads. A tool that chained sysinfo
#  after renaming a PC (KD_PCNAME) is at an office desk: no question.
#  The public build has no domain or subnet, so it asks with no default.
$isCourtPc = $true
if (-not $env:KD_PCNAME) {
    $pcDomain = (Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue).Domain
    $onDomain = $Site.Domain -and ("$pcDomain" -eq $Site.Domain)
    $onSubnet = $Site.Subnet -and ($primaryIp -like "$($Site.Subnet).*")
    $default  = if ($onDomain -or $onSubnet) { 'o' } elseif ($Site.Domain -or $Site.Subnet) { 'p' } else { '' }
    Write-Host ''
    if ($default -eq 'o')     { Write-Host "This PC is on the office network ($(if ($onDomain) { $Site.Domain } else { "$($Site.Subnet).x" }))." -ForegroundColor DarkGray }
    elseif ($default -eq 'p') { Write-Host "This PC is NOT on the $($Site.Domain) domain and has no $($Site.Subnet).x address." -ForegroundColor Yellow }
    Write-Host '  o = office   (the report goes to the fleet)' -ForegroundColor Gray
    Write-Host '  p = personal (it stays with you)' -ForegroundColor Gray
    $prompt = "  Office PC or personal? (o/p" + $(if ($default) { ", Enter = $default" } else { '' }) + ")"
    do {
        $a = (Read-Host $prompt).Trim().ToLower()
        if (-not $a) { $a = $default }
    } while ($a -notin 'o', 'p')
    if ($a -eq 'p') {
        $isCourtPc = $false
        $shareDir  = ''
        $penDir    = if ($penTools) { Join-Path $penTools 'reports\personal\sysinfo' } else { $null }
        Write-Host "  Personal - the report stays in Documents on this PC$(if ($penDir) { ' and in reports\personal on the pen' }); it never reaches the share or the fleet." -ForegroundColor Cyan
    }
}

# Start-Transcript captures EVERYTHING shown in the console (including
# Write-Host text) and writes it to a file in real time. The screen still
# shows colored output - the file just gets a plain-text mirror.
Start-Transcript -Path $localFile -Force | Out-Null


# ---------------------------------------------------------------------------
#  PRETTY-PRINT HELPERS
# ---------------------------------------------------------------------------
#  Two small functions so each section starts with a clear banner.
#  Using Write-Host (vs Write-Output) because we want colors and we don't
#  want this decorative text polluting the pipeline.

function Write-Section($title) {
    Write-Host ""
    Write-Host ("=" * 70) -ForegroundColor Cyan           # 70-char line of '='
    Write-Host "  $title" -ForegroundColor Cyan
    Write-Host ("=" * 70) -ForegroundColor Cyan
}

# <#VOICE#>  generated from config/voice.ps1 by distribute.ps1 -Sync - do not edit by hand
function Write-Head($text) {
    # The banner that opens a tool or a stage. 62 wide: the plurality of the
    # tools already used it, it clears the longest heading in the toolkit, and
    # it fits an 80-column console with room to spare.
    Write-Host ''
    Write-Host ('=' * 62) -ForegroundColor Cyan
    Write-Host "  $text" -ForegroundColor Cyan
    Write-Host ('=' * 62) -ForegroundColor Cyan
}

function Write-Sub($text)  { Write-Host ''; Write-Host "-- $text --" -ForegroundColor White }
function Write-Step($text) { Write-Host "  ->  $text" -ForegroundColor Gray }
function Write-Ok($text)   { Write-Host "  OK  $text" -ForegroundColor Green }
function Write-Warn($text) { Write-Host "  !   $text" -ForegroundColor Yellow }
function Write-Bad($text)  { Write-Host "  X   $text" -ForegroundColor Red }
function Write-Dim($text)  { Write-Host "      $text" -ForegroundColor DarkGray }

# --- asking, which is as much the house voice as printing ------------------
#  Rule 5 in CLAUDE.md: every prompt in the toolkit reads the same way. These
#  two were written out in eight tools between them - identical but for the
#  parameter name - which is a rule kept by hand, and a rule kept by hand is
#  one that drifts the first time somebody is in a hurry.

function Confirm-Action($prompt) {
    # A plain yes/no. Anything not starting with y is no, so Enter is no.
    return ((Read-Host "  $prompt (y/n)") -match '^[Yy]')
}

function Confirm-Default($prompt, $default) {
    # The same, but Enter takes the default and the prompt SAYS which - never
    # "[default]" or a bare "(y/n)" that hides it.
    $hint = if ($default) { 'y/n, Enter = y' } else { 'y/n, Enter = n' }
    $a = (Read-Host "  $prompt ($hint)").Trim()
    if (-not $a) { return $default }
    return ($a -match '^[Yy]')
}
# <#/VOICE#>
# ---------------------------------------------------------------------------
#  HEADER  -  basic identity of the machine
# ---------------------------------------------------------------------------
#  Get-CimInstance is the modern way to query WMI (the Windows Management
#  Instrumentation database). It returns rich objects you can pipe further.
#  We pull three classes here and reuse them later to avoid duplicate queries:
#    - Win32_ComputerSystem  : name, manufacturer, model, total RAM
#    - Win32_OperatingSystem : OS version, last boot, free RAM
#    - Win32_BIOS            : serial number, BIOS version
$cs   = Get-CimInstance Win32_ComputerSystem
$os   = Get-CimInstance Win32_OperatingSystem
$bios = Get-CimInstance Win32_BIOS

Write-Section "SYSTEM SNAPSHOT  -  $($cs.Name)  -  $(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"

# Asset register number: set by rename-pc into the org's registry key
# (Get-OrgRegKey), BIOS asset tag as fallback when the vendor filled it.
$assetNo = (Get-ItemProperty (Get-OrgRegKey) -ErrorAction SilentlyContinue).AssetNo
if (-not $assetNo) {
    $t = (Get-CimInstance Win32_SystemEnclosure -ErrorAction SilentlyContinue).SMBIOSAssetTag
    if ($t -and $t -notmatch '^(No Asset|None|Default|To be filled|\s*$)') { $assetNo = $t }
}

# The serial is the fleet's DEVICE KEY (asset backups, the inventory, the
# portal all file by it), so it is checked here, once, against the vendor
# placeholders - the JSON says plainly whether it can be trusted. The
# printed line still shows whatever the firmware said, so a placeholder is
# visible to the technician too.
$serialValid = Test-KdSerial $bios.SerialNumber

# The rest of the header is collected into an object FIRST, then printed -
# the same values feed the JSON sidecar written at the end (see WHAT IT
# SAVES). Piping the object to Format-List prints one "Key : Value" per line.
$head = [pscustomobject]@{
    # When a rename is pending (KD_PCNAME - see above), show the NEW name and
    # say so: Windows itself still answers with the old one until the restart.
    ComputerName = $(if ($pcName -ne $cs.Name.ToUpper()) { "$pcName  (rename pending restart - Windows still says '$($cs.Name)')" } else { $cs.Name })
    User         = "$($cs.UserName)"                                   # currently logged-in user
    MainUser     = $primaryUser                                        # the PC's real owner (Get-PrimaryUser)
    MainUserBy   = "$script:KdPrimaryUserBasis"                        # how that was reached
    AssignedTo   = $(if ($assignment) { "$($assignment.Person)  ($($assignment.Reason), by $($assignment.By) on $($assignment.Date))" } else { '-' })
    AssetNo      = $(if ($assetNo) { $assetNo } else { '-' })
    Domain       = $cs.Domain
    Manufacturer = $cs.Manufacturer
    Model        = $cs.Model
    Serial       = $bios.SerialNumber
    BIOSVersion  = $bios.SMBIOSBIOSVersion
    # The firmware's release date is the nearest thing to the PC's own
    # manufacture date - it is how the fleet tool ages a machine. Written
    # as yyyy-MM-dd on purpose, so a reader never has to guess the culture.
    BIOSDate     = $(if ($bios.ReleaseDate -is [datetime]) { $bios.ReleaseDate.ToString('yyyy-MM-dd') } else { '-' })
    OS           = "$($os.Caption) ($($os.Version)) $($os.OSArchitecture)"
    InstallDate  = $os.InstallDate
    LastBoot     = $os.LastBootUpTime
    # New-TimeSpan = (LastBoot - Now). ToString('d\.hh\:mm') = "days.hh:mm"
    Uptime       = (New-TimeSpan -Start $os.LastBootUpTime -End (Get-Date)).ToString('d\.hh\:mm')
}
$head | Format-List

# The rest of the desk's register numbers (monitor, keyboard, printer...),
# as recorded by the 'asset' tool under <org>\Assets - one line per item.
$assetRows = @()
$assetProps = Get-ItemProperty (Join-Path (Get-OrgRegKey) 'Assets') -ErrorAction SilentlyContinue
if ($assetProps) {
    $assetRows = @($assetProps.PSObject.Properties | Where-Object { $_.Name -notmatch '^PS' } | Sort-Object Name |
        ForEach-Object { [pscustomobject]@{ Item = $_.Name; AssetNo = $_.Value } })
    if ($assetRows) {
        Write-Sub "Registered assets"
        $assetRows | Format-Table -AutoSize
    }
}


# ---------------------------------------------------------------------------
#  CPU
# ---------------------------------------------------------------------------
#  Win32_Processor returns one object per CPU socket.
#  The funny @{n='...';e={...}} syntax is a "calculated property" - it lets
#  us add or rename columns. Here we convert MHz to GHz on the fly.
Write-Section "CPU"
$cpus = @(Get-CimInstance Win32_Processor | Select-Object Name, NumberOfCores, NumberOfLogicalProcessors,
    @{n='MaxClockGHz';e={[math]::Round($_.MaxClockSpeed/1000,2)}},
    SocketDesignation, Manufacturer)
$cpus | Format-List


# ---------------------------------------------------------------------------
#  MEMORY
# ---------------------------------------------------------------------------
#  Two layers:
#    1. Overall total/used/free (a quick summary line).
#    2. Per-DIMM breakdown (slot, speed, capacity) - useful when planning
#       upgrades or diagnosing single-channel vs dual-channel issues.
#
#  Note: TotalPhysicalMemory is in BYTES, FreePhysicalMemory is in KILOBYTES.
#  PowerShell's '1GB' and '1MB' are real constants (1073741824 and 1048576).
Write-Section "MEMORY"
$totalGB = [math]::Round($cs.TotalPhysicalMemory/1GB,2)
$freeGB  = [math]::Round($os.FreePhysicalMemory/1MB,2)             # KB / 1MB = GB? No: KB*1024/1MB = MB; here OS gives KB and /1MB gives GB
$usedGB  = [math]::Round($totalGB - $freeGB,2)
$pct     = [math]::Round(($usedGB / $totalGB) * 100,1)
Write-Host "Total : $totalGB GB"
Write-Host "Used  : $usedGB GB  ($pct%)"
Write-Host "Free  : $freeGB GB"

Write-Sub "DIMMs installed"
# Win32_PhysicalMemory = one row per physical RAM stick.
$dimms = @(Get-CimInstance Win32_PhysicalMemory | Select-Object @{n='Slot';e={$_.DeviceLocator}},
    Manufacturer, PartNumber,
    @{n='SizeGB';e={[math]::Round($_.Capacity/1GB,2)}},
    @{n='SpeedMHz';e={$_.ConfiguredClockSpeed}})
$dimms | Format-Table -AutoSize


# ---------------------------------------------------------------------------
#  STORAGE
# ---------------------------------------------------------------------------
#  Two views again:
#    1. Get-PhysicalDisk - the actual hardware (SSD vs HDD, bus type, health).
#    2. Get-Volume       - the partitions/drive letters and their free space.
Write-Section "STORAGE"

Write-Sub "Physical disks"
$pdisks = @(Get-PhysicalDisk | Select-Object DeviceId, FriendlyName, MediaType, BusType,
    @{n='SizeGB';e={[math]::Round($_.Size/1GB,1)}},
    HealthStatus, OperationalStatus)
$pdisks | Format-Table -AutoSize

Write-Sub "Volumes"
# Where-Object DriveLetter   -> filter out volumes without a letter (recovery partitions, system reserved)
# Sort-Object  DriveLetter   -> show C: D: E: in order
$vols = @(Get-Volume | Where-Object DriveLetter | Sort-Object DriveLetter |
    Select-Object DriveLetter, FileSystemLabel, FileSystem, DriveType,
        @{n='SizeGB';e={[math]::Round($_.Size/1GB,1)}},
        @{n='FreeGB';e={[math]::Round($_.SizeRemaining/1GB,1)}},
        # Free% guard: avoid divide-by-zero on empty/unmounted volumes
        @{n='Free%';e={if($_.Size){[math]::Round(($_.SizeRemaining/$_.Size)*100,1)}}},
        HealthStatus)
$vols | Format-Table -AutoSize


# ---------------------------------------------------------------------------
#  GPU / DISPLAY
# ---------------------------------------------------------------------------
#  Win32_VideoController returns one row per display adapter.
#  Laptops with hybrid graphics (Intel + NVIDIA) will show two entries.
Write-Section "GPU / DISPLAY"
Get-CimInstance Win32_VideoController | Select-Object Name, DriverVersion,
    @{n='VRAM_GB';e={[math]::Round($_.AdapterRAM/1GB,2)}},
    VideoModeDescription | Format-List


# ---------------------------------------------------------------------------
#  NETWORK
# ---------------------------------------------------------------------------
#  Three sub-sections:
#    1. Active adapters - MAC, link speed (handy to confirm it's gig vs 100M).
#    2. IP configuration - IPv4, gateway, DNS per active interface.
#    3. Public IP - what the internet sees this PC as (requires outbound HTTPS).
Write-Section "NETWORK"

Write-Sub "Active adapters"
# One query, two views: the JSON gets every adapter with its status, so a
# consumer can tell an idle VPN adapter from a dead NIC without a second read.
$adapters = @(Get-NetAdapter | Sort-Object Status |
    Select-Object Name, InterfaceDescription, Status, MacAddress, LinkSpeed)
# 'Status -eq Up' filters out disconnected/disabled adapters.
$adapters | Where-Object Status -eq 'Up' |
    Select-Object Name, InterfaceDescription, MacAddress, LinkSpeed | Format-Table -AutoSize

Write-Sub "All adapters"
# No status filter this time: a VPN adapter (TAP, WireGuard, Tailscale...) is
# usually DOWN when idle, so the 'Up' view above never shows it. The
# InterfaceDescription is what gives the VPN software away.
$adapters | Format-Table -AutoSize

Write-Sub "IP configuration"
# -All = every interface, not just connected ones. The CIDR line carries the
# prefix length (10.0.0.42/24) so the fleet portal can reconcile which
# subnet RANGES are in use, not just which addresses.
# Kept as OBJECTS (lists stay lists) for the JSON; the printed view joins
# them with commas the way it always has.
$ipcfg = @(Get-KdIpConfig -All | ForEach-Object {
    [pscustomobject]@{
        InterfaceAlias = $_.InterfaceAlias
        Mac            = "$($_.NetAdapter.MacAddress)"
        IPv4           = @($_.IPv4Address | ForEach-Object { "$($_.IPAddress)" })
        CIDR           = @($_.IPv4Address | ForEach-Object { "$($_.IPAddress)/$($_.PrefixLength)" })
        Gateway        = "$($_.IPv4DefaultGateway.NextHop)"
        # AddressFamily 2 = IPv4 (vs 23 = IPv6). We only want IPv4 DNS here.
        DNS            = @(($_.DNSServer | Where-Object AddressFamily -eq 2).ServerAddresses | ForEach-Object { "$_" })
    }
})
$ipcfg | Select-Object InterfaceAlias,
        @{n='IPv4';e={$_.IPv4 -join ', '}},
        @{n='CIDR';e={$_.CIDR -join ', '}},
        Gateway,
        @{n='DNS';e={$_.DNS -join ', '}} |
    Format-List

# The MAC behind the primary IP - the device key when the serial is a
# placeholder (see $serialValid). Falls back to the first adapter that is up.
$macPrimary = ($ipcfg | Where-Object { $_.IPv4 -contains $primaryIp } | Select-Object -First 1).Mac
if (-not $macPrimary) { $macPrimary = ($adapters | Where-Object Status -eq 'Up' | Select-Object -First 1).MacAddress }

Write-Sub "VPN profiles"
# Windows-native VPN connections configured on this PC (rasphone book).
# Third-party clients (OpenVPN GUI, WireGuard app) don't appear here - but
# their adapters do, in "All adapters" above.
try {
    $vpn = @(Get-VpnConnection -ErrorAction Stop)
    if ($vpn) { $vpn | Select-Object Name, ServerAddress, TunnelType, ConnectionStatus | Format-Table -AutoSize }
    else      { Write-Host "(none)" }
} catch { Write-Host "(none)" }

Write-Sub "Public IP"
# ipify.org is a free no-auth service that returns just your public IPv4.
# TimeoutSec 5 = don't hang the whole script if the internet is down.
try {
    $pub = (Invoke-RestMethod -Uri 'https://api.ipify.org' -TimeoutSec 5)
    Write-Host $pub
} catch { Write-Host "(unavailable)" }


# ---------------------------------------------------------------------------
#  CONNECTED DEVICES  -  USB peripherals, monitors, printers
# ---------------------------------------------------------------------------
Write-Section "CONNECTED DEVICES"

Write-Sub "USB devices"
# Get-PnpDevice = all Plug-and-Play devices known to Windows.
#   -PresentOnly       : only currently connected (skip "ghost" past devices)
#   InstanceId -like 'USB*' : only devices on the USB bus
Get-PnpDevice -PresentOnly | Where-Object { $_.InstanceId -like 'USB*' -and $_.Class -ne $null } |
    Sort-Object Class, FriendlyName |
    Select-Object Class, FriendlyName, Status | Format-Table -AutoSize

Write-Sub "Monitors"
# Monitors report their identity via EDID (a small block embedded in the
# cable signal). Windows exposes it through WmiMonitorID in root/wmi.
# The fields come as arrays of bytes (each byte = one ASCII character code),
# with trailing zeros for padding. We:
#   1. Drop the zero bytes (Where-Object {$_ -ne 0})
#   2. Convert each remaining byte to a character ([char]$_)
#   3. Join them into a string (-join ...)
$monitors = @(Get-CimInstance -Namespace root/wmi -ClassName WmiMonitorID -ErrorAction SilentlyContinue | ForEach-Object {
    [pscustomobject]@{
        Manufacturer = -join ($_.ManufacturerName | Where-Object { $_ -ne 0 } | ForEach-Object { [char]$_ })
        Model        = -join ($_.UserFriendlyName | Where-Object { $_ -ne 0 } | ForEach-Object { [char]$_ })
        Serial       = -join ($_.SerialNumberID   | Where-Object { $_ -ne 0 } | ForEach-Object { [char]$_ })
        Year         = $_.YearOfManufacture
    }
})
$monitors | Format-Table -AutoSize

Write-Sub "Scanners / imaging"
# Class 'Image' = scanners + the scan side of the office copiers (their
# "ScanGear" driver registers here); 'Camera' = webcams. The USB listing above
# misses both whenever the device hangs off the network instead of a USB port.
$img = @(Get-PnpDevice -PresentOnly -ErrorAction SilentlyContinue |
    Where-Object { $_.Class -in 'Image','Camera' })
if ($img) { $img | Sort-Object Class, FriendlyName | Select-Object Class, FriendlyName, Status | Format-Table -AutoSize }
else      { Write-Host "(none)" }

Write-Sub "Printers"
Get-Printer | Select-Object Name, ShareName, DriverName, PortName, Shared, Default | Format-Table -AutoSize


# ---------------------------------------------------------------------------
#  DRIVERS
# ---------------------------------------------------------------------------
#  Two angles:
#    1. Any device whose status is NOT 'OK' - likely missing/broken drivers.
#    2. The 10 most recently installed drivers - useful when a recent update
#       broke something (correlate the failure with the install date).
Write-Section "DRIVERS"

$problem = Get-PnpDevice -PresentOnly | Where-Object { $_.Status -ne 'OK' }
if ($problem) {
    Write-Sub "Devices with issues"
    $problem | Select-Object Status, Class, FriendlyName, InstanceId | Format-Table -AutoSize
} else {
    Write-Host "All devices report OK."
}

Write-Sub "10 most recently installed drivers"
# Win32_PnPSignedDriver has DriverDate - we sort by it descending and take 10.
Get-CimInstance Win32_PnPSignedDriver |
    Where-Object DriverDate |
    Sort-Object DriverDate -Descending |
    Select-Object -First 10 DeviceName, DriverVersion,
        @{n='DriverDate';e={$_.DriverDate}} | Format-Table -AutoSize


# ---------------------------------------------------------------------------
#  PRINTERS  -  what this PC has, and what it lends to everybody else
# ---------------------------------------------------------------------------
#  A shared printer on a staff PC is invisible to every other tool here. It
#  is not on the print server, it answers no SNMP sweep, and asking each PC
#  across the network needs rights on that PC - which is why a sweep from
#  one desk comes back "access denied" for most of the office and finds
#  nothing. The PC itself has no such problem: it can always see its own
#  queues. So it reports them, and fleet assembles the picture afterwards.
#
#  That matters because a printer shared off somebody's desk is a
#  dependency nobody wrote down. When that person is away and their PC is
#  off, the people who print to it simply cannot, and the reason is on a
#  machine nobody thought to look at.
#
#  Four kinds, and only the first is a "personal printer shared out":
#    local      - plugged into this PC (USB, DOT4, LPT)
#    network    - this PC prints straight to a printer's own address
#    connection - a queue that lives on another PC or the print server
#    virtual    - PDF, XPS, OneNote and friends; noise, kept out of the JSON
$printers = @()
try {
    $printers = @(Get-Printer -ErrorAction Stop | ForEach-Object {
        $port = "$($_.PortName)"
        # The PORT is what says where a queue really points, and it must be
        # read before anything else: a queue onto another PC's share is often
        # named as if it were local ("Shimla-LBP6030") while its port is
        # \\FC-D2-173\Shimla-LBP6030. Judging by the NAME alone calls it a
        # local printer, and the PC then looks as though it owns a printer it
        # merely borrows - which is exactly backwards for finding out who
        # lends what.
        $drv  = "$($_.DriverName)"
        $kind = if ("$($_.Name)" -like '\\*' -or $port -like '\\*')   { 'connection' }
                elseif ($port -match '^(nul:|PORTPROMPT:|SHRFAX:|Microsoft|AD_Port|PDF|XPS)' -or
                        $port -match '\*\.' -or
                        $drv  -match 'PDF|XPS|OneNote|Fax|AnyDesk|Send To')      { 'virtual' }
                elseif ($port -match '^(USB|DOT4|LPT|COM)')                       { 'local' }
                elseif ($port -match '^\d{1,3}(\.\d{1,3}){3}' -or
                        $port -match '^(WSD|IP_|TCPPort|TPVM)')                   { 'network' }
                else                                                              { 'other' }
        [pscustomobject]@{
            Name = "$($_.Name)"; Kind = $kind
            Shared = [bool]$_.Shared; Share = $(if ($_.Shared) { "$($_.ShareName)" } else { '' })
            Port = $port; Driver = "$($_.DriverName)"
        }
    })
} catch { }

$realPrinters = @($printers | Where-Object { $_.Kind -ne 'virtual' })
$sharedOut    = @($printers | Where-Object { $_.Shared -and $_.Kind -in 'local', 'network' })
Write-Section "PRINTERS  ($($realPrinters.Count), of which $($sharedOut.Count) shared from this PC)"
if ($realPrinters.Count) {
    $realPrinters | Select-Object @{n='Printer';e={$_.Name}}, Kind,
        @{n='Shared as';e={ if ($_.Shared) { $_.Share } else { '' } }}, Port, Driver |
        Format-Table -AutoSize | Out-String -Width 200 | Write-Host
    if ($sharedOut.Count) {
        Write-Host "  This PC LENDS $($sharedOut.Count) printer(s) to the office - anyone printing to them" -ForegroundColor Yellow
        Write-Host '  depends on this PC being on:' -ForegroundColor Yellow
        foreach ($x in $sharedOut) { Write-Host ("    \\{0}\{1}   {2}" -f $pcName, $x.Share, $x.Driver) -ForegroundColor Yellow }
    }
} else {
    Write-Host '  No printers installed (beyond the built-in PDF/XPS ones).'
}


# ---------------------------------------------------------------------------
#  WINDOWS UPDATES  -  what this PC has taken, and the exact build it is on
# ---------------------------------------------------------------------------
#  Why an inventory tool records these: when something breaks across the
#  office, the question is always "what changed", and often enough the
#  answer is an update. One PC's KB list answers nothing on its own - it is
#  the COMPARISON that finds the culprit, and that only exists if every PC
#  reports the same thing. So the list goes in the JSON too, and fleet lines
#  the PCs up side by side: the ones that fail either share a KB the healthy
#  ones lack, or lack one they have. The print stack is the standing example
#  - KB5005565 changed how the spooler authenticates and broke every client
#  that had not caught up, which looked for weeks like a firewall fault.
#
#  The BUILD REVISION is the sharper signal. Two PCs can both say build
#  26200 and be a month of patches apart; 26200.9168 against 26200.8972 says
#  it exactly. Windows keeps that last number in the registry as UBR, and
#  nothing in Win32_OperatingSystem carries it.
#
#  Get-HotFix reads Win32_QuickFixEngineering, the same list printer-diag
#  shows, so the two tools never disagree. InstalledOn comes back empty on
#  some builds; those rows are kept and sorted last rather than dropped,
#  because a KB with no date is still a KB this PC has.
$ubr = $null
try { $ubr = (Get-ItemProperty 'HKLM:\SOFTWARE\Microsoft\Windows NT\CurrentVersion' -Name UBR -ErrorAction Stop).UBR } catch { }
$buildFull = if ($null -ne $ubr) { "$($os.BuildNumber).$ubr" } else { "$($os.BuildNumber)" }

$hotfixes = @()
try {
    $all = @(Get-HotFix -ErrorAction Stop | ForEach-Object {
        [pscustomobject]@{ KB = "$($_.HotFixID)"; Kind = "$($_.Description)"; InstalledOn = $_.InstalledOn }
    })
    # Dated newest first, undated last - never dropped.
    $hotfixes = @($all | Where-Object { $_.InstalledOn } | Sort-Object InstalledOn -Descending) +
                @($all | Where-Object { -not $_.InstalledOn })
} catch { }

# The heading counts what is actually printed. "newest 15 of 4" - the cap
# quoted as if it were the count - reads as a PC missing eleven updates, when
# it has four and all four are listed below.
$hfHead = if ($hotfixes.Count -gt 15) { "newest 15 of $($hotfixes.Count)" } else { "$($hotfixes.Count)" }
Write-Section "WINDOWS UPDATES  ($hfHead)"
Write-Host ("  Windows build : {0}   {1}" -f $buildFull, $os.Caption)
if ($hotfixes.Count) {
    $hotfixes | Select-Object -First 15 |
        Select-Object KB, Kind,
            @{n='Installed';e={ if ($_.InstalledOn) { $_.InstalledOn.ToString('yyyy-MM-dd') } else { '(no date)' } }} |
        Format-Table -AutoSize
} else {
    Write-Host "  Windows reported no update history (the update list is empty on this PC)."
}


# ---------------------------------------------------------------------------
#  INSTALLED SOFTWARE  -  last 15 installs
# ---------------------------------------------------------------------------
#  Windows tracks installed programs in two registry locations:
#    HKLM\...\Uninstall              -> 64-bit programs
#    HKLM\...\Wow6432Node\Uninstall  -> 32-bit programs (on 64-bit Windows)
#  We read both. Each subkey is one installed app.
#  Filter: skip entries with no DisplayName or no InstallDate (Windows
#  Updates and minor components often have neither).
Write-Section "RECENTLY INSTALLED SOFTWARE (last 15)"
$keys = @(
    'HKLM:\Software\Microsoft\Windows\CurrentVersion\Uninstall\*'
    'HKLM:\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'
)
Get-ItemProperty $keys |
    Where-Object { $_.DisplayName -and $_.InstallDate } |
    Sort-Object InstallDate -Descending |
    Select-Object -First 15 InstallDate, DisplayName, DisplayVersion, Publisher |
    Format-Table -AutoSize


# ---------------------------------------------------------------------------
#  BATTERY  -  only shows on laptops
# ---------------------------------------------------------------------------
#  Win32_Battery returns nothing on desktops, so we check first and only
#  print the section if a battery exists.
$batt = Get-CimInstance Win32_Battery
if ($batt) {
    Write-Section "BATTERY"
    $batt | Select-Object Name, EstimatedChargeRemaining, BatteryStatus, DesignVoltage | Format-List
}


# ---------------------------------------------------------------------------
#  TOP PROCESSES  -  who's eating RAM right now?
# ---------------------------------------------------------------------------
#  WS = Working Set, the amount of RAM the process currently has resident.
#  Sort descending, take 10, convert bytes -> MB.
Write-Section "TOP 10 PROCESSES BY MEMORY"
Get-Process | Sort-Object WS -Descending | Select-Object -First 10 `
    @{n='MemMB';e={[math]::Round($_.WS/1MB,1)}}, Id, ProcessName, CPU |
    Format-Table -AutoSize


# ---------------------------------------------------------------------------
#  FOOTER
# ---------------------------------------------------------------------------
Write-Host ""
Write-Host ("=" * 70) -ForegroundColor Green
Write-Host "  Scan complete.  $($cs.Name)  -  $(Get-Date -Format 'HH:mm:ss')" -ForegroundColor Green
Write-Host ("=" * 70) -ForegroundColor Green


# ---------------------------------------------------------------------------
#  STOP CAPTURING & SHIP THE REPORT TO THE SHARE
# ---------------------------------------------------------------------------
#  Stop-Transcript closes the local report file.
#  Then we attempt to copy it to the server. The try/catch ensures that even
#  if the share is offline or permissions are wrong, the script still ends
#  cleanly and you still have the local copy.
Stop-Transcript | Out-Null

# --- The JSON sidecar ------------------------------------------------------
# The inventory facts, as DATA, written beside the transcript. Only the
# sections a fleet record needs - identity, CPU, memory, disks, volumes,
# adapters, IP, monitors, assets. Everything else (drivers, software,
# processes, USB) stays in the .txt, for a technician to read.
#
# What a consumer can rely on: lists are lists (never comma-joined), dates
# are ISO 8601 (never the host's culture), the OS is split into its parts,
# and 'serialValid' says whether the serial may be used as a device key -
# a placeholder yields serial=null and the MAC takes over. Written AFTER the
# transcript closes, so a failure here can never touch the readable report.
function ConvertTo-KdIsoDate($d) {
    if ($d -is [datetime]) { return $d.ToString('yyyy-MM-ddTHH:mm:sszzz') }
    return $null
}
function ConvertTo-KdText($v) {
    # Trimmed string, or null - so "" and "   " never masquerade as a value.
    if ($null -eq $v) { return $null }
    $s = "$v".Trim()
    if ($s) { return $s } else { return $null }
}

$data = [ordered]@{
    schema        = 'kd-sysinfo/1'
    tool          = 'sysinfo'
    generatedAt   = (Get-Date).ToString('yyyy-MM-ddTHH:mm:sszzz')
    reportName    = $reportName
    computerName  = $pcName
    windowsName   = "$($cs.Name)".ToUpper()
    renamePending = ($pcName -ne "$($cs.Name)".ToUpper())
    user          = ConvertTo-KdText $cs.UserName
    mainUser      = $primaryUser
    # How mainUser was reached (Get-PrimaryUser) and, when a technician
    # recorded one on this PC, who it was given to - the fleet's Reason column.
    mainUserBasis = "$script:KdPrimaryUserBasis"
    assignment    = $(if ($assignment) { [ordered]@{ person = $assignment.Person; reason = $assignment.Reason; note = $assignment.Note; by = $assignment.By; date = $assignment.Date } } else { $null })
    domain        = ConvertTo-KdText $cs.Domain
    partOfDomain  = [bool]$cs.PartOfDomain
    manufacturer  = ConvertTo-KdText $cs.Manufacturer
    model         = ConvertTo-KdText $cs.Model
    serial        = $(if ($serialValid) { ConvertTo-KdText $bios.SerialNumber } else { $null })
    serialValid   = [bool]$serialValid
    serialRaw     = ConvertTo-KdText $bios.SerialNumber
    macPrimary    = ConvertTo-KdText $macPrimary
    biosVersion   = ConvertTo-KdText $bios.SMBIOSBIOSVersion
    biosDate      = ConvertTo-KdIsoDate $bios.ReleaseDate
    assetNo       = ConvertTo-KdText $assetNo
    assets        = @($assetRows | ForEach-Object { [ordered]@{ item = "$($_.Item)"; assetNo = "$($_.AssetNo)" } })
    os            = [ordered]@{
        caption      = ConvertTo-KdText $os.Caption
        version      = ConvertTo-KdText $os.Version
        build        = ConvertTo-KdText $os.BuildNumber
        ubr          = $(if ($null -ne $ubr) { [int]$ubr } else { $null })
        buildFull    = ConvertTo-KdText $buildFull
        architecture = ConvertTo-KdText $os.OSArchitecture
        installDate  = ConvertTo-KdIsoDate $os.InstallDate
        lastBoot     = ConvertTo-KdIsoDate $os.LastBootUpTime
    }
    cpu           = @($cpus | ForEach-Object { [ordered]@{
                        name = ConvertTo-KdText $_.Name; cores = [int]$_.NumberOfCores; logical = [int]$_.NumberOfLogicalProcessors
                        maxClockGHz = $_.MaxClockGHz; socket = ConvertTo-KdText $_.SocketDesignation; manufacturer = ConvertTo-KdText $_.Manufacturer } })
    memory        = [ordered]@{
        totalGB = $totalGB
        dimms   = @($dimms | ForEach-Object { [ordered]@{
                        slot = ConvertTo-KdText $_.Slot; manufacturer = ConvertTo-KdText $_.Manufacturer
                        partNumber = ConvertTo-KdText $_.PartNumber; sizeGB = $_.SizeGB; speedMHz = $_.SpeedMHz } })
    }
    disks         = @($pdisks | ForEach-Object { [ordered]@{
                        deviceId = "$($_.DeviceId)"; name = ConvertTo-KdText $_.FriendlyName; mediaType = "$($_.MediaType)"
                        busType = "$($_.BusType)"; sizeGB = $_.SizeGB; health = "$($_.HealthStatus)" } })
    volumes       = @($vols | ForEach-Object { [ordered]@{
                        letter = "$($_.DriveLetter)"; label = ConvertTo-KdText $_.FileSystemLabel; fileSystem = "$($_.FileSystem)"
                        driveType = "$($_.DriveType)"; sizeGB = $_.SizeGB; freeGB = $_.FreeGB } })
    adapters      = @($adapters | ForEach-Object { [ordered]@{
                        name = "$($_.Name)"; description = ConvertTo-KdText $_.InterfaceDescription; status = "$($_.Status)"
                        mac = ConvertTo-KdText $_.MacAddress; linkSpeed = "$($_.LinkSpeed)" } })
    ip            = [ordered]@{
        primary    = $(if ($primaryIp -ne 'no-ip') { $primaryIp } else { $null })
        interfaces = @($ipcfg | ForEach-Object { [ordered]@{
                        alias = "$($_.InterfaceAlias)"; mac = ConvertTo-KdText $_.Mac; ipv4 = @($_.IPv4); cidr = @($_.CIDR)
                        gateway = ConvertTo-KdText $_.Gateway; dns = @($_.DNS) } })
    }
    monitors      = @($monitors | ForEach-Object { [ordered]@{
                        manufacturer = ConvertTo-KdText $_.Manufacturer; model = ConvertTo-KdText $_.Model
                        serial = ConvertTo-KdText $_.Serial; year = $_.Year } })
    # The virtual ones (PDF, XPS, OneNote) are dropped: every PC has them and
    # they answer nothing. "shared" here means this PC lends it to others.
    printers      = @($realPrinters | ForEach-Object { [ordered]@{
                        name = ConvertTo-KdText $_.Name; kind = "$($_.Kind)"
                        shared = [bool]$_.Shared; share = ConvertTo-KdText $_.Share
                        port = ConvertTo-KdText $_.Port; driver = ConvertTo-KdText $_.Driver } })
    # Every KB, not just the 15 the text report prints: comparing PCs is the
    # whole point, and the KB that matters is rarely the newest one.
    updates       = @($hotfixes | ForEach-Object { [ordered]@{
                        kb = "$($_.KB)"; kind = ConvertTo-KdText $_.Kind
                        installedOn = $(if ($_.InstalledOn) { $_.InstalledOn.ToString('yyyy-MM-dd') } else { $null }) } })
    updateLatest  = $(if ($hotfixes.Count -and $hotfixes[0].InstalledOn) { $hotfixes[0].InstalledOn.ToString('yyyy-MM-dd') } else { $null })
}
try {
    # WriteAllText = UTF-8 without a BOM, which every JSON reader accepts.
    [System.IO.File]::WriteAllText($localJson, ($data | ConvertTo-Json -Depth 6))
} catch {
    Write-Host "JSON sidecar : FAILED  ($($_.Exception.Message))" -ForegroundColor Yellow
}

# Both files travel together, everywhere the report goes.
function Copy-ReportFiles([string]$Dir) {
    if (-not (Test-Path $Dir)) { New-Item -ItemType Directory -Path $Dir -Force -ErrorAction Stop | Out-Null }
    Copy-Item -Path $localFile -Destination (Join-Path $Dir $reportName) -Force -ErrorAction Stop
    if (Test-Path $localJson) { Copy-Item -Path $localJson -Destination (Join-Path $Dir $jsonName) -Force -ErrorAction Stop }
}

# --- Retire superseded reports --------------------------------------------
# A renamed PC (or one whose IP or owner changed) gets a NEW report filename,
# so the report filed under its OLD identity would sit beside the new one
# forever - a phantom PC in the inventory. After the fresh report lands in a
# folder, anything there that belongs to the same machine - same PC name
# (new or current) or same IP - under a different filename is moved into an
# archive\ subfolder, date-stamped. One live report per PC; history kept.
function Move-StaleReports([string]$Dir) {
    if (-not $Dir -or -not (Test-Path $Dir -ErrorAction SilentlyContinue)) { return }
    # .txt and .json alike; the pair sharing THIS report's stem is the live one.
    $stale = @(Get-ChildItem $Dir -File -ErrorAction SilentlyContinue | Where-Object {
        $_.BaseName -ne $reportStem -and
        $_.Name -match '^.+_(?<pc>[^_]+)_(?<ip>[^_]+)\.(txt|json)$' -and
        ($Matches.pc -eq $pcName -or $Matches.pc -eq $env:COMPUTERNAME -or
         ($primaryIp -ne 'no-ip' -and $Matches.ip -eq $primaryIp))
    })
    foreach ($f in $stale) {
        try {
            $arc = Join-Path $Dir 'archive'
            if (-not (Test-Path $arc)) { New-Item -ItemType Directory -Path $arc -Force -ErrorAction Stop | Out-Null }
            # Date-stamp with the report's own last-write date, so re-archiving
            # never overwrites an older snapshot of the same filename.
            $dest = Join-Path $arc ("{0}_{1}" -f $f.LastWriteTime.ToString('yyyyMMdd'), $f.Name)
            Move-Item $f.FullName $dest -Force -ErrorAction Stop
            Write-Host "Archived     : $($f.Name)  ->  archive\" -ForegroundColor DarkGray
        } catch { }
    }
}

# The local folder gets the same one-live-report-per-PC treatment as the share:
# a rename or a new IP would otherwise leave this PC's old report sitting
# beside its new one for good.
Move-StaleReports $localDir

Write-Host ""
Write-Host "Local report : $localFile" -ForegroundColor White
if (Test-Path $localJson) { Write-Host "Data (JSON)  : $localJson" -ForegroundColor White }

# --- Attempt 1: copy as whoever is signed in -------------------------------
# Works when that is an AD (domain) user. It CANNOT work when the PC is being
# set up under a LOCAL admin account - the file server only grants access to
# AD users, so a local account is refused ("user name or password is
# incorrect") even though the path is perfectly reachable.
# No ShareBase (a PC off the managed LAN, or the public build) means there is no
# server to file the report on - the local copy stands alone. $shareDir is empty
# then, so the whole share section is skipped.
$shareOk = $false
if ($shareDir) {
    try {
        # Create the reports/ subfolder on the share if it doesn't exist yet,
        # then copy the report (and its JSON) up under the same filenames.
        Copy-ReportFiles $shareDir
        $shareOk = $true
        Move-StaleReports $shareDir
    }
    catch {
        # Capture the reason so we can show it to the user.
        $shareErr = $_.Exception.Message
    }
}

# --- Attempt 2: borrow an AD account just for the copy ---------------------
# Only reached when attempt 1 failed. The usual cause is the local-admin case
# above, so rather than shrug, offer to authenticate to the file server with a
# domain account. The technician doing the setup has one to hand.
#
# New-PSDrive opens an authenticated session to the SERVER; once that exists,
# the ordinary UNC path works for the rest of this script. The session is torn
# down again immediately after - nothing is saved or remembered on the PC.
#
# Whoever is running this is standing at the machine, so a prompt is fine. If
# they decline, the pen copy below is still taken.
if (-not $shareOk -and $shareDir) {
    Write-Host ""
    Write-Host "Server copy  : FAILED  ($shareErr)" -ForegroundColor Yellow

    $iAmDomainUser = (Get-CimInstance Win32_ComputerSystem).PartOfDomain -and
                     ($env:USERDOMAIN -ne $env:COMPUTERNAME)

    if (-not $iAmDomainUser) {
        Write-Host "             : You are signed in as a LOCAL account ($env:USERDOMAIN\$env:USERNAME)." -ForegroundColor Yellow
        Write-Host "             : The file server only accepts AD (domain) users." -ForegroundColor Yellow
    }

    Write-Host ""
    $retry = Read-Host "  Send it to the server using a domain account? (y/n)"

    if ($retry -match '^[Yy]') {
        $cred = Get-KdCredential -Purpose 'the file server' -Message 'Domain account with access to the file server' -Hint $Site.AdminHint
        if ($cred) {
            try {
                New-PSDrive -Name 'KDReports' -PSProvider FileSystem `
                            -Root $shareRoot -Credential $cred -ErrorAction Stop | Out-Null
                try {
                    Copy-ReportFiles $shareDir
                    $shareOk = $true
                    Move-StaleReports $shareDir
                }
                finally {
                    # Always drop the session, even if the copy threw.
                    Remove-PSDrive -Name 'KDReports' -Force -ErrorAction SilentlyContinue
                }
            }
            catch {
                Write-Host "  Still failed: $($_.Exception.Message)" -ForegroundColor Red
                Forget-KdCredentialIfRefused -Purpose 'the file server' -Because $_
            }
        }
    }
}

if ($shareOk) {
    Write-Host "Server copy  : $shareDir\$reportName" -ForegroundColor Green
} else {
    Write-Host "Server copy  : not sent." -ForegroundColor Yellow
}

# --- Third copy: the setup pen, if it is plugged in ------------------------
# This is the one that matters on a PC with no network yet - it is how the
# report gets off the machine and back to you.
if ($penDir) {
    try {
        Copy-ReportFiles $penDir
        Write-Host "Pen copy     : $penDir\$reportName" -ForegroundColor Green
        Move-StaleReports $penDir
    }
    catch {
        Write-Host "Pen copy     : FAILED  ($($_.Exception.Message))" -ForegroundColor Yellow
    }
}
else {
    Write-Host "Pen copy     : skipped (setup pen not plugged in)" -ForegroundColor DarkGray
}

# Close the loop. Three cases worth spelling out, because the difference
# between them decides what the technician has to do next.
Write-Host ""
if (-not $shareOk -and $penDir -and $isCourtPc) {
    # The normal new-PC case: local admin, no AD rights, but the pen has it.
    Write-Host "The report is on the pen but NOT yet on the server." -ForegroundColor Cyan
    Write-Host "Push it up later from any PC signed in as an AD user:" -ForegroundColor Cyan
    Write-Host "    .\scripts\sync-pen-reports.ps1" -ForegroundColor White
    Write-Host "  (or, from the pen itself:  <pen>\network-tools\sync-pen-reports.ps1)" -ForegroundColor DarkGray
}
elseif (-not $shareOk -and -not $penDir -and $isCourtPc) {
    # Worst case - nothing left the machine.
    Write-Host "WARNING: this report exists ONLY on this PC's desktop." -ForegroundColor Red
    Write-Host "         Plug the setup pen in and re-run, or copy it off by hand." -ForegroundColor Red
}
