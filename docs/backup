# ---------------------------------------------------------------------------
#  SANITIZE RULESET
# ---------------------------------------------------------------------------
#  Three outcomes per file: COPY, QUARANTINE (copied into _quarantine\ with
#  .blocked appended, so nothing is lost and nothing can be run by accident),
#  or LOG (not copied, recorded with the reason).
#
#  This runs ALWAYS - it is not a fallback for a dead Defender, it is the
#  floor. Defender, when it is alive, is the extra layer on top.

# Quarantined wherever they are found.
$ExeHard = @(
    '.exe','.com','.scr','.pif','.cpl','.msi','.msp','.msc','.bat','.cmd',
    '.vbs','.vbe','.js','.jse','.wsf','.wsh','.ps1','.psm1','.ps1xml','.hta',
    '.jar','.reg','.dll','.sys','.ocx','.drv','.scf','.inf','.gadget',
    '.application','.appref-ms','.msix','.appx','.chm','.url'
)
# Quarantined only where the risk is high. A .py under Documents\src is a
# user's work; the same file in Downloads is a coin flip.
$ExeSoft  = @('.py','.pyw','.sh','.pl','.rb','.ahk','.iso','.img','.vhd','.vhdx','.apk')
$SoftRisk = '^(Downloads|Desktop|AppData)\\'

# Copied - this is real work - but flagged, because a macro is how most office
# infections actually arrive.
