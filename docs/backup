        '  duplicates.csv          exact copies that were NOT copied twice. Every',
        '                          row names the file that WAS kept and where it',
        '                          is. Nothing in this list is lost.',
        '  skipped.csv             what was left behind, and why',
        '  placeholders.csv        files that live only in OneDrive, never on the',
        '                          disk. They were NOT copied - sign in to OneDrive',
        '                          on the new PC to get them back.',
        '  shortcuts.csv           the .lnk shortcuts, with their targets, so they',
        '                          can be recreated (their old targets are gone)',
        '  macro-files.csv         documents with macros in them. They were copied.',
        '                          Open them in Protected View first.',
        '  quarantine.csv          what went into _quarantine\ and why',
        '  unreadable.csv          files that could not be read at all',
        '  scan.txt                what the virus check found',
        '',
        '  ABOUT _quarantine\',
        '  ------------------',
        '  Programs, scripts, installers and anything that looked like malware were',
        '  copied in there with .blocked added to the name, so they cannot run by',
        '  accident. NOTHING WAS DELETED. If you need one of them, check it first,',
        '  then rename it to remove .blocked.',
        '',
        '  Do not restore _quarantine\ wholesale onto the rebuilt PC.',
        '',
        '  A WARNING ABOUT WHERE THIS IS',
        '  -----------------------------',
        '  If this copy is on a partition of the same disk as the old C:, a',
        '  full-disk format destroys it too. Check that a second copy exists on a',
        '  USB pen or another drive BEFORE you start the reinstall.',
        '',
        '===========================================================================',
        '  KUDADONBE (KD)  -  Computer Consultancy',
        '  kudadonbe@outlook.com',
        '==========================================================================='
    )
    Set-Content -LiteralPath (Join-Path $Root 'README-RESTORE.txt') -Value $lines -Encoding UTF8
}


# ===========================================================================
#  MAIN
# ===========================================================================
Write-Head 'BACKUP  -  rescue user data before a format'

$isAdmin = ([Security.Principal.WindowsPrincipal] `
        [Security.Principal.WindowsIdentity]::GetCurrent()
    ).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)

if (-not $isAdmin) {
    Write-Bad 'This must be run as Administrator.'
    Write-Host '      Other people''s profiles are unreadable without it, and half the' -ForegroundColor Yellow
    Write-Host '      data would be missed in silence. Close this window, right-click' -ForegroundColor Yellow
    Write-Host '      PowerShell -> Run as administrator, then start the tool again.' -ForegroundColor Yellow
    return
}

$dryRun = ($env:KD_BACKUP_DRYRUN -eq '1')
if ($dryRun) { Write-Warn 'DRY RUN - it will plan everything and write the lists, but copy nothing.' }

# --- the machine we are standing at ---------------------------------------
Write-Sub 'THIS MACHINE'
Write-Host ("  PC     : {0}" -f $env:COMPUTERNAME)
try {
    $os = Get-CimInstance Win32_OperatingSystem -ErrorAction SilentlyContinue
    Write-Host ("  OS     : {0}" -f $os.Caption)
} catch { }

Write-Sub 'DISKS'
try {
    Get-PhysicalDisk -ErrorAction SilentlyContinue |
        Select-Object DeviceId, FriendlyName, MediaType, BusType, HealthStatus,
                      @{n='SizeGB';e={[math]::Round($_.Size / 1GB, 0)}} |
        Format-Table -AutoSize | Out-Host
} catch { Write-Warn 'could not read the physical disks' }

$vols = @(Get-WritableVolumes)
Show-Volumes $vols 0
$badHealth = @(Get-PhysicalDisk -ErrorAction SilentlyContinue | Where-Object { $_.HealthStatus -ne 'Healthy' })
if ($badHealth.Count -gt 0) {
    Write-Host ''
    Write-Bad 'At least one disk in this PC is NOT reporting Healthy.'
    Write-Warn 'Copy the important folders first and worry about completeness second -'
    Write-Warn 'a disk in this state can stop answering at any moment.'
}


# ---------------------------------------------------------------------------
#  STAGE 1  -  WHERE IS THE DATA
# ---------------------------------------------------------------------------
Write-Sub 'WHERE IS THE DATA'
$srcUsersRoot = ''
if ($env:KD_BACKUP_SRC) {
    $srcUsersRoot = $env:KD_BACKUP_SRC
    Write-Step "using KD_BACKUP_SRC = $srcUsersRoot"
} else {
    Write-Host '  1.  This PC            C:\Users'
    Write-Host '  2.  Another disk       slaved or USB-docked - you type the path'
    Write-Host '  3.  A single folder    any path at all'
    Write-Host '  0.  Cancel'
    $pick = (Read-Host '  Choice').Trim()
    if ($pick -eq '1' -or $pick -eq '') { $srcUsersRoot = 'C:\Users' }
    elseif ($pick -eq '2' -or $pick -eq '3') {
        Write-Host ''
        Write-Dim 'For a slaved disk this is normally <letter>:\Users - the tool will'
        Write-Dim 'offer that for you if you just give it the drive letter.'
        $typed = (Read-Host '  Path').Trim().Trim('"')
        if (-not $typed) { Write-Warn 'Nothing entered. Cancelled.'; return }
        if ($typed -match '^[A-Za-z]:\\?$') {
            $root = $typed.TrimEnd('\')
            $u = Join-Path $root 'Users'
            $w = Join-Path $root 'Windows'
            if (Test-Path -LiteralPath $u) {
                Write-Ok "found $u - that looks like a Windows disk."
                $srcUsersRoot = $u
            } elseif (Test-Path -LiteralPath $w) {
                Write-Warn "$root has Windows but no Users folder. Using the drive root."
                $srcUsersRoot = $root
            } else {
                $srcUsersRoot = $root
            }
        } else {
            $srcUsersRoot = $typed
        }
    } else { Write-Warn 'Cancelled.'; return }
}

if (-not (Test-Path -LiteralPath $srcUsersRoot)) {
    Write-Bad "$srcUsersRoot does not exist."
    return
}
# The PC this data BELONGS to. In slaved mode this machine's name is wrong.
$isLive = ($srcUsersRoot -match '^[Cc]:\\')
$pcName = $env:COMPUTERNAME
if (-not $isLive) {
    $typedName = (Read-Host "  Name of the PC this disk came from (Enter = UNKNOWN-PC)").Trim()
    $pcName = 'UNKNOWN-PC'
    if ($typedName) { $pcName = ($typedName -replace '[^\w\.-]', '_') }
    Write-Ok 'Slaved mode. This is the safer way to do it: the Defender that scans'
    Write-Dim 'the rescued files is this healthy PC''s, not the sick one''s.'
}

# --- pick the profiles -----------------------------------------------------
$profileDirs = @(Get-ProfileDirs $srcUsersRoot)
if ($profileDirs.Count -eq 0) {
    # Not a Users folder - treat whatever was given as one big "profile".
    Write-Warn "No user profiles under $srcUsersRoot - treating it as a single folder."
    $profileDirs = @(Get-Item -LiteralPath $srcUsersRoot)
}

Write-Sub 'PROFILES'
for ($i = 0; $i -lt $profileDirs.Count; $i++) {
    $p = $profileDirs[$i]
    $last = 'unknown'
    $docs = Join-Path $p.FullName 'Documents'
    $probe = $p.FullName
    if (Test-Path -LiteralPath $docs) { $probe = $docs }
    $newest = Get-ChildItem -LiteralPath $probe -File -Force -ErrorAction SilentlyContinue |
              Sort-Object LastWriteTime -Descending | Select-Object -First 1
    if ($newest) { $last = $newest.LastWriteTime.ToString('yyyy-MM-dd') }
    Write-Host ("  {0,2}.  {1,-28}  last document {2}" -f ($i + 1), $p.Name, $last)
}
Write-Host ''
$sel = (Read-Host '  Which? (Enter = all, or 1,3,4)').Trim()
$chosen = $profileDirs
if ($sel) {
    $idx = @($sel -split '[,\s]+' | Where-Object { $_ -match '^\d+$' } | ForEach-Object { [int]$_ - 1 })
    $chosen = @($idx | Where-Object { $_ -ge 0 -and $_ -lt $profileDirs.Count } | ForEach-Object { $profileDirs[$_] })
}
if ($chosen.Count -eq 0) { Write-Warn 'No profile selected. Cancelled.'; return }
Write-Ok ("{0} profile(s) selected." -f $chosen.Count)


# ---------------------------------------------------------------------------
#  STAGE 2  -  OPTIONS
# ---------------------------------------------------------------------------
Write-Sub 'OPTIONS'
$withDownloads = Confirm-Default 'Include Downloads? (big, often junk, and the usual way malware arrives)' $true
$withOst       = Confirm-Default 'Include Outlook .ost cache files? (they rebuild themselves from the server)' $false
$withExtras    = Confirm-Default 'Collect the rebuild extras (programs, printers, Wi-Fi keys, network)?' $true
if (-not $dryRun) { $dryRun = Confirm-Default 'Dry run - plan it and write the lists, but copy nothing?' $false }

# Close the apps that hold data files open. This single step fixes almost
# every "the file is in use" failure later on - an open PST above all.
if ($isLive) {
    $holders = @('outlook','winword','excel','powerpnt','onenote','msaccess','msedge','chrome','firefox','teams')
    $running = @(Get-Process -Name $holders -ErrorAction SilentlyContinue)
    if ($running.Count -gt 0) {
        Write-Warn ("{0} app(s) are holding files open: {1}" -f $running.Count, (($running | Select-Object -Expand Name -Unique) -join ', '))
        if (Confirm-Default 'Close them now? (anything unsaved in them is lost)' $true) {
            foreach ($p in $running) { try { $null = $p.CloseMainWindow() } catch { } }
            Start-Sleep -Seconds 5
            $still = @(Get-Process -Name $holders -ErrorAction SilentlyContinue)
            if ($still.Count -gt 0 -and (Confirm-Action 'Some are still running. Force them closed?')) {
                foreach ($p in $still) { try { Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue } catch { } }
            }
        }
    }
}


# ---------------------------------------------------------------------------
#  STAGE 3  -  ENUMERATE AND ESTIMATE
# ---------------------------------------------------------------------------
Write-Sub 'READING THE DISK'
Write-Dim 'Nothing is written until you have seen the numbers and typed YES.'

$files   = New-Object System.Collections.Generic.List[object]
$skipped = New-Object System.Collections.Generic.List[object]
$swAll   = [Diagnostics.Stopwatch]::StartNew()

foreach ($p in $chosen) {
    Write-Step "walking $($p.Name) ..."
    $n = Get-BackupCandidates $p.FullName $p.Name $files $skipped $withDownloads
    Write-Ok ("{0}: {1:N0} file(s)" -f $p.Name, $n)
}
$swAll.Stop()

if (-not $withOst) {
    $ost = @($files | Where-Object { $_.Rel -imatch '\.ost$' })
    foreach ($f in $ost) { $skipped.Add((New-Skip $f.Profile $f.Rel 'OST-EXCLUDED' $f.Bytes)) }
    if ($ost.Count -gt 0) {
        $keep = New-Object System.Collections.Generic.List[object]
        foreach ($f in $files) { if ($f.Rel -notmatch '\.ost$') { $keep.Add($f) } }
        $files = $keep
        Write-Step ("dropped {0} Outlook .ost cache file(s), {1}" -f $ost.Count, (Format-Size (($ost | Measure-Object Bytes -Sum).Sum)))
    }
}

if ($files.Count -eq 0) { Write-Bad 'Nothing to back up. Stopping.'; return }

# --- sanitize verdicts, before dedupe so we do not hash what we will not keep
Write-Step 'applying the sanitize rules ...'
$shortcuts  = New-Object System.Collections.Generic.List[object]
$quarantine = New-Object System.Collections.Generic.List[object]
$macros     = New-Object System.Collections.Generic.List[object]
$keepList   = New-Object System.Collections.Generic.List[object]
$wshLnk     = $null
try { $wshLnk = New-Object -ComObject WScript.Shell } catch { }

foreach ($f in $files) {
    $v = Get-SanitizeVerdict $f
    $f.Verdict = $v[0]
    $f.Reason  = $v[1]
    $ext = [IO.Path]::GetExtension($f.Rel).ToLower()

    if ($f.Verdict -eq 'LOG') {
        if ($f.Reason -eq 'SHORTCUT' -and $wshLnk) {
            $sc = $null
            try { $sc = $wshLnk.CreateShortcut($f.Full) } catch { }
            if ($sc) {
                $shortcuts.Add([pscustomobject]@{
                    Profile = $f.Profile; Rel = $f.Rel; Target = $sc.TargetPath
                    Arguments = $sc.Arguments; WorkingDir = $sc.WorkingDirectory
                })
            }
        }
        $skipped.Add((New-Skip $f.Profile $f.Rel ('SANITIZE-' + $f.Reason) $f.Bytes))
        continue
    }
    if ($f.Verdict -eq 'QUARANTINE') {
        $quarantine.Add([pscustomobject]@{
            Profile = $f.Profile; Rel = $f.Rel; Reason = $f.Reason
            Bytes = $f.Bytes; Threat = ''; Source = 'sanitize-rule'
        })
    }
    if ($MacroDoc -contains $ext) {
        $macros.Add([pscustomobject]@{ Profile = $f.Profile; Rel = $f.Rel; Bytes = $f.Bytes })
    }
    $f.Tier = Get-Tier $ext $f.Bytes
    $keepList.Add($f)
}
$files = $keepList

$qCount = @($files | Where-Object { $_.Verdict -eq 'QUARANTINE' }).Count
Write-Ok ("{0:N0} file(s) to copy, {1:N0} of them quarantined, {2:N0} shortcut(s) recorded" -f $files.Count, $qCount, $shortcuts.Count)

# --- the estimate ----------------------------------------------------------
Write-Sub ('ENUMERATION  ({0} profile(s), {1})' -f $chosen.Count, $swAll.Elapsed.ToString('hh\:mm\:ss'))
Write-Host ('  profile                       files      to copy       junk    cloud-only') -ForegroundColor DarkGray
Write-Host ('  -------------------------------------------------------------------------') -ForegroundColor DarkGray
foreach ($p in $chosen) {
    $mine  = @($files   | Where-Object { $_.Profile -eq $p.Name })
    $sk    = @($skipped | Where-Object { $_.Profile -eq $p.Name })
    $bytes = ($mine | Measure-Object Bytes -Sum).Sum
    $junk  = (@($sk | Where-Object { $_.Reason -like 'JUNK*' -or $_.Reason -like '*EXCLUDED' }) | Measure-Object Bytes -Sum).Sum
    $cloud = @($sk | Where-Object { $_.Reason -eq 'CLOUD-PLACEHOLDER' })
    $cb    = ($cloud | Measure-Object Bytes -Sum).Sum
    Write-Host ("  {0,-24} {1,8:N0} {2,12} {3,10} {4,8:N0} ({5})" -f `
        $p.Name, $mine.Count, (Format-Size $bytes), (Format-Size $junk), $cloud.Count, (Format-Size $cb))
}
$totalBytes = ($files | Measure-Object Bytes -Sum).Sum
if (-not $totalBytes) { $totalBytes = 0 }
Write-Host ('  -------------------------------------------------------------------------') -ForegroundColor DarkGray
Write-Host ("  {0,-24} {1,8:N0} {2,12}" -f 'TOTAL', $files.Count, (Format-Size $totalBytes)) -ForegroundColor White

$placeholders = @($skipped | Where-Object { $_.Reason -eq 'CLOUD-PLACEHOLDER' })
if ($placeholders.Count -gt 0) {
    $pb = ($placeholders | Measure-Object Bytes -Sum).Sum
    Write-Host ''
    Write-Warn ("{0:N0} file(s), {1}, exist ONLY in OneDrive - not on this disk." -f $placeholders.Count, (Format-Size $pb))
    Write-Warn 'They are listed in placeholders.csv and they are NOT being copied.'
    Write-Warn 'Before you format: open OneDrive and choose "Always keep on this'
    Write-Warn 'device", or make sure someone still has the account password.'
}
$denied = @($skipped | Where-Object { $_.Reason -eq 'DENIED' })
if ($denied.Count -gt 0) { Write-Warn ("{0} folder(s) refused to open even as Administrator." -f $denied.Count) }


# ---------------------------------------------------------------------------
#  STAGE 4  -  DEDUPE
# ---------------------------------------------------------------------------
Write-Sub 'DUPLICATES'
$dupes = New-Object System.Collections.Generic.List[object]
$files = Invoke-Dedupe $files $dupes
$dupBytes = ($dupes | Measure-Object Bytes -Sum).Sum
if (-not $dupBytes) { $dupBytes = 0 }
$totalBytes = ($files | Measure-Object Bytes -Sum).Sum
if (-not $totalBytes) { $totalBytes = 0 }
if ($dupes.Count -gt 0) {
    Write-Ok ("{0:N0} exact copy/copies dropped, {1} saved. Each one is logged in duplicates.csv" -f $dupes.Count, (Format-Size $dupBytes))
    # A quarantined file can itself be an exact copy of another one, and then
    # it never reaches _quarantine\. Drop it from the list too, so
    # quarantine.csv and the folder always agree.
    $stillHere = New-Object 'System.Collections.Generic.HashSet[string]'
    foreach ($f in $files) {
        if ($f.Verdict -eq 'QUARANTINE') { [void]$stillHere.Add(('{0}\{1}' -f $f.Profile, $f.Rel)) }
    }
    $qKeep = New-Object System.Collections.Generic.List[object]
    foreach ($q in $quarantine) {
        if ($stillHere.Contains(('{0}\{1}' -f $q.Profile, $q.Rel))) { $qKeep.Add($q) }
    }
    $quarantine = $qKeep
    $qCount = $quarantine.Count
}
Write-Host ("  after dedupe: {0:N0} file(s), {1}" -f $files.Count, (Format-Size $totalBytes)) -ForegroundColor White


# ---------------------------------------------------------------------------
#  STAGE 5  -  WHERE IT GOES
# ---------------------------------------------------------------------------
#  C: is not offered: backing C: up onto C: before formatting C: is theatre.
#  Type it in by hand under "P" if you really mean it.
$need = [long]($totalBytes * 1.02)
$destRoot = ''
$penRootDrive = ''

if ($env:KD_BACKUP_DEST) {
    $destRoot = $env:KD_BACKUP_DEST
    Write-Step "using KD_BACKUP_DEST = $destRoot"
}

while (-not $destRoot) {
    Write-Sub ('DESTINATION  -  it needs {0}' -f (Format-Size $need))
    $cands = @(Get-WritableVolumes | Where-Object { $_.Letter -ne 'C:' -and $_.Letter -ne ($srcUsersRoot.Substring(0,2)) })
    if ($cands.Count -gt 0) { Show-Volumes $cands $need }
    else { Write-Warn 'There is no other partition on this PC.' }
    Write-Host ''
    Write-Host '   P.  Type any other writable path (external drive, mapped drive, share)'
    Write-Host '   S.  Shrink C: to make a rescue partition   (last resort - read the warning)'
    Write-Host '   0.  Cancel'
    Write-Dim 'Borrowing any external drive or a second pen beats shrinking C:.'
    $pick = (Read-Host '  Choice').Trim()

    if ($pick -eq '0') { Write-Warn 'Cancelled. Nothing was written.'; return }
    elseif ($pick -match '^[Pp]$') {
        $typed = (Read-Host '  Path').Trim().Trim('"')
        if (-not $typed) { continue }
        if (-not (Test-Path -LiteralPath $typed)) {
            try { New-Item -ItemType Directory -Force -Path $typed | Out-Null } catch { Write-Bad "Cannot create $typed"; continue }
        }
        if (-not (Test-Writable $typed)) { Write-Bad "Cannot write to $typed"; continue }
        $destRoot = $typed
    }
    elseif ($pick -match '^[Ss]$') {
        $r = Invoke-ShrinkForRescue $need $false $srcUsersRoot
        if ($r) { $destRoot = $r }
        # any guard that failed already explained itself; back to the menu
    }
    elseif ($pick -match '^\d+$' -and [int]$pick -ge 1 -and [int]$pick -le $cands.Count) {
        $v = $cands[[int]$pick - 1]
        if ($v.Free -lt $need) {
            Write-Warn ("{0} has only {1} free and the backup needs {2}." -f $v.Letter, (Format-Size $v.Free), (Format-Size $need))
            if (-not (Confirm-Action 'Use it anyway and let it fill up?')) { continue }
        }
        if (-not (Test-Writable "$($v.Letter)\")) { Write-Bad "Cannot write to $($v.Letter)"; continue }
        $destRoot = "$($v.Letter)\"
    }
    else { Write-Warn 'Not a choice on the list.' }
}

# --- the second copy, on a pen --------------------------------------------
Write-Sub 'SECOND COPY  -  the USB pen'
Write-Dim 'This is the copy that survives a full-disk format. Skipping it is a risk.'
$pen = $null
$penCands = @(Get-WritableVolumes | Where-Object {
    $_.Letter -ne 'C:' -and "$($_.Letter)\" -ne $destRoot -and ($_.Kind -eq 'removable' -or $_.Size -lt 512GB)
})
if ($penCands.Count -eq 0) {
    Write-Warn 'No removable drive found. Plug one in and it will be offered, or press Enter to skip.'
    if (Confirm-Default 'Rescan for a pen now?' $true) { $penCands = @(Get-WritableVolumes | Where-Object { $_.Kind -eq 'removable' }) }
}
if ($penCands.Count -gt 0) {
    Show-Volumes $penCands $need
    Write-Host ''
    Write-Host '   n.  No second copy'
    $pp = (Read-Host '  Choice').Trim()
    if ($pp -match '^\d+$' -and [int]$pp -ge 1 -and [int]$pp -le $penCands.Count) {
        $pen = $penCands[[int]$pp - 1]
        if (Test-Path -LiteralPath (Join-Path "$($pen.Letter)\" 'network-tools')) {
            Write-Warn 'That is the KUDADONBE tools pen. Filling it with user data risks'
            Write-Warn 'the tools you need for the rebuild.'
            if (-not (Confirm-Action 'Use it anyway?')) { $pen = $null }
        }
    }
}
if ($pen) {
    $worms = @(Test-ShortcutWorm "$($pen.Letter)\")
    if ($worms.Count -gt 0) {
        Write-Bad ("This pen already looks infected - {0} worm-style shortcut(s):" -f $worms.Count)
        foreach ($w in $worms) { Write-Dim ("{0}  ->  {1} {2}" -f $w.Lnk, $w.Target, $w.Args) }
        if (-not (Confirm-Action 'Use it anyway?')) { $pen = $null }
    }
}
if (-not $pen) { Write-Warn 'No second copy. The backup will exist in exactly one place.' }

# The source may itself be a stick that carried the infection in.
$srcDrive = $srcUsersRoot.Substring(0, 3)
$srcVol = @(Get-WritableVolumes | Where-Object { "$($_.Letter)\" -eq $srcDrive -and $_.Kind -eq 'removable' })
if ($srcVol.Count -gt 0) {
    $sw2 = @(Test-ShortcutWorm $srcDrive)
    if ($sw2.Count -gt 0) {
        Write-Bad 'The SOURCE drive shows the classic USB worm pattern: your folders'
        Write-Bad 'were hidden and replaced with shortcuts that run something first.'
        Write-Warn 'The real folders are being copied and un-hidden. The shortcuts are not.'
    }
}


# ---------------------------------------------------------------------------
#  STAGE 6  -  THE PLAN, AND ONE TYPED YES
# ---------------------------------------------------------------------------
$stamp      = Get-Date -Format 'yyyyMMdd_HHmm'
$folderName = "{0}_{1}" -f $pcName, $stamp
if ($dryRun) { $folderName = "$folderName-DRYRUN" }
$backupRoot = Join-Path (Join-Path $destRoot 'KD-Backup') $folderName
$penRoot    = ''
if ($pen) { $penRoot = Join-Path (Join-Path "$($pen.Letter)\" 'KD-Backup') $folderName }

$defenderAlive = Test-DefenderAlive

Write-Sub 'THE PLAN'
Write-Host ("  from        : {0}" -f $srcUsersRoot)
Write-Host ("  profiles    : {0}" -f (($chosen | Select-Object -Expand Name) -join ', '))
Write-Host ("  files       : {0:N0}   ({1})" -f $files.Count, (Format-Size $totalBytes))
Write-Host ("  to          : {0}" -f $backupRoot)
$penLine = '(none - one copy only)'
if ($penRoot) { $penLine = $penRoot }
Write-Host ("  second copy : {0}" -f $penLine)
$avLine = 'DEFENDER IS NOT AVAILABLE - the sanitize rules are the only defence'
if ($defenderAlive) { $avLine = 'Defender is alive - it will scan the finished backup' }
Write-Host ("  virus       : {0}" -f $avLine)
if ($dryRun) { Write-Host '  DRY RUN     : the lists will be written, the data will NOT be copied' -ForegroundColor Yellow }
Write-Host ''
if ((Read-Host '  Type YES to start') -ne 'YES') { Write-Warn 'Cancelled. Nothing was written.'; return }


# ---------------------------------------------------------------------------
#  STAGE 7  -  COPY
# ---------------------------------------------------------------------------
New-Item -ItemType Directory -Force -Path $backupRoot | Out-Null
$unreadable = New-Object System.Collections.Generic.List[object]
$copied = 0
$copiedBytes = 0
$failed = 0

Write-Sub 'COPYING'
if ($dryRun) {
    Write-Warn 'Dry run: writing the lists only.'
} else {
    $tick = New-Ticker
    foreach ($f in $files) {
        $rel = Join-Path $f.Profile $f.Rel
        if ($f.Verdict -eq 'QUARANTINE') {
            $dst = Join-Path (Join-Path $backupRoot '_quarantine') ($rel + '.blocked')
        } else {
            $dst = Join-Path (Join-Path $backupRoot 'users') $rel
        }
        $r = Copy-OneFile $f.Full $dst $f.MTime
        if ($r -eq 'OK') {
            $copied++
            $copiedBytes += $f.Bytes
        } else {
            $failed++
            Write-Host ("  [FAIL] {0}\{1}" -f $f.Profile, $f.Rel) -ForegroundColor Red
            Write-Dim $r
            $unreadable.Add([pscustomobject]@{ Profile = $f.Profile; Rel = $f.Rel; Bytes = $f.Bytes; Error = $r })
        }
        if (Test-Tick $tick) {
            $pct = 0
            if ($totalBytes -gt 0) { $pct = [math]::Round(100 * $copiedBytes / $totalBytes) }
            $mbs = 0
            if ($tick.Sw.Elapsed.TotalSeconds -gt 0) { $mbs = [math]::Round(($copiedBytes / 1MB) / $tick.Sw.Elapsed.TotalSeconds, 1) }
            $eta = '--:--:--'
            if ($mbs -gt 0) { $eta = [TimeSpan]::FromSeconds((($totalBytes - $copiedBytes) / 1MB) / $mbs).ToString('hh\:mm\:ss') }
            Write-Step ("{0:N0}/{1:N0} files  {2}/{3}  {4}%  {5} MB/s  eta {6}" -f `
                $copied, $files.Count, (Format-Size $copiedBytes), (Format-Size $totalBytes), $pct, $mbs, $eta)
        }
    }

    # The subtrees the walker would not descend, handed to robocopy whole.
    # /XJ is its own reparse-loop guard. These are NOT deduped and NOT
    # sanitize-filtered, and skipped.csv says so.
    $longs = @($skipped | Where-Object { $_.Reason -eq 'PATH-TOO-LONG' })
    foreach ($l in $longs) {
        $srcDir = Join-Path (Join-Path $srcUsersRoot $l.Profile) $l.Rel
        $dstDir = Join-Path (Join-Path (Join-Path $backupRoot 'users') $l.Profile) $l.Rel
        Write-Step "long path - bulk copy of $($l.Rel)"
        $null = & robocopy.exe $srcDir $dstDir /E /COPY:DAT /R:1 /W:1 /XJ /NP /NFL /NDL /NJH /NJS 2>&1
        $l.Reason = 'LONG-PATH-BULK-COPY'
    }

    Write-Ok ("{0:N0} file(s) copied, {1}" -f $copied, (Format-Size $copiedBytes))
    if ($failed -gt 0) { Write-Bad ("{0} file(s) could NOT be read - see unreadable.csv" -f $failed) }
}


# ---------------------------------------------------------------------------
#  STAGE 8  -  REBUILD EXTRAS
# ---------------------------------------------------------------------------
if ($withExtras -and -not $dryRun) {
    Write-Sub 'REBUILD EXTRAS'
    Save-Extras (Join-Path $backupRoot 'extras') $isLive
}


# ---------------------------------------------------------------------------
#  STAGE 9  -  THE MANIFESTS
# ---------------------------------------------------------------------------
#  These stay INSIDE the backup folder. They are a list of the user's file
#  names, which is personal data - they must never be filed under reports\ on
#  the pen, because sync-pen-reports pushes that whole folder to the server.
Write-Sub 'WRITING THE LISTS'
function Save-Csv($rows, $path, $label) {
    # Count with Measure-Object, NOT @($rows).Count: wrapping a
    # System.Collections.Generic.List in the array subexpression throws
    # "Argument types do not match" on Windows PowerShell 5.1, and half of
    # these lists are exactly that.
    $n = ($rows | Measure-Object).Count
    if ($n -eq 0) { return }
    try {
        $rows | Export-Csv -LiteralPath $path -NoTypeInformation -Encoding UTF8
        Write-Ok ("{0}  ({1:N0} row(s))" -f $label, $n)
    } catch { Write-Warn "$label failed: $($_.Exception.Message)" }
}

$manifest = foreach ($f in $files) {
    [pscustomobject]@{
        Profile   = $f.Profile
        Rel       = $f.Rel
        Bytes     = $f.Bytes
        SHA256    = $f.Hash
        LastWrite = $f.MTime
        Tier      = $f.Tier
        Verdict   = $f.Verdict
        Reason    = $f.Reason
        PenCopied = $false
    }
}
Save-Csv $manifest     (Join-Path $backupRoot 'manifest.csv')     'manifest.csv'
Save-Csv $dupes        (Join-Path $backupRoot 'duplicates.csv')   'duplicates.csv'
Save-Csv $skipped      (Join-Path $backupRoot 'skipped.csv')      'skipped.csv'
Save-Csv $placeholders (Join-Path $backupRoot 'placeholders.csv') 'placeholders.csv'
Save-Csv $shortcuts    (Join-Path $backupRoot 'shortcuts.csv')    'shortcuts.csv'
Save-Csv $macros       (Join-Path $backupRoot 'macro-files.csv')  'macro-files.csv'
Save-Csv $unreadable   (Join-Path $backupRoot 'unreadable.csv')   'unreadable.csv'

Save-RestoreReadme $backupRoot ([pscustomobject]@{
    PcName = $pcName
    When   = (Get-Date -Format 'yyyy-MM-dd HH:mm')
    Source = $srcUsersRoot
})

# The invariant that makes dedupe safe: every duplicate that was dropped must
# name a file that IS in the manifest. Checked, and printed, every run.
$dupOrphans = 0
if ($dupes.Count -gt 0) {
    $kept = New-Object 'System.Collections.Generic.HashSet[string]'
    foreach ($m in $manifest) { [void]$kept.Add(('{0}\{1}' -f $m.Profile, $m.Rel)) }
    foreach ($d in $dupes) { if (-not $kept.Contains($d.Kept)) { $dupOrphans++ } }
    if ($dupOrphans -eq 0) { Write-Ok 'self-check: every dropped duplicate points at a file that IS in the backup.' }
    else { Write-Bad ("self-check FAILED: {0} duplicate row(s) point at a file that is not here." -f $dupOrphans) }
}


# ---------------------------------------------------------------------------
#  STAGE 10  -  VIRUS
# ---------------------------------------------------------------------------
Write-Sub 'VIRUS CHECK'
$scanLines = @()
if ($dryRun) {
    Write-Warn 'Dry run - no scan.'
} elseif (-not $defenderAlive) {
    Write-Bad 'Windows Defender is not available on this machine.'
    Write-Warn 'That is the normal state of a PC that is about to be formatted, and'
    Write-Warn 'it is why the sanitize rules run on every backup:'
    Write-Warn ("  - {0} file(s) were quarantined by rule, not by a scanner" -f $qCount)
    Write-Warn ("  - {0} shortcut(s) were recorded but not copied" -f $shortcuts.Count)
    Write-Warn ("  - {0} macro document(s) were copied and flagged" -f $macros.Count)
    Write-Host ''
    Write-Warn 'SCAN THIS BACKUP BEFORE YOU RESTORE IT. On a healthy PC, run the'
    Write-Warn 'backup-restore tool and pick "check a backup" - it updates Defender'
    Write-Warn 'and scans the whole folder before it puts anything back.'
    $scanLines = @(
        'Defender was NOT available when this backup was taken.',
        'Only the sanitize rules were applied. This backup has NOT been scanned.',
        'Scan it with backup-restore on a healthy PC before restoring.'
    )
} else {
    if (-not $isLive) { Write-Ok 'Scanning with this healthy PC''s Defender, not the sick machine''s.' }
    $scan = Invoke-DefenderScan $backupRoot
    $scanLines = @(
        ("Scanned  : {0}" -f (Get-Date -Format 'yyyy-MM-dd HH:mm')),
        ("On PC    : {0}" -f $env:COMPUTERNAME),
        ("Sigs     : {0}" -f $scan.Signatures),
        ("Ran      : {0}" -f $scan.Ran),
        ("Threats  : {0}" -f @($scan.Threats).Count)
    )
    if ($scan.Note) { $scanLines += ("Note     : {0}" -f $scan.Note) }

    if (@($scan.Threats).Count -eq 0) {
        Write-Ok 'Defender found nothing in the backup.'
    } else {
        Write-Host ''
        Write-Bad ("Defender found {0} threat(s) in the backup." -f @($scan.Threats).Count)
        foreach ($t in $scan.Threats) {
            Write-Dim ("{0}   {1}" -f $t.ThreatName, ($t.Resources -join '; '))
            $scanLines += ("THREAT   : {0}  {1}" -f $t.ThreatName, ($t.Resources -join '; '))
        }
        Write-Host ''
        Write-Warn 'Nothing was deleted - Defender was told not to touch them.'
        if (Confirm-Default 'Move them into _quarantine\ inside the backup?' $true) {
            $usersDir = Join-Path $backupRoot 'users'
            foreach ($t in $scan.Threats) {
                foreach ($res in @($t.Resources)) {
                    $p = $res -replace '^file:_', ''
                    if (-not (Test-Path -LiteralPath $p)) { continue }
                    if (-not $p.StartsWith($usersDir, 'OrdinalIgnoreCase')) { continue }
                    $rel = $p.Substring($usersDir.Length + 1)
                    $dst = Join-Path (Join-Path $backupRoot '_quarantine') ($rel + '.blocked')
                    try {
                        $dd = Split-Path $dst -Parent
                        if (-not (Test-Path -LiteralPath $dd)) { New-Item -ItemType Directory -Force -Path $dd | Out-Null }
                        Move-Item -LiteralPath $p -Destination $dst -Force -ErrorAction Stop
                        $quarantine.Add([pscustomobject]@{
                            Profile = ($rel -split '\\')[0]
                            Rel     = ($rel -split '\\', 2)[1]
                            Reason  = 'defender-detection'
                            Bytes   = 0
                            Threat  = $t.ThreatName
                            Source  = 'defender'
                        })
                        # keep it off the pen as well
                        foreach ($f in $files) {
                            if ((Join-Path $f.Profile $f.Rel) -ieq $rel) { $f.Verdict = 'QUARANTINE' }
                        }
                        Write-Ok "quarantined $rel"
                    } catch { Write-Warn "could not move $rel : $($_.Exception.Message)" }
                }
            }
            $scanLines += 'Detections were MOVED to _quarantine\ (nothing deleted).'
        }
    }
}
Set-Content -LiteralPath (Join-Path $backupRoot 'scan.txt') -Value $scanLines -Encoding UTF8
Save-Csv $quarantine (Join-Path $backupRoot 'quarantine.csv') 'quarantine.csv'


# ---------------------------------------------------------------------------
#  STAGE 11  -  THE PEN, FILLED BY PRIORITY
# ---------------------------------------------------------------------------
$notFit = New-Object System.Collections.Generic.List[object]
$penCopied = 0
$penBytes = 0
if ($penRoot -and -not $dryRun) {
    Write-Sub 'SECOND COPY  -  filling the pen by priority'
    New-Item -ItemType Directory -Force -Path $penRoot | Out-Null

    $vol = Get-Volume -DriveLetter $pen.Letter.TrimEnd(':') -ErrorAction SilentlyContinue
    $fatLimit = [long]::MaxValue
    if ($vol -and $vol.FileSystem -eq 'FAT32') {
        $fatLimit = 4GB - 1MB
        Write-Warn 'The pen is FAT32: no single file over 4 GB can be written to it.'
    }
    $budget = ($pen.Free) - 256MB      # headroom, so the pen stays mountable

    # Tier 0 first and unconditionally: the lists, the README and extras\ are
    # tiny, and they are the map to everything else.
    Write-Step 'tier 0: the lists, the README and extras ...'
    foreach ($item in (Get-ChildItem -LiteralPath $backupRoot -File -ErrorAction SilentlyContinue)) {
        $r = Copy-OneFile $item.FullName (Join-Path $penRoot $item.Name) $item.LastWriteTime
        if ($r -eq 'OK') { $budget -= $item.Length }
    }
    $exDir = Join-Path $backupRoot 'extras'
    if (Test-Path -LiteralPath $exDir) {
        $null = & robocopy.exe $exDir (Join-Path $penRoot 'extras') /E /COPY:DAT /R:1 /W:1 /XJ /NP /NFL /NDL /NJH /NJS 2>&1
    }

    # Then 1, 2, 3, 4. Small files first inside a tier: it rescues the most
    # documents, and it lets the greedy pass backfill the gap an oversized file
    # leaves behind. Quarantined files never go on the pen.
    $penFiles = @($files | Where-Object { $_.Verdict -eq 'COPY' } | Sort-Object Tier, Bytes)
    $tick = New-Ticker
    foreach ($f in $penFiles) {
        if ($f.Bytes -ge $fatLimit) {
            $notFit.Add([pscustomobject]@{ Profile=$f.Profile; Rel=$f.Rel; Bytes=$f.Bytes; Tier=$f.Tier; Reason='FAT32-OVER-4GB' })
            continue
        }
        if ($f.Bytes -gt $budget) {
            # continue, NOT break - one big file must not block the thousands
            # of small ones queued behind it.
            $notFit.Add([pscustomobject]@{ Profile=$f.Profile; Rel=$f.Rel; Bytes=$f.Bytes; Tier=$f.Tier; Reason='NO-SPACE' })
            continue
        }
        $src = Join-Path (Join-Path (Join-Path $backupRoot 'users') $f.Profile) $f.Rel
        if (-not (Test-Path -LiteralPath $src)) { continue }
        $r = Copy-OneFile $src (Join-Path (Join-Path $penRoot 'users') (Join-Path $f.Profile $f.Rel)) $f.MTime
        if ($r -eq 'OK') {
            $budget -= $f.Bytes
            $penCopied++
            $penBytes += $f.Bytes
            $f.OnPen = $true
        }
        if (Test-Tick $tick) {
            Write-Step ("pen: {0:N0} file(s), {1} written, {2} free left" -f $penCopied, (Format-Size $penBytes), (Format-Size $budget))
        }
    }

    $penManifest = foreach ($f in $penFiles) {
        if (-not $f.OnPen) { continue }
        [pscustomobject]@{ Profile = $f.Profile; Rel = $f.Rel; Bytes = $f.Bytes; Tier = $f.Tier }
    }
    Save-Csv $penManifest (Join-Path $penRoot 'pen-manifest.csv') 'pen-manifest.csv'
    Save-Csv $notFit      (Join-Path $penRoot 'not-on-pen.csv')   'not-on-pen.csv'
    Save-Csv $notFit      (Join-Path $backupRoot 'not-on-pen.csv') 'not-on-pen.csv (backup copy)'

    Write-Ok ("pen: {0:N0} file(s), {1}" -f $penCopied, (Format-Size $penBytes))
    if ($notFit.Count -gt 0) {
        $nb = ($notFit | Measure-Object Bytes -Sum).Sum
        Write-Warn ("{0:N0} file(s), {1}, did not fit on the pen." -f $notFit.Count, (Format-Size $nb))
        Write-Warn 'They exist only in the main copy. See not-on-pen.csv.'
    }
}


# ---------------------------------------------------------------------------
#  DONE
# ---------------------------------------------------------------------------
Write-Head 'DONE'
Write-Host ("  from        : {0}   ({1})" -f $srcUsersRoot, $pcName)
Write-Host ("  copied      : {0:N0} file(s), {1}" -f $copied, (Format-Size $copiedBytes))
Write-Host ("  main copy   : {0}" -f $backupRoot)
if ($penRoot) { Write-Host ("  pen copy    : {0}  ({1:N0} file(s), {2})" -f $penRoot, $penCopied, (Format-Size $penBytes)) }
if ($dupes.Count -gt 0)      { Write-Host ("  duplicates  : {0:N0} dropped, {1} saved (all logged)" -f $dupes.Count, (Format-Size $dupBytes)) }
if ($quarantine.Count -gt 0) { Write-Host ("  quarantined : {0:N0} (in _quarantine\, nothing deleted)" -f $quarantine.Count) }
if ($failed -gt 0)           { Write-Host ("  unreadable  : {0:N0}  - see unreadable.csv" -f $failed) -ForegroundColor Red }
if ($placeholders.Count -gt 0) { Write-Host ("  cloud-only  : {0:N0}  - still in OneDrive only" -f $placeholders.Count) -ForegroundColor Yellow }

Write-Sub 'BEFORE YOU FORMAT'
if (-not $penRoot) {
    Write-Bad 'There is only ONE copy of this data.'
    if ($destRoot -match '^[A-Za-z]:\\$' -and $destRoot -notmatch '^[Cc]') {
        Write-Warn 'If it is a partition of the same physical disk as C:, a full-disk'
        Write-Warn 'format destroys it too. Copy it somewhere else first.'
    }
} else {
    Write-Ok 'Two copies exist. The pen copy survives a full-disk format.'
}
if ($placeholders.Count -gt 0) {
    Write-Warn 'OneDrive cloud-only files were NOT copied - make sure someone still'
    Write-Warn 'has that account, or hydrate them before wiping the disk.'
}
if (-not $defenderAlive -and -not $dryRun) {
    Write-Warn 'This backup has not been virus-scanned. Run backup-restore on a'
    Write-Warn 'healthy PC and pick "check a backup" before restoring any of it.'
}
Write-Host ''
Write-Dim 'Open the backup folder and read README-RESTORE.txt - it explains every'
Write-Dim 'list in there and how to put the data back by hand if you have to.'
Write-Host ''
