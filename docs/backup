# ---------------------------------------------------------------------------
#  PREDICATES
# ---------------------------------------------------------------------------
#  Attributes are tested as NUMBERS, not [IO.FileAttributes] members:
#  RecallOnDataAccess (0x400000) does not exist as an enum member on the .NET
#  Framework build that PowerShell 5.1 runs on, and naming it would throw.
#    0x2 Hidden   0x4 System   0x400 ReparsePoint   0x1000 Offline
#    0x400000 RecallOnDataAccess
function Test-CloudPlaceholder([int]$attr) {
    return (($attr -band 0x400) -or ($attr -band 0x1000) -or ($attr -band 0x400000))
}

function Test-JunkDir([string]$rel, [string]$name) {
    if ($JunkDirNames -contains $name) { return $true }
    $segs = $rel -split '\\'
    if ($segs.Count -eq 1 -and ($JunkTopLevel -contains $name)) { return $true }
    # AppData: allow-list. Keep the branch alive only while it is still a
    # prefix of, or sits under, something we want.
    if ($segs[0] -ieq 'AppData') {
        if ($segs.Count -lt 2) { return $false }
        $sub = ($segs[1..($segs.Count - 1)] -join '\')
        foreach ($keep in $AppDataKeep) {
            if ($sub -ieq $keep) { return $false }
            if ($keep.StartsWith($sub + '\', 'OrdinalIgnoreCase')) { return $false }
            if ($sub.StartsWith($keep + '\', 'OrdinalIgnoreCase')) { return $false }
        }
        return $true
    }
    return $false
}

function Test-JunkFile([string]$rel, [string]$name) {
    foreach ($p in $JunkFilePatterns) { if ($name -like $p) { return $true } }
    # A file sitting loose in AppData\Roaming or AppData\Local is not on the
    # allow-list (which only names folders and specific files).
    $segs = $rel -split '\\'
    if ($segs.Count -ge 2 -and $segs[0] -ieq 'AppData') {
        $sub = ($segs[1..($segs.Count - 1)] -join '\')
        foreach ($keep in $AppDataKeep) {
            if ($sub -ieq $keep) { return $false }
            if ($sub.StartsWith($keep + '\', 'OrdinalIgnoreCase')) { return $false }
        }
        return $true
    }
    return $false
}

function Get-Tier([string]$ext, [long]$bytes) {
    # One 30 GB .ost would otherwise swallow the whole pen ahead of 8,000
    # documents, so the big mail stores drop below pictures.
    if (($ext -eq '.pst' -or $ext -eq '.ost') -and $bytes -gt 2GB) { return 3 }
    if ($Tier1 -contains $ext) { return 1 }
    if ($Tier2 -contains $ext) { return 2 }
    if ($Tier3 -contains $ext) { return 3 }
    return 4
}

# Returns COPY / QUARANTINE / LOG plus the reason.
function Get-SanitizeVerdict($file) {
    $name = Split-Path $file.Rel -Leaf
    $ext  = [IO.Path]::GetExtension($name).ToLower()

    # autorun.inf - never, anywhere, under any circumstances.
    if ($name -ieq 'autorun.inf') { return @('LOG', 'AUTORUN-INF') }

    # Right-to-left override in the name: 'photo_gnp.exe' displays as
    # 'photo_exe.png'. Nothing legitimate ever does this.
    if ($name.IndexOf([char]0x202E) -ge 0 -or $name.IndexOf([char]0x202B) -ge 0) {
        return @('QUARANTINE', 'RLO-NAME')
    }

    # Double extension: something that looks like a document, that is not one.
    if ($name -imatch '\.(pdf|docx?|xlsx?|pptx?|jpe?g|png|gif|txt|mp4|mp3|zip|rar)\s*\.(exe|scr|com|pif|bat|cmd|vbs|js|jar|lnk|hta)$') {
        return @('QUARANTINE', 'DOUBLE-EXTENSION')
    }

    # Shortcuts are never copied into the tree - their targets die with C:.
    # They are recorded in shortcuts.csv with target and arguments so they can
    # be recreated, and that list doubles as worm evidence.
    if ($ext -eq '.lnk') { return @('LOG', 'SHORTCUT') }

    # Hidden + System on a FILE outside AppData: the classic dropper.
    if ((($file.Attr -band 0x2) -and ($file.Attr -band 0x4)) -and ($file.Rel -notmatch '^AppData\\')) {
        return @('QUARANTINE', 'HIDDEN-SYSTEM')
    }

    if ($ExeHard -contains $ext) { return @('QUARANTINE', 'EXECUTABLE') }
    if (($ExeSoft -contains $ext) -and ($file.Rel -imatch $SoftRisk)) {
        return @('QUARANTINE', 'SCRIPT-IN-RISKY-FOLDER')
    }
    return @('COPY', '')
}


# ---------------------------------------------------------------------------
#  ENUMERATION
# ---------------------------------------------------------------------------
function Get-ProfileDirs([string]$UsersRoot) {
    # Same candidate filter as Get-PrimaryUser in config\functions.ps1, but
    # taking a ROOT - that function hardcodes C:\Users, which is exactly wrong
    # when the disk is slaved on another PC as F:.
    $sys = @('Default','Default User','All Users','defaultuser0','WDAGUtilityAccount')
    Get-ChildItem -LiteralPath $UsersRoot -Directory -Force -ErrorAction SilentlyContinue |
        Where-Object {
            ($sys -notcontains $_.Name) -and ($_.Name -notmatch '^\.|\$$')
        }
}

function New-Skip($profile, $rel, $reason, $bytes) {
    return [pscustomobject]@{ Profile = $profile; Rel = $rel; Reason = $reason; Bytes = $bytes }
}

# The walker. Deliberately NOT Get-ChildItem -Recurse: that follows the legacy
# profile junctions and loops, dies at MAX_PATH with no per-subtree isolation,
# gives no incremental feedback on a 200k-file profile, and lets one denied
# folder poison the whole pipeline.
function Get-BackupCandidates {
    param([string]$ProfileRoot, [string]$ProfileName, $Files, $Skipped, [bool]$WithDownloads)

    $stack   = New-Object System.Collections.Generic.Stack[string]
    $stack.Push($ProfileRoot)
    $rootLen = $ProfileRoot.Length
    $seen    = 0
    $sw      = [Diagnostics.Stopwatch]::StartNew()
    $tick    = 0.0

    while ($stack.Count -gt 0) {
        $dir = $stack.Pop()
        $rel = ''
        if ($dir.Length -gt $rootLen) { $rel = $dir.Substring($rootLen + 1) }

        # Too deep for the .NET APIs PowerShell 5.1 uses. Do not walk it - hand
        # the whole subtree to robocopy at copy time instead.
        if ($dir.Length -gt 240) {
            $Skipped.Add((New-Skip $ProfileName $rel 'PATH-TOO-LONG' 0))
            continue
        }

        $kids = $null
        try   { $kids = Get-ChildItem -LiteralPath $dir -Force -ErrorAction Stop }
        catch { $Skipped.Add((New-Skip $ProfileName $rel 'DENIED' 0)); continue }

        foreach ($k in $kids) {
            $krel = $k.Name
            if ($rel) { $krel = Join-Path $rel $k.Name }
            $a = [int]$k.Attributes

            # A reparse point is a junction, a symlink, or a cloud placeholder.
            # NEVER descend one, and never read one.
            if ($a -band 0x400) {
                $reason = 'REPARSE-FILE'
                if ($k.PSIsContainer) { $reason = 'REPARSE-DIR' }
                $bytes = 0
                if (-not $k.PSIsContainer) { $bytes = $k.Length }
                $Skipped.Add((New-Skip $ProfileName $krel $reason $bytes))
                continue
            }

            if ($k.PSIsContainer) {
                if (-not $WithDownloads -and $krel -ieq 'Downloads') {
                    $Skipped.Add((New-Skip $ProfileName $krel 'DOWNLOADS-EXCLUDED' 0)); continue
                }
                if (Test-JunkDir $krel $k.Name) {
                    $Skipped.Add((New-Skip $ProfileName $krel 'JUNK-DIR' 0)); continue
                }
                $stack.Push($k.FullName)
                continue
            }

            # OneDrive Files On-Demand. Touching a dehydrated file triggers a
            # download: hours with a slow link, an outright failure with none.
            if (Test-CloudPlaceholder $a) {
                $Skipped.Add((New-Skip $ProfileName $krel 'CLOUD-PLACEHOLDER' $k.Length)); continue
            }
            if (Test-JunkFile $krel $k.Name) {
                $Skipped.Add((New-Skip $ProfileName $krel 'JUNK-FILE' $k.Length)); continue
            }

            # List.Add, never $arr += - at 200k files the += is O(n squared)
            # and simply never finishes.
            $Files.Add([pscustomobject]@{
                Profile = $ProfileName
                Rel     = $krel
                Full    = $k.FullName
                Bytes   = [long]$k.Length
                MTime   = $k.LastWriteTime
                Attr    = $a
                Tier    = 0
                Hash    = $null
                Verdict = 'COPY'
                Reason  = ''
                OnPen   = $false
            })
            $seen++
        }

        if ($sw.Elapsed.TotalSeconds - $tick -ge 3) {
            $tick = $sw.Elapsed.TotalSeconds
            Write-Step ("{0}: {1:N0} files so far ..." -f $ProfileName, $seen)
        }
    }
    return $seen
}


# ---------------------------------------------------------------------------
#  DEDUPE
# ---------------------------------------------------------------------------
#  Staging, cheapest test first:
#    group by size    -> a size group of one is unique, and is never hashed.
#                        That alone settles 60-80% of a real profile.
#    0 bytes          -> keep them all, never hash. Dropping empty files would
#                        break the folder structure for no gain at all.
#    over 4 MB        -> hash the first 64 KB, regroup, and only then go on.
#    still grouped    -> full SHA-256.
$Sha = [System.Security.Cryptography.SHA256]::Create()

function Get-Sha256Fast([string]$Path, [int]$MaxBytes) {
    $fs = $null
    try {
        # ReadWrite share so a file another process is writing can still be read.
        $fs = [System.IO.File]::Open($Path, 'Open', 'Read', 'ReadWrite')
        if ($MaxBytes -gt 0) {
            $buf = New-Object byte[] $MaxBytes
            $n   = $fs.Read($buf, 0, $MaxBytes)
            $h   = $Sha.ComputeHash($buf, 0, $n)
        } else {
            $h = $Sha.ComputeHash($fs)
        }
        return [BitConverter]::ToString($h).Replace('-', '')
    }
    catch   { return $null }   # unreadable: treat as UNIQUE, never as a duplicate
    finally { if ($fs) { $fs.Dispose() } }
}

# Which of an identical set is the original, and so the one to keep?
#
# WHERE it lives beats WHEN it was written, because three copies made by the
# same drag-and-drop share a timestamp to the second and the date then decides
# nothing. Documents and OneDrive are where people file work; Desktop is where
# it gets parked; Downloads is where it arrives, and "- Copy" and "(2)" are
# Windows telling you outright which one is the copy.
# A clean copy always outranks a quarantined twin. Two files with identical
# content can get different verdicts - report.txt and report.txt.exe are the
# same bytes to the hasher - and keeping the quarantined one would bury the
# user's file in _quarantine\ for no reason.
function Get-DupeRank($f) {
    $risk = 0
    if ($f.Verdict -eq 'QUARANTINE') { $risk = 1 }
    $place = 1                                                  # anywhere else
    if ($f.Rel -imatch '^(Documents|OneDrive)\\')   { $place = 0 }
    if ($f.Rel -imatch '^Downloads\\')              { $place = 2 }
    if ($f.Rel -imatch '- Copy|\(\d+\)\.|\bCopy of ') { $place = 3 }
    return ('{0}|{1}|{2:yyyyMMddHHmmss}|{3:D5}|{4}' -f $risk, $place, $f.MTime, $f.Rel.Length, $f.Rel)
}

function Invoke-Dedupe($Files, $Dupes) {
    $bySize = New-Object 'System.Collections.Generic.Dictionary[long, System.Collections.Generic.List[object]]'
    foreach ($f in $Files) {
        if (-not $bySize.ContainsKey($f.Bytes)) {
            $bySize[$f.Bytes] = New-Object System.Collections.Generic.List[object]
        }
        $bySize[$f.Bytes].Add($f)
    }

    # Only same-size groups of 2+ with a non-zero size can hold a duplicate.
    $toHash = New-Object System.Collections.Generic.List[object]
    foreach ($k in $bySize.Keys) {
        if ($k -le 0) { continue }
        if ($bySize[$k].Count -lt 2) { continue }
        foreach ($f in $bySize[$k]) { $toHash.Add($f) }
    }

    $hashBytes = ($toHash | Measure-Object Bytes -Sum).Sum
    if (-not $hashBytes) { $hashBytes = 0 }
    if ($toHash.Count -eq 0) {
        Write-Ok 'no two files even share a size - nothing to dedupe.'
        return $Files
    }

    Write-Host ("      {0:N0} file(s), {1}, share a size with another file." -f $toHash.Count, (Format-Size $hashBytes)) -ForegroundColor DarkGray
    Write-Dim  'Those have to be read and hashed to tell copies from coincidences.'
    Write-Dim  'On a healthy disk that runs at 100-300 MB/s; on a failing one, 40.'
    if (-not (Confirm-Default 'Check them for duplicates?' $true)) {
        Write-Warn 'Dedupe skipped - the backup will be as big as the source.'
        return $Files
    }

    # Quick pass: 64 KB prefix on anything big, to break the size groups apart
    # before paying for a full read.
    $sw = [Diagnostics.Stopwatch]::StartNew()
    $tick = 0.0
    $done = 0
    $doneBytes = 0
    foreach ($f in $toHash) {
        $quick = $null
        if ($f.Bytes -gt 4MB) { $quick = Get-Sha256Fast $f.Full 65536 }
        $f | Add-Member -NotePropertyName QuickHash -NotePropertyValue $quick -Force
        $done++
        if ($sw.Elapsed.TotalSeconds - $tick -ge 3) {
            $tick = $sw.Elapsed.TotalSeconds
            Write-Step ("quick pass {0:N0}/{1:N0}" -f $done, $toHash.Count)
        }
    }

    # Regroup on size + quick hash. A group of one here is unique.
    $byQuick = New-Object 'System.Collections.Generic.Dictionary[string, System.Collections.Generic.List[object]]'
    foreach ($f in $toHash) {
        $key = '{0}:{1}' -f $f.Bytes, $f.QuickHash
        if (-not $byQuick.ContainsKey($key)) {
            $byQuick[$key] = New-Object System.Collections.Generic.List[object]
        }
        $byQuick[$key].Add($f)
    }

    $full = New-Object System.Collections.Generic.List[object]
    foreach ($k in $byQuick.Keys) {
        if ($byQuick[$k].Count -lt 2) { continue }
        foreach ($f in $byQuick[$k]) { $full.Add($f) }
    }
    $fullBytes = ($full | Measure-Object Bytes -Sum).Sum
    if (-not $fullBytes) { $fullBytes = 0 }
    Write-Step ("full hash needed on {0:N0} file(s), {1}" -f $full.Count, (Format-Size $fullBytes))

    $sw.Restart(); $tick = 0.0; $done = 0; $doneBytes = 0
    foreach ($f in $full) {
        $f.Hash = Get-Sha256Fast $f.Full 0
        $done++
        $doneBytes += $f.Bytes
        if ($sw.Elapsed.TotalSeconds - $tick -ge 3) {
            $tick = $sw.Elapsed.TotalSeconds
            $mbs = 0
            if ($sw.Elapsed.TotalSeconds -gt 0) { $mbs = [math]::Round(($doneBytes / 1MB) / $sw.Elapsed.TotalSeconds, 1) }
            Write-Step ("hashing {0:N0}/{1:N0}  {2}  {3} MB/s" -f $done, $full.Count, (Format-Size $doneBytes), $mbs)
        }
    }

    # Same size AND same full hash = the same file. A null hash means we could
    # not read it, so it is kept - that is the difference between a bug and a
    # data-loss bug.
    $byHash = New-Object 'System.Collections.Generic.Dictionary[string, System.Collections.Generic.List[object]]'
    foreach ($f in $full) {
        if (-not $f.Hash) { continue }
        $key = '{0}:{1}' -f $f.Bytes, $f.Hash
        if (-not $byHash.ContainsKey($key)) {
            $byHash[$key] = New-Object System.Collections.Generic.List[object]
        }
        $byHash[$key].Add($f)
    }

    $drop = New-Object 'System.Collections.Generic.HashSet[string]'
    foreach ($k in $byHash.Keys) {
        $grp = $byHash[$k]
        if ($grp.Count -lt 2) { continue }
        $ordered = @($grp | Sort-Object { Get-DupeRank $_ })
        $keep = $ordered[0]
        foreach ($d in $ordered[1..($ordered.Count - 1)]) {
            $Dupes.Add([pscustomobject]@{
                Profile             = $d.Profile
                Kept                = ('{0}\{1}' -f $keep.Profile, $keep.Rel)
                Duplicate           = $d.Rel
                Bytes               = $d.Bytes
                SHA256              = $d.Hash
                KeptLastWrite       = $keep.MTime
                DuplicateLastWrite  = $d.MTime
                DuplicateSourcePath = $d.Full
            })
            [void]$drop.Add($d.Full)
        }
    }

    $kept = New-Object System.Collections.Generic.List[object]
    foreach ($f in $Files) { if (-not $drop.Contains($f.Full)) { $kept.Add($f) } }
    return $kept
}


# ---------------------------------------------------------------------------
#  DEFENDER
# ---------------------------------------------------------------------------
#  Four independent signals, because each of them fails a different way: the
#  cmdlet missing (uninstalled, tampered, or a Server SKU), the service
#  stopped (killed by malware, or by a half-removed third-party AV), the AM
#  service disabled by policy, or the engine reporting itself off.
function Test-DefenderAlive {
    if ($env:KD_BACKUP_NODEFENDER -eq '1') { return $false }
    $st = $null
    try { $st = Get-MpComputerStatus -ErrorAction Stop } catch { return $false }
    if (-not $st) { return $false }
    $svc = Get-Service -Name WinDefend -ErrorAction SilentlyContinue
    if (-not $svc -or $svc.Status -ne 'Running') { return $false }
    if (-not $st.AMServiceEnabled) { return $false }
    if (-not $st.AntivirusEnabled) { return $false }
    return $true
}

# The copy under Program Files is often stale; the live engine lives in the
# versioned Platform folder.
function Get-MpCmdRun {
    $plat = Join-Path $env:ProgramData 'Microsoft\Windows Defender\Platform'
    if (Test-Path $plat) {
        $newest = Get-ChildItem $plat -Directory -ErrorAction SilentlyContinue |
                  Sort-Object Name -Descending | Select-Object -First 1
        if ($newest) {
            $p = Join-Path $newest.FullName 'MpCmdRun.exe'
            if (Test-Path $p) { return $p }
        }
    }
    $p = Join-Path $env:ProgramFiles 'Windows Defender\MpCmdRun.exe'
    if (Test-Path $p) { return $p }
    return $null
}

# Scan a finished backup folder. -DisableRemediation is not negotiable: this
# is the user's only copy of their data, so we report and WE decide - and our
# decision is always to move, never to delete.
function Invoke-DefenderScan([string]$Path) {
    $result = [pscustomobject]@{ Ran = $false; Signatures = ''; Threats = @(); Note = '' }

    Write-Step 'updating Defender signatures ...'
    try {
        Update-MpSignature -ErrorAction Stop
        $result.Signatures = (Get-MpComputerStatus).AntivirusSignatureVersion
        Write-Ok ("signatures now {0}" -f $result.Signatures)
    } catch {
        $st  = Get-MpComputerStatus -ErrorAction SilentlyContinue
        $age = 'unknown'
        if ($st) { $age = $st.AntivirusSignatureAge; $result.Signatures = $st.AntivirusSignatureVersion }
        Write-Warn "could not update signatures: $($_.Exception.Message)"
        Write-Warn "scanning with signatures $age day(s) old. The sanitize rules stay on."
    }

    $start = Get-Date
    $mp = Get-MpCmdRun
    Write-Step 'scanning the backup (this takes a while) ...'
    try {
        if ($mp) {
            & $mp -Scan -ScanType 3 -File $Path -DisableRemediation 2>&1 | ForEach-Object {
                if ($_ -match 'found|Threat|threat') { Write-Dim $_ }
            }
        } else {
            # Fallback. Tidier cmdlet, but no progress and it cannot always be
            # told to leave things alone.
            Start-MpScan -ScanType CustomScan -ScanPath $Path -ErrorAction Stop
        }
        $result.Ran = $true
    } catch {
        $result.Note = "scan failed: $($_.Exception.Message)"
        Write-Bad $result.Note
        return $result
    }

    # Exit codes are unreliable across builds, so the outcome comes from the
    # detection list, whose Resources carry the actual file paths.
    $hits = @(Get-MpThreatDetection -ErrorAction SilentlyContinue |
              Where-Object { $_.InitialDetectionTime -ge $start })
    $result.Threats = $hits
    return $result
}


# ---------------------------------------------------------------------------
#  SHORTCUT-WORM CHECK
# ---------------------------------------------------------------------------
#  The classic USB worm: your folders are made Hidden+System and replaced with
#  same-named .lnk files that run the payload and then open the real folder.
#  Both the source (if it is removable) and the destination pen get checked.
function Test-ShortcutWorm([string]$Root) {
    $hits = @()
    $kids = @(Get-ChildItem -LiteralPath $Root -Force -ErrorAction SilentlyContinue)
    $hiddenDirs = @($kids | Where-Object {
        $_.PSIsContainer -and ([int]$_.Attributes -band 0x2) -and ([int]$_.Attributes -band 0x4)
    })
    $lnks = @($kids | Where-Object { $_.Extension -ieq '.lnk' })
    if (-not $lnks) { return $hits }
    $wsh = $null
    try { $wsh = New-Object -ComObject WScript.Shell } catch { return $hits }
    foreach ($l in $lnks) {
        $sc = $null
        try { $sc = $wsh.CreateShortcut($l.FullName) } catch { continue }
        $blob = "$($sc.TargetPath) $($sc.Arguments)"
        $twin = @($hiddenDirs | Where-Object { $_.Name -eq [IO.Path]::GetFileNameWithoutExtension($l.Name) })
        if ($twin.Count -gt 0 -or $blob -imatch 'cmd\.exe|wscript|cscript|rundll32|mshta|powershell|\.vbs|\.js\b') {
            $hits += [pscustomobject]@{ Lnk = $l.Name; Target = $sc.TargetPath; Args = $sc.Arguments }
        }
    }
    return $hits
}


# ---------------------------------------------------------------------------
#  VOLUMES AND DESTINATION
# ---------------------------------------------------------------------------
#  DriveType 2 = removable, 3 = fixed. Some USB3 sticks report as fixed, which
#  is why every tool in this kit walks both - see Find-PenFolder in sysinfo.
function Get-WritableVolumes {
    $out = @()
    foreach ($dt in 2, 3) {
        $disks = @(Get-CimInstance Win32_LogicalDisk -Filter "DriveType=$dt" -ErrorAction SilentlyContinue)
        foreach ($d in $disks) {
            if (-not $d.Size) { continue }
            $kind = 'fixed'
            if ($dt -eq 2) { $kind = 'removable' }
            $out += [pscustomobject]@{
                Letter     = $d.DeviceID
                Label      = $d.VolumeName
                FileSystem = $d.FileSystem
                Size       = [long]$d.Size
                Free       = [long]$d.FreeSpace
                Kind       = $kind
            }
        }
    }
    return $out | Sort-Object Letter -Unique
}

function Test-Writable([string]$Root) {
    $probe = Join-Path $Root 'kd-write-test.tmp'
    try {
        Set-Content -LiteralPath $probe -Value 'ok' -ErrorAction Stop
        Remove-Item -LiteralPath $probe -Force -ErrorAction SilentlyContinue
        return $true
    } catch { return $false }
}

function Show-Volumes($vols, [long]$Need) {
    Write-Host ''
    Write-Host ('   #  Drive  Label                 FS       Size      Free    Verdict') -ForegroundColor DarkGray
    for ($i = 0; $i -lt $vols.Count; $i++) {
        $v = $vols[$i]
        $verdict = 'fits'
        $col = 'Green'
        if ($v.Free -lt $Need) { $verdict = 'too small'; $col = 'Yellow' }
        if ($v.FileSystem -eq 'FAT32') { $verdict = "$verdict, FAT32 (no file over 4 GB)" }
        $label = $v.Label
        if (-not $label) { $label = '(no label)' }
        Write-Host ("  {0,2}  {1,-5}  {2,-20}  {3,-6} {4,8} {5,8}   {6}" -f `
            ($i + 1), $v.Letter, $label, $v.FileSystem, (Format-Size $v.Size), (Format-Size $v.Free), $verdict) -ForegroundColor $col
    }
}


# ---------------------------------------------------------------------------
#  SHRINK C:  -  the last resort, and the weakest thing in this tool
# ---------------------------------------------------------------------------
#  A rescue partition lives on the SAME PHYSICAL DISK as C:. It survives a
#  "format C: only" reinstall and nothing else. Every other destination is
#  better, and the tool says so before it offers this.
function Invoke-ShrinkForRescue {
    param([long]$NeedBytes, [bool]$HavePenCopy, [string]$SourceRoot)

    Write-Sub 'SHRINK C: TO MAKE A RESCUE PARTITION  (last resort)'

    # G1  live C: only. Shrinking a slaved foreign disk, from a machine that
    #     will not boot it, achieves nothing.
    if ($SourceRoot -notmatch '^[Cc]:\\') {
        Write-Bad 'Shrink is only offered when the data is on THIS PC''s own C:.'
        return $null
    }

    $part = $null
    try { $part = Get-Partition -DriveLetter C -ErrorAction Stop }
    catch { Write-Bad "Cannot read the C: partition: $($_.Exception.Message)"; return $null }

    $disk = Get-Disk -Number $part.DiskNumber -ErrorAction SilentlyContinue

    # G2  physical disk health
    $pd = Get-PhysicalDisk -ErrorAction SilentlyContinue | Where-Object { $_.DeviceId -eq [string]$part.DiskNumber }
    if ($pd -and ($pd.HealthStatus -ne 'Healthy' -or $pd.OperationalStatus -ne 'OK')) {
        Write-Bad ("This disk reports HealthStatus={0}, OperationalStatus={1}." -f $pd.HealthStatus, $pd.OperationalStatus)
        Write-Bad 'Repartitioning a failing disk is the fastest way to lose everything.'
        Write-Warn 'Borrow an external drive or a bigger pen instead.'
        return $null
    }

    # G3  SMART failure prediction
    $smart = @(Get-CimInstance -Namespace root\wmi -ClassName MSStorageDriver_FailurePredictStatus -ErrorAction SilentlyContinue |
               Where-Object { $_.PredictFailure })
    if ($smart.Count -gt 0) {
        Write-Bad 'SMART predicts imminent failure on a disk in this PC. Refusing to repartition.'
        return $null
    }

    # G4  BitLocker
    $bl = Get-BitLockerVolume -MountPoint 'C:' -ErrorAction SilentlyContinue
    if ($bl -and $bl.ProtectionStatus -eq 'On') {
        Write-Bad 'C: is BitLocker-protected.'
        Write-Warn 'Suspend it first (manage-bde -protectors -disable C:) and make sure you'
        Write-Warn 'have the recovery key. Refusing to shrink an encrypted volume.'
        return $null
    }

    # G5  MBR four-primary-partition limit
    if ($disk -and $disk.PartitionStyle -eq 'MBR') {
        $count = @(Get-Partition -DiskNumber $disk.Number -ErrorAction SilentlyContinue).Count
        if ($count -ge 4) {
            Write-Bad 'This is an MBR disk with 4 primary partitions - there is no room for another.'
            return $null
        }
    }

    # G6  is there anything to shrink?
    $sup = $null
    try { $sup = Get-PartitionSupportedSize -DriveLetter C -ErrorAction Stop }
    catch { Write-Bad "Windows would not report the shrink limit: $($_.Exception.Message)"; return $null }

    $shrinkBy = [long]($NeedBytes * 1.10)
    if ($shrinkBy -lt 10GB) { $shrinkBy = 10GB }
    $movable = $part.Size - $sup.SizeMin
    if ($movable -lt $shrinkBy) {
        Write-Bad ("C: can only give up {0} - the backup needs {1}." -f (Format-Size $movable), (Format-Size $shrinkBy))
        Write-Warn 'Unmovable files are pinning it: the page file, hibernation, restore'
        Write-Warn 'points, the MFT. To free them up, in an admin window:'
        Write-Warn '    powercfg /h off'
        Write-Warn '    vssadmin delete shadows /all /quiet'
        Write-Warn '    (then run the cleanup tool, and try this again)'
        return $null
    }

    # G7  leave C: usable
    $newSize    = $part.Size - $shrinkBy
    $cFreeAfter = (Get-Volume -DriveLetter C).SizeRemaining - $shrinkBy
    $minKeep    = [Math]::Max(20GB, [long]($part.Size * 0.15))
    if ($cFreeAfter -lt $minKeep) {
        Write-Bad ("That would leave C: with only {0} free; Windows needs at least {1}." -f (Format-Size $cFreeAfter), (Format-Size $minKeep))
        return $null
    }

    # G8  the honest warning, then a typed YES
    Write-Host ''
    Write-Warn 'READ THIS BEFORE YOU TYPE ANYTHING:'
    Write-Warn '  - A rescue partition sits on the SAME PHYSICAL DISK as C:.'
    Write-Warn '  - If the rebuild does a FULL-DISK format, which is the usual case,'
    Write-Warn '    this partition is DESTROYED along with C:. Only the USB pen copy'
    Write-Warn '    survives that.'
    Write-Warn '  - If the disk itself is dying, this saves nothing at all.'
    Write-Warn '  - Shrinking is normally safe, but it moves live data. There is no'
    Write-Warn '    undo, and a power cut during it can cost the whole volume.'
    Write-Host ''
    Write-Host ("  Plan:  C:  {0}  ->  {1}" -f (Format-Size $part.Size), (Format-Size $newSize))
    Write-Host ("         new rescue partition: {0}, label KD-RESCUE" -f (Format-Size $shrinkBy))
    Write-Host ''
    Write-Warn 'The USB pen for the second copy is chosen straight after this. If you'
    Write-Warn 'skip it, this partition will be the only copy of the data - and it'
    Write-Warn 'dies with C: on a full-disk format.'
    Write-Host ''
    if ((Read-Host '  Type YES to shrink C: now') -ne 'YES') { Write-Warn 'Cancelled.'; return $null }

    $beforeCount = @(Get-Partition -DiskNumber $part.DiskNumber -ErrorAction SilentlyContinue).Count

    try {
        Write-Step 'resizing C: - do not interrupt this ...'
        Resize-Partition -DriveLetter C -Size $newSize -ErrorAction Stop
        Write-Ok 'C: resized.'
    } catch {
        Write-Bad "Resize failed: $($_.Exception.Message)"
        Write-Warn 'Nothing was changed. Free up the unmovable files listed above and'
        Write-Warn 'retry, or pick a different destination.'
        return $null
    }

    $np = $null
    try {
        Write-Step 'creating the rescue partition ...'
        $np = New-Partition -DiskNumber $part.DiskNumber -UseMaximumSize -AssignDriveLetter -ErrorAction Stop
    } catch {
        Write-Bad "Could not create the partition: $($_.Exception.Message)"
        Write-Warn 'C: is smaller now and the freed space is unallocated. That is harmless.'
        Write-Warn 'Create and format it by hand in Disk Management, or pick another target.'
        return $null
    }

    try {
        Write-Step 'formatting NTFS ...'
        Format-Volume -Partition $np -FileSystem NTFS -NewFileSystemLabel 'KD-RESCUE' -Confirm:$false -Force -ErrorAction Stop | Out-Null
    } catch {
        Write-Bad "Format failed: $($_.Exception.Message)"
        Write-Warn "Partition $($np.DriveLetter): exists but is raw. Format it in Disk Management."
        return $null
    }

    # On an OEM layout (EFI | MSR | C: | WinRE) the freed extent lands BETWEEN
    # C: and the recovery partition. -UseMaximumSize picks the largest free
    # extent, which is that gap - correct. This assertion is what catches the
    # case where it was not.
    $afterCount = @(Get-Partition -DiskNumber $part.DiskNumber -ErrorAction SilentlyContinue).Count
    if ($afterCount -ne ($beforeCount + 1)) {
        Write-Warn 'The partition count is not what was expected. Check Disk Management'
        Write-Warn 'before you trust this partition.'
    }

    $letter = "$($np.DriveLetter):"
    if (-not (Test-Writable "$letter\")) { Write-Bad "Cannot write to $letter - not usable."; return $null }
    Set-Content -LiteralPath (Join-Path "$letter\" 'DO-NOT-FORMAT-THIS-PARTITION.txt') `
        -Value 'This partition holds the rescued user data for this PC. Do not format it.' -Encoding ASCII
    Write-Ok ("Rescue partition ready at {0} ({1})." -f $letter, (Format-Size $np.Size))
    return "$letter\"
}


# ---------------------------------------------------------------------------
#  COPY ENGINE
# ---------------------------------------------------------------------------
#  [IO.File]::Copy per file, with robocopy as a targeted escape hatch.
#
#  Not Copy-Item: it dies on paths over 260 characters under PowerShell 5.1
#  and carries the provider overhead 100,000 times over. Not robocopy for the
#  whole job either: the file list here is COMPUTED (dedupe plus sanitize),
#  robocopy takes no arbitrary include list, and one process per file at ~40 ms
#  is over an hour of pure spawn cost on a big profile.
#
#  ACLs are deliberately NOT copied. New PC, new SIDs - copied ACLs guarantee
#  "access denied" on restore. Data and timestamps only.
function Copy-OneFile([string]$Src, [string]$Dst, $MTime) {
    $dir = Split-Path $Dst -Parent
    if (-not [System.IO.Directory]::Exists($dir)) {
        # moveFiles.ps1 never did this, which is why it cannot copy a tree.
        [System.IO.Directory]::CreateDirectory($dir) | Out-Null
    }
    $err = ''
    try { [System.IO.File]::Copy($Src, $Dst, $true) }
    catch {
        $err = $_.Exception.Message
        Start-Sleep -Milliseconds 800
        try { [System.IO.File]::Copy($Src, $Dst, $true); $err = '' }
        catch {
            $err = $_.Exception.Message
            # Last resort: robocopy backup mode reads through a deny-ACL. It
            # will not break an exclusive lock, but denial is the commoner cause.
            $null = & robocopy.exe (Split-Path $Src -Parent) $dir (Split-Path $Src -Leaf) /B /R:1 /W:1 /NJH /NJS /NP /NFL /NDL 2>&1
            if (Test-Path -LiteralPath $Dst) { $err = '' }
        }
    }
    if ($err) { return "FAIL: $err" }
    try {
        # Clear Hidden/System/ReadOnly on the copy. On a worm-infected profile
        # this is the step that makes the user's folders visible again.
        [System.IO.File]::SetAttributes($Dst, [System.IO.FileAttributes]::Normal)
        if ($MTime) { [System.IO.File]::SetLastWriteTime($Dst, $MTime) }
    } catch { }
    return 'OK'
}

# Progress: throttled Write-Host, not Write-Progress. Write-Progress writes
# nothing to a transcript, repaints over the [FAIL] lines the tech needs to
# see, and would be the only tool in this kit that scrolls a status bar.
function New-Ticker { return [pscustomobject]@{ Sw = [Diagnostics.Stopwatch]::StartNew(); Last = 0.0 } }
function Test-Tick($t) {
    if ($t.Sw.Elapsed.TotalSeconds - $t.Last -ge 3) { $t.Last = $t.Sw.Elapsed.TotalSeconds; return $true }
    return $false
}


# ---------------------------------------------------------------------------
#  REBUILD EXTRAS
# ---------------------------------------------------------------------------
#  Everything you wish you had written down before you formatted. All of it is
#  best-effort: a missing piece must never stop the data copy.
function Save-Extras([string]$Dir, [bool]$Live) {
    New-Item -ItemType Directory -Force -Path $Dir | Out-Null

    if (-not $Live) {
        Set-Content -LiteralPath (Join-Path $Dir 'NOT-COLLECTED.txt') -Encoding UTF8 -Value @(
            'The disk was read from another PC (slaved mode), so the live settings',
            'of the original machine - printers, Wi-Fi keys, mapped drives, network',
            'configuration - could not be read. Only the file data was rescued.'
        )
        return
    }

    try {
        $keys = @(
            'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\*',
            'HKLM:\SOFTWARE\WOW6432Node\Microsoft\Windows\CurrentVersion\Uninstall\*'
        )
        Get-ItemProperty $keys -ErrorAction SilentlyContinue |
            Where-Object { $_.DisplayName } |
            Select-Object DisplayName, DisplayVersion, Publisher, InstallDate |
            Sort-Object DisplayName |
            Export-Csv (Join-Path $Dir 'installed-programs.csv') -NoTypeInformation -Encoding UTF8
        Write-Ok 'installed programs'
    } catch { Write-Warn "installed programs: $($_.Exception.Message)" }

    try {
        $lines = @()
        foreach ($p in (Get-Printer -ErrorAction SilentlyContinue)) {
            $lines += ('{0}  |  {1}  |  port {2}  |  shared={3}' -f $p.Name, $p.DriverName, $p.PortName, $p.Shared)
        }
        foreach ($p in (Get-PrinterPort -ErrorAction SilentlyContinue)) {
            if ($p.PrinterHostAddress) { $lines += ('PORT {0} -> {1}' -f $p.Name, $p.PrinterHostAddress) }
        }
        Set-Content -LiteralPath (Join-Path $Dir 'printers.txt') -Value $lines -Encoding UTF8
        Write-Ok 'printers'
    } catch { Write-Warn "printers: $($_.Exception.Message)" }

    try {
        $lines = @(& net.exe use 2>&1)
        Set-Content -LiteralPath (Join-Path $Dir 'mapped-drives.txt') -Value $lines -Encoding UTF8
        Write-Ok 'mapped drives'
    } catch { Write-Warn "mapped drives: $($_.Exception.Message)" }

    try {
        $lines = @()
        foreach ($n in (Get-NetIPConfiguration -ErrorAction SilentlyContinue)) {
            $lines += ('-- {0}' -f $n.InterfaceAlias)
            $lines += ('   IPv4    : {0}' -f ($n.IPv4Address.IPAddress -join ', '))
            $lines += ('   Gateway : {0}' -f ($n.IPv4DefaultGateway.NextHop -join ', '))
            $lines += ('   DNS     : {0}' -f ($n.DNSServer.ServerAddresses -join ', '))
            $lines += ''
        }
        Set-Content -LiteralPath (Join-Path $Dir 'network-config.txt') -Value $lines -Encoding UTF8
        Write-Ok 'network settings'
    } catch { Write-Warn "network settings: $($_.Exception.Message)" }

    try {
        $bios = Get-CimInstance Win32_BIOS -ErrorAction SilentlyContinue
        $cs   = Get-CimInstance Win32_ComputerSystem -ErrorAction SilentlyContinue
        $os   = Get-CimInstance Win32_OperatingSystem -ErrorAction SilentlyContinue
        $lines = @(
            ('PC name     : {0}' -f $env:COMPUTERNAME),
            ('Model       : {0} {1}' -f $cs.Manufacturer, $cs.Model),
            ('BIOS serial : {0}' -f $bios.SerialNumber),
            ('Domain      : {0}' -f $cs.Domain),
            ('OS          : {0} ({1})' -f $os.Caption, $os.Version),
            ('Backed up   : {0}' -f (Get-Date -Format 'yyyy-MM-dd HH:mm'))
        )
        # The asset number the org keeps in the registry. The asset tool can
        # put it back after the format, keyed on the same BIOS serial.
        foreach ($hive in (Get-ChildItem 'HKLM:\SOFTWARE' -ErrorAction SilentlyContinue)) {
            $ap = Get-ItemProperty (Join-Path $hive.PSPath 'Assets') -ErrorAction SilentlyContinue
            if ($ap) {
                foreach ($n in ($ap.PSObject.Properties.Name | Where-Object { $_ -notmatch '^PS' })) {
                    $lines += ('Asset {0,-6}: {1}' -f $n, $ap.$n)
                }
            }
        }
        Set-Content -LiteralPath (Join-Path $Dir 'pc-identity.txt') -Value $lines -Encoding UTF8
        Write-Ok 'PC identity and asset numbers'
    } catch { Write-Warn "PC identity: $($_.Exception.Message)" }

    if (Confirm-Default 'Export saved Wi-Fi profiles, INCLUDING the keys?' $true) {
        try {
            $wifi = Join-Path $Dir 'wifi'
            New-Item -ItemType Directory -Force -Path $wifi | Out-Null
            $null = & netsh.exe wlan export profile key=clear folder="$wifi" 2>&1
            $n = @(Get-ChildItem $wifi -Filter '*.xml' -ErrorAction SilentlyContinue).Count
            Write-Ok "$n Wi-Fi profile(s) - these files contain the passwords in clear text"
        } catch { Write-Warn "Wi-Fi export: $($_.Exception.Message)" }
    }
}


